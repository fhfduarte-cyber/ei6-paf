# Vercel > Project > Settings > Environment Variables (Production + Preview). Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public "anon" (publishable) key. Safe by design: every table is protected by Row Level Security.
SUPABASE_ANON_KEY=
# OPTIONAL. Legacy HS256 JWT secret (Supabase > Project Settings > API > JWT Secret). When set, access tokens are verified
# locally (faster). When empty, the app asks Supabase Auth to validate each token. Leave empty if your project uses the new asymmetric signing keys.
SUPABASE_JWT_SECRET=
# Local development only (disables Secure/__Host- cookies and allows http to the mock). NEVER set in Vercel.
# APP_ENV=local
