  put(y,5,X1,'PIECE ARRANGEMENT IN THE FEEDSTOCK',{color:XC.brand,b:true,sz:9,wrap:false});y++;
  const iw=452, ih=Math.round(iw*imgs.FH/imgs.FW), id1=wb.addImage({base64:imgs.fCut.split(',')[1],extension:'png'}), id2=wb.addImage({base64:imgs.fArr.split(',')[1],extension:'png'});
