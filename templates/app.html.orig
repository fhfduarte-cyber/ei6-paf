<title>PAF tool</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style nonce="{{NONCE}}">
/* Layout: barra lateral de entradas fixa à esquerda; à direita só resultados (3D, sequência de corte, Offall, Devaluation).
   Paleta Ei6: tokens abaixo são provisórios. Substituir pelos valores do guia Ei6 em um único lugar. */
:root{
  --font-ui:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --font-num:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --bg:#eef1f5; --surface:#ffffff; --surface-2:#f6f8fb; --line:#d9e0ea; --line-strong:#b9c4d4;
  --fg:#16212f; --fg-muted:#5b6b80;
  --brand:#16407a; --brand-ink:#ffffff; --brand-soft:#e3ecf8;
  --nominal:#1f6fd1; --nominal-fill:rgba(31,111,209,.10);
  --demand:#d6342f; --demand-fill:rgba(214,52,47,.16);
  --off1:#e0a21b; --off2:#1d9e8f; --off3:#7a6fd0;
  --demand2:#b4530a; --demand2-fill:rgba(180,83,10,.16); --off4:#c2478c; --off5:#6b7a8c;
  --good:#18794e; --good-bg:#dff3e8; --warn:#9a5b00; --warn-bg:#fdeccd; --bad:#b3261e; --bad-bg:#fbe1de;
  --radius:6px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0f1621; --surface:#172131; --surface-2:#1c2840; --line:#2a3850; --line-strong:#3c4d69;
  --fg:#e6ecf4; --fg-muted:#94a3b8;
  --brand:#5b9bf0; --brand-ink:#08162b; --brand-soft:#1e3354;
  --nominal:#5ea4ff; --nominal-fill:rgba(94,164,255,.12);
  --demand:#ff6b64; --demand-fill:rgba(255,107,100,.20);
  --off1:#f0b73a; --off2:#35c2b1; --off3:#a69cf2;
  --demand2:#ff9a4d; --demand2-fill:rgba(255,154,77,.20); --off4:#f08bc0; --off5:#a0abb8;
  --good:#5fd39a; --good-bg:#12382a; --warn:#f0b73a; --warn-bg:#3a2d0f; --bad:#ff8a82; --bad-bg:#3d1b19;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0f1621; --surface:#172131; --surface-2:#1c2840; --line:#2a3850; --line-strong:#3c4d69;
  --fg:#e6ecf4; --fg-muted:#94a3b8;
  --brand:#5b9bf0; --brand-ink:#08162b; --brand-soft:#1e3354;
  --nominal:#5ea4ff; --nominal-fill:rgba(94,164,255,.12);
  --demand:#ff6b64; --demand-fill:rgba(255,107,100,.20);
  --off1:#f0b73a; --off2:#35c2b1; --off3:#a69cf2;
  --demand2:#ff9a4d; --demand2-fill:rgba(255,154,77,.20); --off4:#f08bc0; --off5:#a0abb8;
  --good:#5fd39a; --good-bg:#12382a; --warn:#f0b73a; --warn-bg:#3a2d0f; --bad:#ff8a82; --bad-bg:#3d1b19;
  color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--font-ui);font-size:14px;line-height:1.45}
.num{font-family:var(--font-num);font-variant-numeric:tabular-nums}
.app{max-width:1500px;margin:0 auto;padding-inline:16px;padding-block:16px 32px;display:flex;flex-direction:column;gap:16px}
.top{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.mark{background:var(--brand);color:var(--brand-ink);font-weight:600;border-radius:var(--radius);padding:4px 10px;letter-spacing:.04em}
.top h1{font-size:18px;font-weight:600;margin:0}
.units{margin-left:auto;display:flex;border:1px solid var(--line-strong);border-radius:var(--radius);overflow:hidden;background:var(--surface)}
.units button{font:inherit;font-size:12px;font-weight:500;color:var(--fg-muted);background:transparent;border:0;padding:5px 12px;cursor:pointer;white-space:nowrap}
.units button small{font-size:11px;opacity:.8;margin-left:4px;font-family:var(--font-num)}
.units button[aria-pressed=true]{background:var(--brand);color:var(--brand-ink)}
.units button:focus-visible{outline:2px solid var(--brand);outline-offset:-2px}
.top .sub{color:var(--fg-muted);font-size:13px}
.layout{display:grid;grid-template-columns:320px minmax(0,1fr);gap:16px;align-items:start}
@media(max-width:920px){.layout{grid-template-columns:minmax(0,1fr)}}
.side{display:flex;flex-direction:column;gap:12px;position:sticky;top:env(safe-area-inset-top,0px);}
@media(max-width:920px){.side{position:static}}
.main{display:flex;flex-direction:column;gap:16px;min-width:0}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius)}
.card>header{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line)}
.card>header h2{font-size:13px;margin:0;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.card .body{padding:14px}
.tag{font-size:11px;padding:2px 8px;border-radius:999px;background:var(--brand-soft);color:var(--brand);font-weight:500;white-space:nowrap}
.fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}
.field.wide{grid-column:span 3}
.field.half{grid-column:span 1}
.field label{font-size:12px;color:var(--fg-muted);font-weight:500}
.inp{display:flex;align-items:center;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface-2);overflow:hidden}
.inp:focus-within{border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft)}
.inp input{width:100%;min-width:0;border:0;background:transparent;color:var(--fg);padding:8px 8px;font:inherit;font-family:var(--font-num);outline:none}
.inp span{padding-right:8px;color:var(--fg-muted);font-size:11px}
.subhead{grid-column:span 3;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-muted);margin-top:4px}
.note{font-size:12px;color:var(--fg-muted)}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:10px 14px;display:flex;flex-direction:column;gap:2px;min-width:0}
.kpi .l{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-muted)}
.kpi .v{font-size:18px;font-weight:500;overflow-wrap:anywhere}
.kpi .s{font-size:12px;color:var(--fg-muted)}

.stage{position:relative;height:440px;background:var(--surface-2);border-radius:0 0 var(--radius) var(--radius);touch-action:none;cursor:grab}
.stage:active{cursor:grabbing}
.stage canvas{width:100%;height:100%;display:block}
.legend{display:flex;gap:6px 14px;flex-wrap:wrap;font-size:12px;color:var(--fg-muted)}
.legend i{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:6px;vertical-align:-2px;border:2px solid}
.legend i.dash{border-style:dashed}
.hint{position:absolute;right:10px;bottom:8px;font-size:11px;color:var(--fg-muted)}

.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.opt{all:unset;box-sizing:border-box;cursor:pointer;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:8px;display:flex;flex-direction:column;gap:6px;min-width:0}
.opt:hover{border-color:var(--line-strong)}
.opt:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.opt[aria-pressed="true"]{border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);background:var(--brand-soft)}
.opt canvas{width:100%;height:84px;display:block}
.opt .t{display:flex;justify-content:space-between;gap:6px;font-size:12px;font-weight:500}
.opt .m{font-size:11px;color:var(--fg-muted)}
.best{font-size:10px;background:var(--good-bg);color:var(--good);padding:1px 6px;border-radius:999px;font-weight:600}

.offs{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.off{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);padding:12px 14px;display:flex;flex-direction:column;gap:8px;min-width:0;border-top:4px solid var(--c)}
.off.hi{box-shadow:0 0 0 2px var(--brand-soft);border-color:var(--brand);border-top-color:var(--c)}
.off h3{margin:0;font-size:14px;font-weight:600;display:flex;justify-content:space-between;gap:8px}
.dl{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;margin:0;font-size:13px}
.dl dt{color:var(--fg-muted)}
.dl dd{margin:0;text-align:right}
.weight{font-size:20px;font-weight:500;border-top:1px solid var(--line);padding-top:8px;display:flex;justify-content:space-between;align-items:baseline}
.weight small{font-size:11px;color:var(--fg-muted);font-family:var(--font-ui)}

.pw{grid-column:span 3;border-top:1px solid var(--line);padding-top:8px}
.cost{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:0}
@media(max-width:760px){.cost{grid-template-columns:minmax(0,1fr)}}
.cost .in{padding:14px;display:flex;flex-direction:column;gap:12px}
.cost select{width:100%;padding:9px 8px;font-family:var(--font-num)}
.cost .final{background:var(--brand);color:var(--brand-ink);padding:18px 20px;display:flex;flex-direction:column;justify-content:center;gap:4px;border-radius:0 0 var(--radius) 0}
@media(max-width:760px){.cost .final{border-radius:0 0 var(--radius) var(--radius)}}
.cost .final .l{font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.85}
.cost .final .big{font-size:40px;font-weight:500;line-height:1.1}
.cost .final .s{font-size:12px;opacity:.85}
.sample{background:var(--warn-bg);color:var(--warn);border-radius:var(--radius);padding:8px 10px;font-size:12px;font-weight:500}
.tg{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--fg-muted);cursor:pointer}
.tg input{accent-color:var(--demand2);width:16px;height:16px}
.muted .fields{opacity:.45}
.cost .final{gap:14px}
.cost .final .fin{display:flex;flex-direction:column;gap:4px}
.rpt-btn{all:unset;box-sizing:border-box;margin-top:6px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;font:500 13px var(--font-ui);padding:9px 14px;border-radius:var(--radius);background:var(--brand-ink);color:var(--brand);border:1px solid transparent;align-self:flex-start}
.rpt-btn:hover{background:color-mix(in srgb,var(--brand-ink) 88%,var(--brand))}
.rpt-btn:focus-visible{outline:2px solid var(--brand-ink);outline-offset:2px}
body.no-dl .rpt-btn{display:none}
.rpt-ov{position:fixed;inset:0;z-index:50;background:rgba(10,18,30,.55);display:flex;align-items:center;justify-content:center;padding:16px}
.rpt-dlg{background:var(--surface);color:var(--fg);border:1px solid var(--line-strong);border-radius:var(--radius);width:min(420px,100%);box-shadow:0 12px 40px rgba(0,0,0,.35);overflow:hidden}
.rpt-dlg header{background:var(--brand);color:var(--brand-ink);padding:12px 16px}
.rpt-dlg header h2{margin:0;font-size:15px;font-weight:600}
.rpt-dlg .bd{padding:16px;display:flex;flex-direction:column;gap:8px}
.rpt-dlg label{font-size:12px;font-weight:500;color:var(--fg-muted);text-transform:uppercase;letter-spacing:.06em}
.rpt-dlg input{font:500 16px var(--font-num);padding:9px 10px;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface-2);color:var(--fg);width:100%}
.rpt-dlg input:focus-visible{outline:2px solid var(--brand);outline-offset:1px}
.rpt-dlg .hint{font-size:12px;color:var(--fg-muted);margin:0}
.rpt-dlg .msg{font-size:12px;margin:0;min-height:16px;color:var(--bad)}
.rpt-dlg .msg.ok{color:var(--good)}
.rpt-dlg footer{display:flex;justify-content:flex-end;gap:8px;padding:0 16px 16px}
.rpt-dlg footer button{font:500 13px var(--font-ui);padding:8px 14px;border-radius:var(--radius);cursor:pointer;border:1px solid var(--line-strong);background:var(--surface);color:var(--fg)}
.rpt-dlg footer button.go{background:var(--brand);color:var(--brand-ink);border-color:var(--brand)}
.rpt-dlg footer button:disabled{opacity:.6;cursor:progress}
.rpt-dlg footer button:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.cost .final .fin+.fin{border-top:1px solid color-mix(in srgb,var(--brand-ink) 35%,transparent);padding-top:14px}
.card>header:has(.tg.out){justify-content:flex-start}.card>header:has(.tg.out) .tag{margin-left:auto}
.tg.out{margin-left:6px;font-weight:400;text-transform:none;letter-spacing:0;font-size:12px}
.mch h3{display:flex;align-items:center;flex-wrap:wrap}
.xc h3{display:flex;align-items:center;flex-wrap:wrap}.xc h3 input[type=checkbox]{width:auto;padding:0;margin:0;accent-color:var(--brand)}.xc .xct{font-size:11px;color:var(--fg-muted);text-transform:none;letter-spacing:0;font-weight:400;margin-left:10px}
.outf{display:flex;flex-direction:column;gap:8px}
.outf h4{margin:4px 0 0;font-size:12px;color:var(--fg-muted);text-transform:uppercase;letter-spacing:.06em}
.cost .in .memo{margin:-6px 0 0;font-size:11px;color:var(--fg-muted);font-family:var(--font-ui)}
.cost .final .mfin{gap:8px}
.cost .final.split{background:transparent;padding:0;gap:8px;justify-content:stretch;border-radius:0}
.cost .final.split .pan{flex:1;background:var(--brand);color:var(--brand-ink);padding:18px 20px;display:flex;flex-direction:column;justify-content:center;gap:10px}
.cost .final.split .pan:nth-last-child(1 of .pan){border-radius:0 0 var(--radius) 0}
@media(max-width:760px){.cost .final.split{padding-top:8px}.cost .final.split .pan:nth-last-child(1 of .pan){border-radius:0 0 var(--radius) var(--radius)}}
.mfin .mg{display:flex;align-items:center;gap:8px}
.mfin .mg label{font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.9}
.mfin .mg input{width:56px;font:500 13px var(--font-num);padding:4px 6px;text-align:right;border-radius:var(--radius);border:1px solid transparent;background:var(--brand-ink);color:var(--brand)}
.mfin .mg span{font-size:13px}
.mfin table{width:100%;border-collapse:collapse;font-size:12px}
.mfin th,.mfin td{padding:4px 5px;text-align:right;white-space:nowrap}
.mfin thead th{font-weight:500;opacity:.85;border-bottom:1px solid color-mix(in srgb,var(--brand-ink) 35%,transparent)}
.mfin tbody td:first-child,.mfin thead th:first-child{text-align:left}
.mfin table,.mfin thead,.mfin tbody,.mfin tr,.mfin th,.mfin td{background:transparent!important;color:inherit!important;border-color:color-mix(in srgb,var(--brand-ink) 22%,transparent)}
.mfin tbody tr:nth-child(even) td{background:transparent!important}
.mfin tr.base td{background:color-mix(in srgb,var(--brand-ink) 18%,transparent)!important;font-weight:700}
.mfin .wrapt{overflow-x:auto}
.mfin .qt{border-top:1px solid color-mix(in srgb,var(--brand-ink) 35%,transparent);padding-top:10px;display:flex;flex-direction:column;gap:6px}
.mfin .qt .r{display:flex;align-items:center;gap:8px;justify-content:flex-start;font-size:12px}
.mfin .qt .r>label{letter-spacing:.06em;text-transform:uppercase;opacity:.9;flex:0 0 138px;white-space:nowrap}
.mfin .qt input,.mfin .qt select{font:500 13px var(--font-num);padding:5px 7px;border-radius:var(--radius);border:1px solid transparent;background:var(--brand-ink);color:var(--brand);width:128px;text-align:right;box-sizing:border-box}
.mfin .qt select{width:128px;text-align:left;box-sizing:border-box}
.mfin .qt .pkr{flex-wrap:wrap}.mfin .qt .pkr .pd{flex-basis:100%;padding-left:146px;margin-top:-2px}.mfin .qt .d:empty{display:none}
.mfin .qt input.pn{width:56px}
.mfin .qt .d{font-size:11px;opacity:.8;text-align:left;white-space:nowrap}
.mfin .qt .tot{border-top:1px solid color-mix(in srgb,var(--brand-ink) 35%,transparent);padding-top:8px;display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.mfin .qt .tot .t{font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.mfin .qt .fmr{justify-content:space-between}.mfin .qt .fmr label{flex:1}.mfin .qt .fmr b{font:500 15px var(--font-num)}
.mfin .qt .tot b{font:500 24px var(--font-num)}
.mfin .sub{font-size:11px;opacity:.85;margin:0}
.pctnote{font-size:11px;color:var(--fg-muted);font-family:var(--font-ui)}
[hidden]{display:none!important}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);overflow-x:auto}
.tabs button{all:unset;box-sizing:border-box;cursor:pointer;padding:10px 18px;font-weight:500;color:var(--fg-muted);border-bottom:3px solid transparent;margin-bottom:-1px;white-space:nowrap}
.tabs button:hover{color:var(--fg)}
.tabs button[aria-selected="true"]{color:var(--brand);border-bottom-color:var(--brand)}
.tabs button:focus-visible{outline:2px solid var(--brand);outline-offset:-2px}
.fields.two{grid-template-columns:repeat(2,minmax(0,1fr))}
.fields.two .field.wide,.fields.two .subhead,.fields.two .pw{grid-column:1/-1}
.dc{display:contents}
.card>header:has(.seg){flex-wrap:wrap}
.card>header .seg{flex:1 1 100%}
.seg label{flex:1;text-align:center;white-space:nowrap}
.seg{display:flex;border:1px solid var(--line-strong);border-radius:var(--radius);overflow:hidden}
.seg label{cursor:pointer;font-size:12px;font-weight:500;color:var(--fg-muted);padding:4px 12px;display:block}
.seg label:has(input:checked){background:var(--brand);color:var(--brand-ink)}
.seg label:has(input:focus-visible){outline:2px solid var(--brand);outline-offset:-2px}
.seg input{position:absolute;opacity:0;width:0;height:0}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-muted);font-weight:500;background:var(--surface-2)}
td.r,th.r{text-align:right}
.pill{display:inline-block;padding:2px 10px;border-radius:999px;font-weight:600;font-family:var(--font-num);font-size:12px}
.p-good{background:var(--good-bg);color:var(--good)}
.p-warn{background:var(--warn-bg);color:var(--warn)}
.p-bad{background:var(--bad-bg);color:var(--bad)}
.bar{height:6px;border-radius:3px;background:var(--line);min-width:80px;overflow:hidden}
.bar b{display:block;height:100%;background:var(--demand)}
tfoot td{font-weight:600;background:var(--surface-2)}
.err{background:var(--bad-bg);color:var(--bad);border:1px solid var(--bad);border-radius:var(--radius);padding:14px;font-weight:500}
details{padding:10px 14px;border-top:1px solid var(--line)}
summary{cursor:pointer;font-weight:500;font-size:13px}
.refgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:10px}
.refgrid h4{margin:0 0 4px;font-size:12px}
.refgrid table{font-size:12px}
.refgrid th,.refgrid td{padding:4px 8px}
select{background:var(--surface-2);color:var(--fg);border:1px solid var(--line-strong);border-radius:var(--radius);padding:4px 8px;font:inherit}
@media (prefers-reduced-motion:no-preference){.opt,.off{transition:box-shadow .15s,border-color .15s}}

.dg .body{display:block}
.dg .dgrow{display:flex;gap:8px;align-items:center;margin-bottom:8px}
.dg .dgrow label{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-muted);flex:0 0 auto}
.dg .dgrow select{flex:1;min-width:0;font-family:var(--font-num);font-size:12px}
.dg .dgv{font-size:12px;margin:0 0 6px;color:var(--fg-muted)}
.dg .dgvl{list-style:none;margin:4px 0 0;padding:0;display:grid;gap:2px}.dg .dgvl li{border:0;background:none;padding:0;border-radius:0;font-size:12px;color:var(--fg-muted)}
.dg .dgv b{color:var(--demand);font-family:var(--font-num);font-weight:500}
.dg .subhead{margin:10px 0 4px}
.dg ol{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.dg li{border:1px solid var(--line);border-left:3px solid var(--c,var(--line-strong));border-radius:var(--radius);padding:6px 8px;background:var(--surface-2)}
.dg li .lot{font-family:var(--font-num);font-size:12px;font-weight:500;word-break:break-word;display:block}
.dg li .meta{font-size:11px;color:var(--fg-muted);display:block;margin-top:2px}
.dg li .fill{float:right;font-family:var(--font-num);font-size:11px;color:var(--good);margin-left:6px}
.dg .none{font-size:12px;color:var(--fg-muted);padding:4px 0}

.dg>header{cursor:pointer;user-select:none}
.dg>header h2{display:flex;align-items:center;gap:8px}
.dg .chev{display:inline-block;width:8px;height:8px;border-right:2px solid var(--fg-muted);border-bottom:2px solid var(--fg-muted);transform:rotate(45deg);transition:transform .15s;margin-top:-3px}
.dg.collapsed .chev{transform:rotate(-45deg);margin-top:0}
.dg.collapsed>.body{display:none}
.dg>header:focus-visible{outline:2px solid var(--brand);outline-offset:-2px}

.orhead{cursor:pointer;user-select:none}
.ori .chev{display:inline-block;width:8px;height:8px;border-right:2px solid var(--fg-muted);border-bottom:2px solid var(--fg-muted);transform:rotate(45deg);transition:transform .15s;margin-top:-3px}
.ori.collapsed .chev{transform:rotate(-45deg);margin-top:0}
.ori.collapsed #orbody,.ori.collapsed .csbody{display:none}
.ori.collapsed>.orhead{border-bottom:0}
.ori.collapsed .stage,.ori.collapsed .legend{display:none}
.plhead .legend{margin-left:auto}
.orhead:focus-visible{outline:2px solid var(--brand);outline-offset:-2px}
.cs>.cshead{cursor:pointer;user-select:none}
.cs>.cshead h2{display:flex;align-items:center;gap:8px}
.cs .chev{display:inline-block;width:8px;height:8px;border-right:2px solid var(--fg-muted);border-bottom:2px solid var(--fg-muted);transform:rotate(45deg);transition:transform .15s;margin-top:-3px}
.cs.collapsed .chev{transform:rotate(-45deg);margin-top:0}
.cs.collapsed>.opts,.cs.collapsed .cshead .note{display:none}
.cs.collapsed>.cshead{margin-bottom:0!important}
.cs>.cshead:focus-visible{outline:2px solid var(--brand);outline-offset:2px}

.dg li .row{display:flex;justify-content:space-between;align-items:flex-end;gap:8px;margin-top:2px}
.dg li .row .meta{margin-top:0}
.dg li .uc{font-family:var(--font-num);font-size:12px;font-weight:500;color:var(--fg);white-space:nowrap;text-align:right}
.dg li .uc small{font-size:10px;color:var(--fg-muted);font-weight:400}

.dg li[draggable=true]{cursor:grab}
.dg li[draggable=true]:active{cursor:grabbing}
.dg li.dragging{opacity:.45}
.card>header .devseg{display:inline-flex!important;flex:0 0 auto!important;width:auto!important;margin:0}.devseg label{padding:2px 10px!important;font-size:11px!important;line-height:1.5;flex:0 0 auto!important}
.mch,.xc{border-top:1px solid var(--line);padding-top:12px;display:flex;flex-direction:column;gap:10px}
.mch h3,.xc h3{margin:0;font-size:12px;letter-spacing:.06em;text-transform:uppercase;font-weight:600}
.mch .rate{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--fg-muted)}
.mch .rate .inp{width:130px}
.mch table,.xc table{width:100%;border-collapse:collapse;font-size:12px}
.mch th,.xc th{font-size:11px;font-weight:500;color:var(--fg-muted);text-align:left;padding:3px 4px;vertical-align:bottom}
.mch th.r,.mch td.r,.xc th.r,.xc td.r{text-align:right}
.mch td,.xc td{padding:3px 4px;border-top:1px solid var(--line);vertical-align:middle}
.mch select,.mch input,.xc select,.xc input{width:100%;padding:5px 6px;font-size:12px;font-family:var(--font-num);min-width:0}
.mch table.res input{text-align:right;font-weight:600}
.mch .num{font-family:var(--font-num)}
.mch tfoot td{font-weight:600;border-top:2px solid var(--line-strong);background:var(--surface-2)}
.mch .act{white-space:nowrap;width:1%;text-align:right}
.mch .act button{border:1px solid var(--line-strong);background:var(--surface);color:var(--fg);border-radius:var(--radius);width:24px;height:24px;line-height:1;font-size:14px;cursor:pointer;padding:0}
.mch .act button.add{border-color:var(--brand);color:var(--brand);font-weight:700}
.mch .act button:hover{background:var(--brand-soft)}
.mch .sub{font-size:11px;color:var(--fg-muted);margin:0}
.matcard{display:block;margin:8px 0 2px;border:1px solid var(--line);border-left:3px solid var(--nominal,var(--brand));border-radius:var(--radius);padding:8px 10px;background:var(--surface-2);cursor:grab}
.matcard:active{cursor:grabbing}.matcard.dragging{opacity:.45}
.matcard .lot{font-family:var(--font-num);font-size:12px;font-weight:500;word-break:break-word;display:block}
.matcard .row{display:flex;justify-content:space-between;align-items:flex-end;gap:8px;margin-top:2px}
.matcard .meta{font-size:11px;color:var(--fg-muted)}
.matcard .uc{font-family:var(--font-num);font-size:12px;font-weight:500;white-space:nowrap}
.matcard .uc small{font-size:10px;color:var(--fg-muted);font-weight:400}
.matcard+.note{margin:4px 0 8px!important;font-size:11px}
.fs-drop.dg-over{outline:2px dashed var(--brand);outline-offset:-4px;background:var(--brand-soft)}
.fs-drop.dg-done{animation:dgflash 1.2s ease-out}
@keyframes dgflash{0%{box-shadow:0 0 0 3px var(--good)}100%{box-shadow:0 0 0 0 transparent}}
@media (prefers-reduced-motion:reduce){.fs-drop.dg-done{animation:none;outline:2px solid var(--good)}}
.qtab{width:100%;border-collapse:separate;border-spacing:0 4px}
.qtab th{text-align:left;font-size:11px;color:var(--fg-muted);font-weight:500;padding:0 4px}.qtab th.r,.qtab input.r{text-align:right}
.qtab td{padding:0 3px}.qtab td.pick{width:26px;text-align:center}.qtab td.act{width:68px;white-space:nowrap}
.qtab input[type=text],.qtab input[type=number],.qtab input[type=date]{width:100%;min-width:0;box-sizing:border-box;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface-2);color:var(--fg);padding:6px 7px;font:inherit}
.qtab input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft)}
.qtab tr.sel input:not([type=radio]){border-color:var(--brand);background:var(--brand-soft)}
.qtab input[type=radio]{accent-color:var(--brand);width:16px;height:16px;cursor:pointer}
.qtab button{all:unset;box-sizing:border-box;cursor:pointer;width:26px;height:26px;text-align:center;line-height:24px;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface-2);color:var(--fg)}
.qtab button:hover{border-color:var(--brand);color:var(--brand)}.qtab button[hidden]{display:none}
.qtab input.obs{text-overflow:ellipsis}
.qtab td.pick+td{min-width:90px}
.qtab{table-layout:fixed}.qtab th:nth-child(1){width:24px}.qtab th:nth-child(2){width:19%}.qtab th:nth-child(3){width:15%}.qtab th:nth-child(4){width:15%}.qtab th:nth-child(5){width:12%}.qtab th:nth-child(7){width:62px}.qtab th{vertical-align:bottom;line-height:1.2;white-space:normal;overflow-wrap:anywhere}.qtab th:nth-child(5){width:14%}
.qtab input{padding:6px 5px!important}
.qtab th,.qtab th.r{text-align:center}.qtab input[type=text],.qtab input[type=number],.qtab input.r{text-align:center}
.who{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--fg-muted)}
.who button{all:unset;cursor:pointer;padding:5px 10px;border:1px solid var(--line-strong);border-radius:var(--radius);color:var(--fg)}
.who button:hover{border-color:var(--brand);color:var(--brand)}.who button:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.paflist{width:100%;border-collapse:collapse;font-size:12px;margin-top:10px}.paflist th{text-align:left;color:var(--fg-muted);font-weight:500;padding:4px 6px}
.paflist td{padding:5px 6px;border-top:1px solid var(--line)}.paflist td.r,.paflist th.r{text-align:right}
.pbtn.sm{padding:4px 10px;font-size:12px}
/* PAF tool */
#calc[hidden],#pafcover[hidden],.parttitle[hidden]{display:none!important}
#pafcover{display:flex;flex-direction:column;gap:14px}
.pafnav{margin:0 0 12px}
.parttitle{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;padding:12px 14px;margin:0 0 12px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--brand);border-radius:var(--radius)}
.parttitle .pt-l{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;min-width:0}
.parttitle .pt-k{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-muted)}
.parttitle b{font-size:20px;font-family:var(--font-num)}
.parttitle .pt-d{font-size:15px;color:var(--fg)}
.parttitle .pt-r{font-size:12px;color:var(--fg-muted)}
.pafgrid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:12px}
@media (max-width:640px){.pafgrid{grid-template-columns:1fr}}
.pafgrid input,.paftab input{width:100%;min-width:0;box-sizing:border-box;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface-2);color:var(--fg);padding:8px;font:inherit}
.pafgrid input:focus,.paftab input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft)}
.paftab{width:100%;border-collapse:separate;border-spacing:0 6px}
.paftab th{text-align:left;font-size:12px;color:var(--fg-muted);font-weight:500;padding:0 4px}
.paftab td{padding:0 4px}.paftab td:first-child{width:55%}
.paftab td.act{width:90px;white-space:nowrap}
.paftab button{all:unset;box-sizing:border-box;cursor:pointer;width:30px;height:30px;text-align:center;line-height:28px;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface-2);color:var(--fg);font-size:16px}
.paftab button:hover{border-color:var(--brand);color:var(--brand)}
.paftab button:focus-visible,.pbtn:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.paftab button[hidden]{display:none}
.pafact{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pbtn{all:unset;box-sizing:border-box;cursor:pointer;padding:9px 16px;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface-2);color:var(--fg);font-weight:500}
.pbtn.go{background:var(--brand);color:var(--brand-ink);border-color:var(--brand)}
.pbtn:disabled{opacity:.5;cursor:default}
.pafact .msg{font-size:12px;color:var(--fg-muted)}.pafact .msg.ok{color:var(--brand)}
</style>

<script type="application/json" id="ei6-data">{{DATA_JSON}}</script>
<script type="application/json" id="ei6-user">{{USER_JSON}}</script>
<div class="app">
  <div class="top">
    <span class="mark">Ei6</span>
    <h1>PAF tool</h1>
    <span class="sub">Final price of one or more parts. Each Part # has its own raw material calculator.</span>
    <div class="units" role="group" aria-label="Unit system">
      <button type="button" id="u-metric" aria-pressed="true">Metric <small>mm · kg</small></button>
      <button type="button" id="u-us" aria-pressed="false">US Units <small>in · lb</small></button>
    </div>
    <div class="who"><span id="who"></span><button type="button" id="signout">Sign out</button></div>
  </div>

  <nav class="tabs" id="tabs" role="tablist" aria-label="Material category">
    <button role="tab" id="tabbtn-blocks" aria-selected="true" aria-controls="tab-blocks" type="button">Blocks</button>
    <button role="tab" id="tabbtn-rods" aria-selected="false" aria-controls="tab-rods" tabindex="-1" type="button">Rods</button>
    <button role="tab" id="tabbtn-rounds" aria-selected="false" aria-controls="tab-rounds" tabindex="-1" type="button">Rounds</button>
  </nav>

  <div class="layout" id="tab-blocks" role="tabpanel" aria-labelledby="tabbtn-blocks">
    <aside class="side">
      <section class="card">
        <header><h2>Demanded Part(s) I</h2><label class="tg" for="d2on"><input type="checkbox" id="d2on">Combined order</label></header>
        <div class="body"><div class="fields">
          <div class="field"><label for="dW">W'</label><div class="inp"><input id="dW" type="number" min="1" step="any" value="250"><span>mm</span></div></div>
          <div class="field"><label for="dH">H'</label><div class="inp"><input id="dH" type="number" min="1" step="any" value="200"><span>mm</span></div></div>
          <div class="field"><label for="dL">L'</label><div class="inp"><input id="dL" type="number" min="1" step="any" value="600"><span>mm</span></div></div>
          <div class="subhead">Material allowance</div>
          <div class="field"><label for="aW">W'</label><div class="inp"><input id="aW" type="number" min="0" step="any" value="5"><span>mm</span></div></div>
          <div class="field"><label for="aH">H'</label><div class="inp"><input id="aH" type="number" min="0" step="any" value="5"><span>mm</span></div></div>
          <div class="field"><label for="aL">L'</label><div class="inp"><input id="aL" type="number" min="0" step="any" value="10"><span>mm</span></div></div>
          <div class="field wide"><label for="qty">Qty · quantity</label><div class="inp"><input id="qty" type="number" min="1" step="1" value="4"><span>pcs</span></div></div>
          <div class="subhead">Weight with allowance</div>
          <dl class="dl num pw" id="pcw"></dl>
        </div></div>
      </section>
      <section class="card">
        <header><h2>Demanded Part(s) II</h2><span class="tag">Second ordered part</span></header>
        <div class="body muted" id="d2body"><div class="fields">
          <div class="field"><label for="d2W">W'</label><div class="inp"><input id="d2W" type="number" min="1" step="any" value="150"><span>mm</span></div></div>
          <div class="field"><label for="d2H">H'</label><div class="inp"><input id="d2H" type="number" min="1" step="any" value="150"><span>mm</span></div></div>
          <div class="field"><label for="d2L">L'</label><div class="inp"><input id="d2L" type="number" min="1" step="any" value="400"><span>mm</span></div></div>
          <div class="subhead">Material allowance</div>
          <div class="field"><label for="a2W">W'</label><div class="inp"><input id="a2W" type="number" min="0" step="any" value="5"><span>mm</span></div></div>
          <div class="field"><label for="a2H">H'</label><div class="inp"><input id="a2H" type="number" min="0" step="any" value="5"><span>mm</span></div></div>
          <div class="field"><label for="a2L">L'</label><div class="inp"><input id="a2L" type="number" min="0" step="any" value="10"><span>mm</span></div></div>
          <div class="field wide"><label for="qty2">Qty · quantity</label><div class="inp"><input id="qty2" type="number" min="1" step="1" value="2"><span>pcs</span></div></div>
          <div class="subhead">Weight with allowance</div>
          <dl class="dl num pw" id="pcw2"></dl>
        </div></div>
      </section>
      <section class="card">
        <header><h2>Feedstock</h2><span class="tag">Stock block</span></header>
        <div class="body"><div class="fields">
          <div class="field"><label for="nW">W · width</label><div class="inp"><input id="nW" type="number" min="1" step="any" value="635"><span>mm</span></div></div>
          <div class="field"><label for="nH">H · height</label><div class="inp"><input id="nH" type="number" min="1" step="any" value="508"><span>mm</span></div></div>
          <div class="field"><label for="nL">L · length</label><div class="inp"><input id="nL" type="number" min="1" step="any" value="1829"><span>mm</span></div></div>
          <div class="field wide"><label for="dens">D · density</label><div class="inp"><input id="dens" type="number" min="1" step="any" value="1720"><span>kg/m³</span></div></div>
          <div class="subhead">Block weight</div>
          <dl class="dl num pw" id="nomw"></dl>
        </div></div>
      </section>
      <section class="card dg" id="dg-BL">
        <header role="button" tabindex="0" aria-expanded="true" aria-controls="dg-BL-body"><h2><i class="chev" aria-hidden="true"></i>Material Digger</h2><span class="tag" id="dg-BL-tag"></span></header>
        <div class="body" id="dg-BL-body"></div>
      </section>
      <p class="note">The calculation updates as you type. Drag the 3D drawing to rotate.</p>
    </aside>

    <main class="main" id="main"></main>
  </div>

  <div class="layout" id="tab-rods" role="tabpanel" aria-labelledby="tabbtn-rods" hidden>
    <aside class="side">
      <section class="card">
        <header><h2>Demanded Part(s)</h2>
          <div class="seg" role="radiogroup" aria-label="Demand type"><label><input type="radio" name="rmode" value="rod" checked>Rods</label><label><input type="radio" name="rmode" value="tube">Tubes</label></div></header>
        <div class="body"><div class="fields two">
          <div class="field"><label for="rdOD">OD</label><div class="inp"><input id="rdOD" type="number" min="1" step="any" value="254"><span>mm</span></div></div>
          <div class="field" id="rdIDf" hidden><label for="rdID">ID</label><div class="inp"><input id="rdID" type="number" min="1" step="any" value="152.4"><span>mm</span></div></div>
          <div class="field"><label for="rdL">L · length</label><div class="inp"><input id="rdL" type="number" min="1" step="any" value="400"><span>mm</span></div></div>
          <div class="field"><label for="rQty">Qty · quantity</label><div class="inp"><input id="rQty" type="number" min="1" step="1" value="3"><span>pcs</span></div></div>
          <div class="subhead">Material allowance</div>
          <div class="field" id="raIDf" hidden><label for="raID">ID</label><div class="inp"><input id="raID" type="number" min="0" step="any" value="3"><span>mm</span></div></div>
          <div class="field"><label for="raL">L</label><div class="inp"><input id="raL" type="number" min="0" step="any" value="10"><span>mm</span></div></div>
          <div class="subhead">Weight with allowance</div>
          <dl class="dl num pw" id="rpcw"></dl>
        </div></div>
      </section>
      <section class="card">
        <header><h2>Feedstock</h2><label class="tg" for="rCollar"><input type="checkbox" id="rCollar">Collar</label></header>
        <div class="body"><div class="fields two">
          <div class="dc" id="rPlain">
            <div class="field"><label for="rD">OD</label><div class="inp"><input id="rD" type="number" min="1" step="any" value="254"><span>mm</span></div></div>
            <div class="field"><label for="rL">L · length</label><div class="inp"><input id="rL" type="number" min="1" step="any" value="1829"><span>mm</span></div></div>
          </div>
          <div class="dc" id="rCollarF" hidden>
            <div class="field"><label for="rD1">Small OD</label><div class="inp"><input id="rD1" type="number" min="1" step="any" value="152.4"><span>mm</span></div></div>
            <div class="field"><label for="rL1">L small OD</label><div class="inp"><input id="rL1" type="number" min="1" step="any" value="600"><span>mm</span></div></div>
            <div class="field"><label for="rD2">Large OD</label><div class="inp"><input id="rD2" type="number" min="1" step="any" value="254"><span>mm</span></div></div>
            <div class="field"><label for="rL2">L large OD</label><div class="inp"><input id="rL2" type="number" min="1" step="any" value="1229"><span>mm</span></div></div>
          </div>
          <div class="field wide"><label for="rDens">D · density</label><div class="inp"><input id="rDens" type="number" min="1" step="any" value="1720"><span>kg/m³</span></div></div>
          <div class="subhead">Rod weight</div>
          <dl class="dl num pw" id="rnomw"></dl>
        </div></div>
      </section>
      <section class="card dg" id="dg-RD">
        <header role="button" tabindex="0" aria-expanded="true" aria-controls="dg-RD-body"><h2><i class="chev" aria-hidden="true"></i>Material Digger</h2><span class="tag" id="dg-RD-tag"></span></header>
        <div class="body" id="dg-RD-body"></div>
      </section>
      <p class="note">The calculation updates as you type. Drag the 3D drawing to rotate.</p>
    </aside>
    <main class="main" id="rmain"></main>
  </div>

  <div class="layout" id="tab-rounds" role="tabpanel" aria-labelledby="tabbtn-rounds" hidden>
    <aside class="side">
      <section class="card">
        <header><h2>Demanded Part(s)</h2>
          <div style="display:flex;align-items:center;gap:14px"><label class="tg" id="qCoreL" for="qCore" hidden title="Treat the bore (ID × piece length) as a separate Offall, valued with its own diameter and length"><input type="checkbox" id="qCore">Core</label><div class="seg" role="radiogroup" aria-label="Demand type"><label><input type="radio" name="qmode" value="round" checked>Rounds</label><label><input type="radio" name="qmode" value="tube">Tubes</label></div></div></header>
        <div class="body"><div class="fields two">
          <div class="field"><label for="qdOD">OD</label><div class="inp"><input id="qdOD" type="number" min="1" step="any" value="400"><span>mm</span></div></div>
          <div class="field" id="qdIDf" hidden><label for="qdID">ID</label><div class="inp"><input id="qdID" type="number" min="1" step="any" value="200"><span>mm</span></div></div>
          <div class="field"><label for="qdL">L · length</label><div class="inp"><input id="qdL" type="number" min="1" step="any" value="40"><span>mm</span></div></div>
          <div class="field"><label for="qQty">Qty · quantity</label><div class="inp"><input id="qQty" type="number" min="1" step="1" value="3"><span>pcs</span></div></div>
          <div class="subhead">Material allowance</div>
          <div class="field" id="qaIDf" hidden><label for="qaID">ID</label><div class="inp"><input id="qaID" type="number" min="0" step="any" value="3"><span>mm</span></div></div>
          <div class="field"><label for="qaL">L</label><div class="inp"><input id="qaL" type="number" min="0" step="any" value="5"><span>mm</span></div></div>
          <div class="subhead">Weight with allowance</div>
          <dl class="dl num pw" id="qpcw"></dl>
        </div></div>
      </section>
      <section class="card">
        <header><h2>Feedstock</h2><label class="tg" for="qCollar"><input type="checkbox" id="qCollar">Collar</label></header>
        <div class="body"><div class="fields two">
          <div class="dc" id="qPlain">
            <div class="field"><label for="qD">OD</label><div class="inp"><input id="qD" type="number" min="1" step="any" value="600"><span>mm</span></div></div>
            <div class="field"><label for="qL">L · length</label><div class="inp"><input id="qL" type="number" min="1" step="any" value="200"><span>mm</span></div></div>
          </div>
          <div class="dc" id="qCollarF" hidden>
            <div class="field"><label for="qD1">Small OD</label><div class="inp"><input id="qD1" type="number" min="1" step="any" value="400"><span>mm</span></div></div>
            <div class="field"><label for="qL1">L small OD</label><div class="inp"><input id="qL1" type="number" min="1" step="any" value="60"><span>mm</span></div></div>
            <div class="field"><label for="qD2">Large OD</label><div class="inp"><input id="qD2" type="number" min="1" step="any" value="600"><span>mm</span></div></div>
            <div class="field"><label for="qL2">L large OD</label><div class="inp"><input id="qL2" type="number" min="1" step="any" value="140"><span>mm</span></div></div>
          </div>
          <div class="field wide"><label for="qDens">D · density</label><div class="inp"><input id="qDens" type="number" min="1" step="any" value="1720"><span>kg/m³</span></div></div>
          <div class="subhead">Round weight</div>
          <dl class="dl num pw" id="qnomw"></dl>
        </div></div>
      </section>
      <section class="card dg" id="dg-RN">
        <header role="button" tabindex="0" aria-expanded="true" aria-controls="dg-RN-body"><h2><i class="chev" aria-hidden="true"></i>Material Digger</h2><span class="tag" id="dg-RN-tag"></span></header>
        <div class="body" id="dg-RN-body"></div>
      </section>
      <p class="note">The calculation updates as you type. Drag the 3D drawing to rotate.</p>
    </aside>
    <main class="main" id="qmain"></main>
  </div>
</div>

<script nonce="{{NONCE}}">
/* Datasets and session come from the server (Supabase) */
const __D=JSON.parse(document.getElementById("ei6-data").textContent), __U=JSON.parse(document.getElementById("ei6-user").textContent);
/* ---------- Regras da planilha Devaluation_v7.xlsx (aba "Rules_Blocks") ---------- */
// faixa pela menor medida (pol); depois testa intermediária (mm) e maior (mm). ok/no = valor do offall em $/${MUl()}.
const IN=25.4;
const RULES=__D.devaluation.blocks;
/* Depreciação = (preço do material no Costing − valor do offall na faixa) ÷ preço do material (limitada a 0–100%). */
const depOf=(P,v)=>P>0?Math.max(0,Math.min(1,(P-v)/P)):0;
const usd=n=>'$ '+nf(PP(n),2)+'/'+MUl();
const AX=['W','H','L'];
const PERMS=[[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]];
const COLORS=['--off1','--off2','--off3','--off4','--off5'];
let MIXON=false;
const dn=id=>MIXON?(id?'Group B (other orientation)':'Group A'):(id?'Demanded Part(s) II':'Demanded Part(s) I');
const KG_LB_=0.45359237;
/* 2026 Ei6 Machining price list_detail_Oct26.xlsx, aba "2026 Master Price List": coluna "Nominal Size" e "Price Per lb" (só itens com preço). Seções "Blocks", "PF Blocks", "SEC", "PFR-N Blocks" e "ISO Blocks". kg = $/lb ÷ 0,45359237. */
const PRICE_SAMPLE=false;
const PRICES=__D.prices_blocks;

const $=id=>document.getElementById(id);
const nf=(n,d=0)=>n.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
/* ---- Sistema de unidades: o cálculo é sempre métrico (mm, kg, kg/m³); só a entrada e a exibição convertem. ---- */
const UNIT={us:false}, KG_LB=0.45359237, DENS_F=27679.9047, UK={};
const Lc=(mm,d=1)=>nf(UNIT.us?mm/25.4:mm,UNIT.us?Math.max(2,d):d);       // comprimento, só o número
const Lu=(mm,d=1)=>Lc(mm,d)+(UNIT.us?'"':' mm');
const Wc=(kg,d=1)=>nf(UNIT.us?kg/KG_LB:kg,d);
const MUl=()=>UNIT.us?'lb':'kg', LUl=()=>UNIT.us?'in':'mm';
const Wu=(kg,d=1)=>Wc(kg,d)+' '+MUl();
const Vu=(m3,d=2)=>UNIT.us?nf(m3*61023.7441,d)+' in³':nf(m3*1e3,d)+' dm³';
const PP=perKg=>UNIT.us?perKg*KG_LB:perKg;                             // $/kg → $/lb
const gv=id=>{const el=$(id);let v=parseFloat(el.value);if(UNIT.us&&UK[id]){const b=parseFloat(el.dataset.base);if(el.value===el.dataset.shown&&!isNaN(b))return b;v*=UK[id]==='len'?25.4:DENS_F}return v};

/* =================== MATERIAL DIGGER ===================
   Looks up Parma M Aged Report (tab Data): rows whose Description has "nominal" (tab Nominal) or "offall" (tab offall).
   Category and sizes are read from the Lot# text (BL = W×H×L · RD/RN = OD×L · CL = Small OD×L, Large OD×L; sizes in inches).
   The best option is the stock with the minimum volume that still holds V''. Snapshot embedded below (rows with qty > 0 whose size could be read). */
const DIGGER_DATA=__D.parma_stock.rows;
const DG={fam:{BL:'',RD:'',RN:''},env:{BL:0},last:{}};
const DG_TOL=0.005, DG_CAT={BL:'Blocks (BL)',RD:'Rods (RD)',RN:'Rounds (RN)'};
function dgFit(cat,spec,r){
  const c=r[1], d=r[2];
  if(cat==='BL'){
    if(c!=='BL')return null;
    const s=[...d].sort((a,b)=>a-b);
    return spec.ss.every(q=>s.every((x,i)=>x>=q[i]-DG_TOL))?s[0]*s[1]*s[2]:null;
  }
  if(c===cat) return (d[0]>=spec.od-DG_TOL&&d[1]>=spec.L-DG_TOL)?Math.PI/4*d[0]*d[0]*d[1]:null;
  if(c==='CL'&&r[4].toUpperCase().startsWith(cat)){
    const d1=d[0],l1=d[1],D2=d[2],l2=d[3];
    const inLarge=spec.od<=D2+DG_TOL&&spec.L<=l2+DG_TOL, fromSmall=spec.od<=d1+DG_TOL&&spec.L<=l1+l2+DG_TOL;
    return (inLarge||fromSmall)?Math.PI/4*(d1*d1*l1+D2*D2*l2):null;
  }
  return null;
}
function dgSize(r){
  const f=x=>Lc(x*25.4,1), c=r[1], d=r[2];
  if(c==='BL')return `${f(d[0])} × ${f(d[1])} × ${f(d[2])}`;
  if(c==='CL')return `ø${f(d[0])} × ${f(d[1])} + ø${f(d[2])} × ${f(d[3])}`;
  return `ø${f(d[0])} × ${f(d[1])}`;
}
/* A card is only offered when the whole calculation works with it as the Feedstock (all demands, mixed groups, collars), not just when V'' fits its volume. */
function dgOk(cat,r){
  const d=r[2], mm=x=>x*25.4, saveMix=MIXON; let res;
  try{
    if(cat==='BL'){const o=readIn; readIn=()=>Object.assign(o(),{N:d.map(mm)}); try{res=solve()}finally{readIn=o}}
    else{
      const isR=cat==='RD', o=isR?rRead:qRead;
      const ov=r[1]==='CL'?{collar:true,d1:mm(d[0]),l1:mm(d[1]),D2:mm(d[2]),l2:mm(d[3])}:{collar:false,D:mm(d[0]),L:mm(d[1])};
      const f=()=>Object.assign(o(),ov); if(isR)rRead=f; else qRead=f;
      try{res=isR?rSolve():qSolve()}finally{if(isR)rRead=o;else qRead=o}
    }
  }catch(e){return true}finally{MIXON=saveMix}
  return !res.error;
}
function dgUpdate(cat,spec){
  const box=$('dg-'+cat+'-body'); if(!box)return;
  DG.last[cat]=spec;
  const tag=$('dg-'+cat+'-tag'); if(tag)tag.textContent=DG_CAT[cat].split(' ')[1].replace(/[()]/g,'');
  if(!spec){box.innerHTML='<div class="none">Fill in the demanded part(s) to search the stock.</div>';return}
  if(cat==='BL'){
    const ss=spec.list.map(e=>[...e.mm].map(x=>x/25.4).sort((p,q)=>p-q));
    spec={ss,rows:spec.list.map(e=>({lab:spec.list.length>1?e.label.split(' · ')[0]:'',dim:Lc(e.mm[0],0)+' × '+Lc(e.mm[1],0)+' × '+Lc(e.mm[2],0)}))};
    spec.vol=ss.reduce((t,v)=>t+v[0]*v[1]*v[2],0);
  }else{
    spec={od:spec.od/25.4,L:spec.L/25.4,txt:`ø${Lc(spec.od,0)} × ${Lc(spec.L,0)} ${LUl()}`};
    spec.vol=Math.PI/4*spec.od*spec.od*spec.L;
  }
  const fams=[...new Set(DIGGER_DATA.filter(r=>r[1]===cat||(r[1]==='CL'&&r[4].toUpperCase().startsWith(cat))).map(r=>r[4]))].sort();
  if(DG.fam[cat]&&!fams.includes(DG.fam[cat]))DG.fam[cat]='';
  const best=[[],[]];
  DIGGER_DATA.forEach(r=>{
    if(DG.fam[cat]&&r[4]!==DG.fam[cat])return;
    const v=dgFit(cat,spec,r); if(v!=null)best[r[0]].push({r,v,i:DIGGER_DATA.indexOf(r)});
  });
  const prefCL=cat!=='BL'&&!!$((cat==='RD'?'r':'q')+'Collar').checked;   // Collar ticked in the Feedstock: collars come first
  const isCL=x=>x.r[1]==='CL'?0:1;
  best.forEach(a=>a.sort((x,y)=>(prefCL?isCL(x)-isCL(y):0)||x.v-y.v||y.r[5]-x.r[5]));
  { const t0=performance.now(); for(let k=0;k<2;k++){ const out=[]; for(const x of best[k]){ if(out.length>=3&&performance.now()-t0>1500)break; if(dgOk(cat,x.r))out.push(x); } best[k]=out; } }
  const ucOf=r=>{const m=r[7]; if(m==null)return '';
    if(r[0]===1) return `<span class="uc" title="Unit Cost (column M of the report), $ per lb">$ ${nf(m,2)}<small>/lb</small></span>`;
    return `<span class="uc" title="Unit Cost (col. M) per piece">$ ${nf(m,2)}<small>/pc</small></span>`};
  const qtyOf=r=>r[0]===1?Wu(r[5]*0.45359237,0):`${r[5]} pcs`;
  const list=(a,col)=>a.length?`<ol>${a.slice(0,3).map(({r,v,i})=>`<li draggable="true" data-i="${i}" title="Drag to the Feedstock box (or double-click) to use these dimensions" style="--c:var(${col})"><span class="lot"><span class="fill" title="All V'' together ÷ stock volume">${nf(Math.min(100,spec.vol/v*100),0)}%</span>${r[3]}</span><div class="row"><span class="meta">${r[1]==='CL'?'Collar · ':''}${dgSize(r)} ${LUl()} · ${qtyOf(r)}${r[6]?' · '+r[6]:''}</span></div></li>`).join('')}</ol>`
    :'<div class="none">No stock holds this V\'\'.</div>';
  box.innerHTML=`<div class="dgrow"><label for="dg-${cat}-fam">Material</label><select id="dg-${cat}-fam"><option value="">All</option>${fams.map(f=>`<option ${f===DG.fam[cat]?'selected':''}>${f}</option>`).join('')}</select></div>
    <div class="dgv">Searching ${DG_CAT[cat]} for V'' :${spec.rows?`<ul class="dgvl">${spec.rows.map((x,k)=>`<li>${x.lab?x.lab+': ':''}${x.dim}${k<spec.rows.length-1?'':' '+LUl()}</li>`).join('')}</ul>`:` <b>${spec.txt}</b>`}</div>
    ${prefCL?'<p class="note" style="margin:0 0 6px">Collar is ticked: collars are listed first, then plain stock.</p>':''}
    <div class="subhead">Nominal · ${best[0].length} fit</div>${list(best[0],'--nominal')}
    <div class="subhead">Offall · ${best[1].length} fit</div>${list(best[1],'--off1')}
    <p class="note" style="margin:8px 0 0">Drag a card onto the Feedstock box (or double-click it) to use its dimensions as the Feedstock. Source: Parma M Aged Report. Smallest stock volume that holds V'' comes first (% = all V'' together ÷ stock volume). Every V'' of the calculation is considered together, and only stock that works for the whole calculation is listed.${cat!=='BL'?' Collars qualify when V\'\' fits the large OD section, or starts at the small OD end and continues through the large OD.':' Block orientation is free.'}</p>`;
  box.querySelectorAll('li[draggable]').forEach(li=>{
    li.addEventListener('dragstart',e=>{DG.drag={cat,i:+li.dataset.i};li.classList.add('dragging');e.dataTransfer.effectAllowed='copy';try{e.dataTransfer.setData('text/plain',DIGGER_DATA[+li.dataset.i][3])}catch(_){}});
    li.addEventListener('dragend',()=>{li.classList.remove('dragging');DG.drag=null;document.querySelectorAll('.fs-drop').forEach(x=>x.classList.remove('dg-over'))});
    li.addEventListener('dblclick',()=>dgApply(cat,+li.dataset.i));
  });
  const f=$('dg-'+cat+'-fam'); if(f)f.onchange=e=>{DG.fam[cat]=e.target.value;dgUpdate(cat,DG.last[cat])};
}
let OR={c:false}; try{OR.c=localStorage.getItem('or-collapsed')==='1'}catch(e){}
let PL={c:false}; try{PL.c=localStorage.getItem('pl-collapsed')==='1'}catch(e){}
let CS={c:false}; try{CS.c=localStorage.getItem('cs-collapsed')==='1'}catch(e){}
let state={res:null,sel:0,hi:-1,mat:0,view:{yaw:-0.62,pitch:0.42}};
function pieceWeight(){
  const I=readIn();
  const nw=$('nomw');
  if([...I.N,I.D].every(x=>x>0)){const vol=I.N[0]*I.N[1]*I.N[2]/1e9;nw.innerHTML=`<dt>Volume</dt><dd>${Vu(vol,1)}</dd><dt>Total weight</dt><dd><b>${Wu(vol*I.D,1)}</b></dd>`}else nw.innerHTML='';
  const one=(P,A,Q,el)=>{
    if([...P,I.D,Q].some(x=>!(x>0))){el.innerHTML='';return null}
    const pc=P.map((p,i)=>p+A[i]);
    const kg=pc[0]*pc[1]*pc[2]/1e9*I.D;
    el.innerHTML=`<dt>W'' × H'' × L''</dt><dd>${Lc(pc[0],1)} × ${Lc(pc[1],1)} × ${Lu(pc[2],1)}</dd><dt>Weight per piece</dt><dd>${Wu(kg,2)}</dd><dt>Total (${Q} pcs)</dt><dd><b>${Wu(kg*Q,2)}</b></dd>`+(I.N.every(x=>x>0)?`<dt>Max per Feedstock block</dt><dd>${nf(maxPerBlock(I.N,pc).n)} pcs</dd>`:'');
    return kg;
  };
  return [one(I.P,I.A,I.Q,$('pcw')),one(I.P2,I.A2,I.Q2,$('pcw2'))];
}

/* ---------- Casamento com a planilha ---------- */
function matchDev(sizeMm){
  const a=[...sizeMm].sort((x,y)=>x-y);          // menor, intermediária, maior (mm)
  const small=a[0]/IN;
  let r=RULES[0];
  RULES.forEach(x=>{if(small>=x.minIn)r=x});     // equivale ao MATCH(...,1) da planilha
  const ok=a[1]>=r.mid&&a[2]>=r.big;
  const v=ok?r.ok:r.no, P=PRICES[Math.min(state.mat,PRICES.length-1)].kg;
  return {dev:depOf(P,v),v,P,band:r.n,ok,small,mid:a[1],big:a[2]};
}

/* ---------- Solução ---------- */
function readIn(){
  const g=gv;
  return {N:[g('nW'),g('nH'),g('nL')],D:g('dens'),P:[g('dW'),g('dH'),g('dL')],A:[g('aW')||0,g('aH')||0,g('aL')||0],Q:Math.round(g('qty')),
    P2:[g('d2W'),g('d2H'),g('d2L')],A2:[g('a2W')||0,g('a2H')||0,g('a2L')||0],Q2:Math.round(g('qty2')),on2:$('d2on').checked};
}
function offalls(N,v,order){
  const [a,b,c]=order, mk=()=>({size:[...N],pos:[0,0,0]});
  const o1=mk(); o1.size[a]=N[a]-v[a]; o1.pos[a]=v[a];
  const o2=mk(); o2.size[a]=v[a]; o2.size[b]=N[b]-v[b]; o2.pos[b]=v[b];
  const o3=mk(); o3.size[a]=v[a]; o3.size[b]=v[b]; o3.size[c]=N[c]-v[c]; o3.pos[c]=v[c];
  return [o1,o2,o3];
}
function maxPerBlock(N,pc){
  let best={n:0,g:[0,0,0]};
  for(const p of PERMS){
    const g=N.map((n,i)=>Math.floor((n+1e-6)/pc[p[i]]));
    const n=g[0]*g[1]*g[2];
    if(n>best.n)best={n,g};
  }
  return best;
}
/* When the grid has more slots than pieces (e.g. 13 pcs in a 7 x 2 x 1 grid), the unused slots are real leftover material inside V'': they are
   added as Offall box(es) (largest block of slots first) so their weight and depreciation are not lost from the cost. */
function slotOffalls(p,f,v,Q){
  const g=p.map(i=>f[i]), tot=g[0]*g[1]*g[2]; let e=tot-Q; if(e<=0)return [];
  const sl=v.map((x,i)=>x/g[i]), out=[];
  while(e>0){
    let bb=null;
    for(let a=1;a<=g[0];a++)for(let b=1;b<=g[1];b++)for(let d=1;d<=g[2];d++){const n=a*b*d;if(n<=e&&(!bb||n>bb.n))bb={a,b,d,n}}
    if(!bb)break;
    const size=[bb.a*sl[0],bb.b*sl[1],bb.d*sl[2]];
    out.push({size,pos:v.map((x,i)=>x-size[i]),slot:true}); e-=bb.n;
  }
  return out;
}
function solveCore(N,D,P,A,Q){
  const pc=P.map((p,i)=>p+A[i]);
  const facts=[];
  for(let x=1;x<=Q;x++) if(Q%x===0) for(let y=1;y<=Q/x;y++) if((Q/x)%y===0) facts.push([x,y,Q/x/y]);
  const all=[]; let fits=false;
  for(let pass=0;pass<2&&!fits;pass++){
    if(pass===1){ // sem fatoração exata: usa a menor grade com espaços livres
      if(Q>5000)break;
      facts.length=0;
      // every grid x*y*z >= Q that is minimal in z (y up to ceil(Q/x) also covers grids where x*y > Q, e.g. 7 x 2 x 1 for 13 pcs)
      for(let x=1;x<=Q;x++) for(let y=1;y<=Math.ceil(Q/x);y++) facts.push([x,y,Math.ceil(Q/(x*y))]);
    }
    for(const f of facts){
      const env=pc.map((p,i)=>p*f[i]);
      for(const p of PERMS){
        const v=[0,0,0]; p.forEach((src,i)=>v[i]=env[src]);
        if(v.some((x,i)=>x>N[i]+1e-6)) continue;
        fits=true;
        const slots=slotOffalls(p,f,v,Q);
        const opts=PERMS.map(order=>{
          const list=offalls(N,v,order).concat(slots.map(o=>({...o}))).map(o=>{
            const empty=o.size.some(s=>s<1);
            const vol=empty?0:o.size[0]*o.size[1]*o.size[2]/1e9;
            const m=empty?null:matchDev(o.size);
            return {...o,empty,vol,kg:vol*D,m,dev:m?m.dev:0};
          });
          const loss=list.reduce((s,o)=>s+o.dev*o.kg,0);
          const big=Math.max(...list.map(o=>o.vol));
          return {order,list,loss,big};
        });
        opts.sort((a,b)=>a.loss-b.loss||b.big-a.big);
        all.push({fact:f,env,v,perm:p,opts});
      }
    }
  }
  if(!fits) return {fail:true,mx:maxPerBlock(N,pc),pc,N,Q};
  // every piece orientation x arrangement is a candidate; the lowest weighted loss wins (ties: largest single Offall)
  all.sort((a,b)=>a.opts[0].loss-b.opts[0].loss||b.opts[0].big-a.opts[0].big);
  all.forEach(c=>{c.loss0=c.opts[0].loss;c.opts=c.opts.map(o=>({...o}))});
  const best=all[0]; best.cands=all;
  return best;
}
function failMsg(f,label){
  const nd=`${Lc(f.N[0],0)} × ${Lc(f.N[1],0)} × ${Lu(f.N[2],0)}`;
  if(!f.mx.n) return `Not even one ${label} piece fits in the Feedstock block. With allowance, the piece measures ${Lc(f.pc[0],1)} × ${Lc(f.pc[1],1)} × ${Lu(f.pc[2],1)} and the Feedstock is ${nd}. Reduce the dimensions or the allowance.`;
  return `The ${f.Q} ${label} pieces do not fit in 1 Feedstock block (${nd}). <b>Maximum per block: ${f.mx.n} pieces</b>, in a ${f.mx.g.join(' × ')} arrangement (W × H × L). ${f.Q} pieces would need ${Math.ceil(f.Q/f.mx.n)} blocks.`;
}
function solve(){
  const I=readIn();
  const bad=a=>a.some(x=>!(x>0));
  if(bad([...I.N,...I.P,I.D,I.Q])) return {error:'Fill in all dimensions, the density and the quantity with values greater than zero.'};
  const dems=[{id:0,P:I.P,A:I.A,Q:I.Q}];
  if(I.on2){
    if(bad([...I.P2,I.Q2])) return {error:'Fill in the dimensions and quantity of Demanded Part(s) II with values greater than zero.'};
    dems.push({id:1,P:I.P2,A:I.A2,Q:I.Q2});
  }
  MIXON=false;
  let base;
  if(I.on2){
    /* Combined order: both cutting orders (Part I first / Part II first) are simulated; the one with the lowest weighted loss wins (tie: larger total volume first). */
    const vol=d=>(d.P[0]+d.A[0])*(d.P[1]+d.A[1])*(d.P[2]+d.A[2])*d.Q;
    const ord=vol(dems[0])>=vol(dems[1])?[dems[0],dems[1]]:[dems[1],dems[0]];
    const ra=runDems(I,dems,14,ord), rb=runDems(I,dems,14,[ord[1],ord[0]]);
    if(ra.error&&rb.error)return ra;
    base=ra.error?rb:rb.error?ra:(rb.opts[0].floss<ra.opts[0].floss-1e-9?rb:ra);
    base.orderTried=[ra.error?null:ra.opts[0].floss,rb.error?null:rb.opts[0].floss];
    base.firstOrd=ord;
  }else base=runDems(I,dems,14);
  if(base.error||I.on2||I.Q<2) return base;
  return tryMix(I,base);
}
/* Mixed orientation (Blocks, single demand): the Q pieces are split in Group A (Q1) and Group B (Q2). Group A gets its V'' at the origin,
   Group B is fitted, in its own best orientation, in one of the leftovers (same machinery used for Demanded Part(s) II). It is kept only if it beats
   the single-orientation result by at least MIX_GAIN of the weighted loss (a second V'' means extra cuts). */
const MIX_GAIN=0.03;
function tryMix(I,base){
  const Q=I.Q, single=base.opts[0].floss, qs=[];
  for(let q1=Math.ceil(Q/2);q1<Q;q1++)qs.push(q1);
  const step=Math.max(1,Math.ceil(qs.length/12)); let bm=null;
  qs.filter((_,i)=>i%step===0||i===qs.length-1).forEach(q1=>{
    const r=runDems(I,[{id:0,P:I.P,A:I.A,Q:q1},{id:1,P:I.P,A:I.A,Q:Q-q1}],5);
    if(!r.error&&(!bm||r.opts[0].floss<bm.opts[0].floss-1e-9))bm=r;
  });
  if(bm&&single>0&&bm.opts[0].floss<single*(1-MIX_GAIN)-1e-9){
    bm.mix={q1:bm.first.Q,q2:bm.second.Q,single}; bm.cands=base.cands; bm.chosen=-1; MIXON=true; return bm;
  }
  return base;
}
function runDems(I,dems,poolN,forceSeq){
  dems.forEach(d=>{d.pc=d.P.map((p,i)=>p+d.A[i]);d.vol=d.pc[0]*d.pc[1]*d.pc[2]*d.Q});
  const seq=forceSeq||[...dems].sort((a,b)=>b.vol-a.vol);   // o de maior volume é cortado primeiro
  const first=seq[0], second=seq[1]||null;
  const core=solveCore(I.N,I.D,first.P,first.A,first.Q);
  if(core.fail) return {error:failMsg(core,dn(first.id))};
  const col=d=>d.id?'--demand2':'--demand';
  /* With two demands, the orientation of Part I is judged by the final result (Part I + Part II in the leftovers), not by Part I alone. */
  const pool=second?core.cands.slice(0,poolN||14):[core];
  let pick=null, firstErr=null;
  pool.forEach(c=>{
    const r=build(c);
    if(r.error){firstErr=firstErr||r;return}
    const sc=r.opts[0].floss, bg=Math.max(0,...r.opts[0].fl.map(o=>o.vol));
    if(!pick||sc<pick.sc-1e-9||(Math.abs(sc-pick.sc)<1e-9&&bg>pick.bg))pick={r,sc,bg};
  });
  if(!pick)return firstErr;
  pick.r.cands=core.cands; pick.r.chosen=pool.indexOf(pick.r)>=0?core.cands.indexOf(pick.r):0;
  return pick.r;
  function build(best){
  const env1={id:first.id,col:col(first),pos:[0,0,0],size:best.v,grid:best.perm.map(i=>best.fact[i]),q:first.Q};
  const fbig=l=>Math.max(0,...l.map(o=>o.vol));
  const allOff=best.opts.flatMap(o=>o.list).filter(o=>!o.empty);
  best.opts.forEach(op=>{
    if(!second){op.fl=op.list;op.floss=op.loss;op.envs=[env1];op.host=-1;return}
    let bf=null;
    op.list.forEach((h,hi)=>{
      if(h.empty)return;
      const sc=solveCore(h.size,I.D,second.P,second.A,second.Q);
      if(sc.fail)return;
      const subl=sc.opts[0].list.filter(o=>!o.empty).map(o=>({...o,pos:o.pos.map((q,k)=>q+h.pos[k])}));
      const fl=[]; op.list.forEach((o,j)=>{if(j===hi)fl.push(...subl);else if(!o.empty)fl.push(o)});
      const floss=fl.reduce((t,o)=>t+o.dev*o.kg,0), big=fbig(fl);
      if(!bf||floss<bf.floss-1e-9||(Math.abs(floss-bf.floss)<1e-9&&big>bf.big))
        bf={fl,floss,big,hi,env2:{id:second.id,col:col(second),pos:h.pos,size:sc.v,grid:sc.perm.map(i=>sc.fact[i]),q:second.Q}};
    });
    if(!bf){op.nofit=true;return}
    op.fl=bf.fl;op.floss=bf.floss;op.host=bf.hi;op.envs=[env1,bf.env2];
  });
  if(second){
    best.opts=best.opts.filter(o=>!o.nofit);
    if(!best.opts.length){
      const big=allOff.sort((a,b)=>b.vol-a.vol)[0];
      const mx=big?maxPerBlock(big.size,second.pc).n:0;
      return {error:`${dn(second.id)} (${second.Q} pcs) does not fit in the Offalls left over from ${dn(first.id)}, which is cut first. The largest Offall holds at most <b>${mx} pieces</b> of ${dn(second.id)}. Reduce the quantity or the dimensions.`};
    }
  }
  best.opts.sort((a,b)=>a.floss-b.floss||fbig(b.fl)-fbig(a.fl));
  best.I=I; best.dems=dems; best.first=first; best.second=second;
  best.volN=I.N[0]*I.N[1]*I.N[2]/1e9;
  best.volPieces=dems.reduce((t,d)=>t+d.P[0]*d.P[1]*d.P[2]*d.Q,0)/1e9;
  return best;
  }
}

/* ---------- 3D ---------- */
const cssv=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
/* Section-view style cut marker: arrow from p0 to p1 (screen coords) with the cut number in a circle beyond the tip. */
function cutArrow(c,p0,p1,n){
  const dx=p1[0]-p0[0],dy=p1[1]-p0[1],l=Math.hypot(dx,dy)||1,ux=dx/l,uy=dy/l;
  c.save();c.strokeStyle=cssv('--brand');c.fillStyle=cssv('--brand');c.lineWidth=2.2;c.lineCap='round';
  c.beginPath();c.moveTo(p0[0],p0[1]);c.lineTo(p1[0],p1[1]);c.stroke();
  c.beginPath();c.moveTo(p1[0]+ux*3,p1[1]+uy*3);c.lineTo(p1[0]-ux*9-uy*5,p1[1]-uy*9+ux*5);c.lineTo(p1[0]-ux*9+uy*5,p1[1]-uy*9-ux*5);c.closePath();c.fill();
  const cx=p1[0]+ux*17,cy=p1[1]+uy*17;
  c.beginPath();c.arc(cx,cy,10,0,Math.PI*2);c.fillStyle=cssv('--brand');c.fill();
  c.fillStyle=cssv('--brand-ink');c.font='600 12px '+cssv('--font-num');c.textAlign='center';c.textBaseline='middle';c.fillText(String(n),cx,cy+.5);
  c.restore();
}
function draw(cv,scene,view,o={}){
  const dpr=o.dpr||window.devicePixelRatio||1, W=cv.clientWidth, H=cv.clientHeight;
  if(!W||!H) return;
  if(cv.width!==Math.round(W*dpr)||cv.height!==Math.round(H*dpr)){cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr)}
  const c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  const N=scene.N, diag=Math.hypot(...N), pad=o.pad||(o.labels?46:10);
  const sc=(Math.min(W,H)-pad*1.2)/diag*1.0*(o.zoom||1.15);
  const cx=W/2, cy=H/2+(o.labels?4:0);
  const cyaw=Math.cos(view.yaw),syaw=Math.sin(view.yaw),cp=Math.cos(view.pitch),sp=Math.sin(view.pitch);
  const P=(p)=>{const x=p[0]-N[0]/2,y=p[1]-N[1]/2,z=p[2]-N[2]/2;
    const x1=x*cyaw+z*syaw, z1=-x*syaw+z*cyaw, y2=y*cp-z1*sp, z2=y*sp+z1*cp; return [cx+x1*sc,cy-y2*sc,z2]};
  const corner=(b,i)=>P([b.pos[0]+b.size[0]*(i&1),b.pos[1]+b.size[1]*((i>>1)&1),b.pos[2]+b.size[2]*((i>>2)&1)]);
  const FACES=[[0,1,3,2],[4,5,7,6],[0,1,5,4],[2,3,7,6],[0,2,6,4],[1,3,7,5]];
  const EDGES=[[0,1],[2,3],[4,5],[6,7],[0,2],[1,3],[4,6],[5,7],[0,4],[1,5],[2,6],[3,7]];
  const nominal={pos:[0,0,0],size:N};
  const boxes=[];
  scene.off.forEach((b,i)=>{if(b&&!b.empty)boxes.push({b,fill:cssv(COLORS[i%COLORS.length]),a:scene.hi===i?.55:.30,ln:cssv(COLORS[i%COLORS.length]),dash:false,lw:scene.hi===i?2:1})});
  const faces=[];
  const addFaces=(b,fill,a)=>FACES.forEach(f=>{const pts=f.map(i=>corner(b,i));faces.push({pts,z:pts.reduce((s,p)=>s+p[2],0)/4,fill,a})});
  boxes.forEach(x=>addFaces(x.b,x.fill,x.a));
  (scene.envs||[]).forEach(e=>addFaces(e,cssv(e.col),.20));
  addFaces(nominal,cssv('--nominal'),.07);
  faces.sort((a,b)=>a.z-b.z);
  faces.forEach(f=>{c.globalAlpha=f.a;c.fillStyle=f.fill;c.beginPath();f.pts.forEach((p,i)=>i?c.lineTo(p[0],p[1]):c.moveTo(p[0],p[1]));c.closePath();c.fill()});
  c.globalAlpha=1;
  const edges=(b,col,dash,lw)=>{c.strokeStyle=col;c.lineWidth=lw;c.setLineDash(dash);EDGES.forEach(([i,j])=>{const p=corner(b,i),q=corner(b,j);c.beginPath();c.moveTo(p[0],p[1]);c.lineTo(q[0],q[1]);c.stroke()});c.setLineDash([])};
  boxes.forEach(x=>edges(x.b,x.ln,[],x.lw));
  edges(nominal,cssv('--nominal'),[],o.labels?2:1.5);
  (scene.envs||[]).forEach(e=>{
    const g=e.grid, tot=g[0]*g[1]*g[2];
    if(o.labels&&tot>1&&tot<=600){ // separação peça a peça dentro do volume
      const cs=e.size.map((s,i)=>s/g[i]);
      c.globalAlpha=.45;
      for(let a=0;a<g[0];a++)for(let b=0;b<g[1];b++)for(let d=0;d<g[2];d++)
        edges({pos:[e.pos[0]+a*cs[0],e.pos[1]+b*cs[1],e.pos[2]+d*cs[2]],size:cs},cssv(e.col),[2,4],1);
      c.globalAlpha=1;
    }
    edges(e,cssv(e.col),[6,4],o.labels?2:1.5);
  });
  if(o.labels){
    c.font='500 12px '+cssv('--font-num');c.fillStyle=cssv('--fg');c.textAlign='center';c.textBaseline='middle';
    const lab=[[[N[0]/2,0,N[2]],`W ${Lc(N[0],0)}`],[[N[0],N[1]/2,N[2]],`H ${Lc(N[1],0)}`],[[N[0],0,N[2]/2],`L ${Lc(N[2],0)}`]];
    const ctr=P([N[0]/2,N[1]/2,N[2]/2]);
    lab.forEach(([p,t])=>{const q=P(p);let dx=q[0]-ctr[0],dy=q[1]-ctr[1];const l=Math.hypot(dx,dy)||1;
      const tw=c.measureText(t).width+10;c.fillStyle=cssv('--surface');c.globalAlpha=.9;c.fillRect(q[0]+dx/l*22-tw/2,q[1]+dy/l*16-9,tw,18);c.globalAlpha=1;
      c.fillStyle=cssv('--fg');c.fillText(t,q[0]+dx/l*22,q[1]+dy/l*16)});
  }
  (scene.cuts||[]).forEach(k=>{
    const pts=k.poly.map(P);
    c.beginPath();pts.forEach((q,i)=>i?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1]));c.closePath();
    c.globalAlpha=.16;c.fillStyle=cssv('--brand');c.fill();c.globalAlpha=1;
    c.strokeStyle=cssv('--brand');c.lineWidth=1.8;c.setLineDash([7,3]);c.stroke();c.setLineDash([]);
    // arrow starts at the middle of the outer face of the Offall being separated and points away from the block
    const e=[...k.a0];e[k.axis]+=k.len;
    const bp={p0:P(k.a0),p1:P(e)};
    cutArrow(c,bp.p0,bp.p1,k.n);
  });
}
function sceneOf(r,opt,hi){return {N:r.I.N,envs:opt.envs,off:opt.fl,hi}}

function oriRows(r){
  const PN=['W\'','H\'','L\''], seen=new Map();
  PERMS.forEach(p=>{
    const c=r.cands.find(x=>x.perm===p);
    const lab=AX.map((a,i)=>a+' ← '+PN[p[i]]).join(', ');
    if(!c){seen.set('nofit'+p.join(''),{lab,none:true});return}
    const key=c.v.map(x=>x.toFixed(3)).join('|')+'|'+c.loss0.toFixed(6);
    if(seen.has(key))seen.get(key).lab+=' &nbsp;=&nbsp; '+lab; else seen.set(key,{lab,c,best:c===r.cands[r.chosen]});
  });
  const rows=[...seen.values()].sort((a,b)=>(a.none?1:0)-(b.none?1:0)||(a.none?0:a.c.loss0-b.c.loss0));
  const mixRow=r.mix?`<tr style="background:var(--brand-soft)"><td class="num">Mixed: ${dn(0)} (${r.mix.q1} pcs) + ${dn(1)} (${r.mix.q2} pcs)</td><td class="r num">${r.opts[0].envs.map(e=>e.size.map(z=>Lc(z,0)).join(' × ')).join('<br>')}</td><td class="num">${r.opts[0].envs.map(e=>e.grid.join(' × ')).join(' + ')}</td><td class="r num">${Wu(r.opts[0].floss,2)}</td><td><span class="pill p-good">Chosen</span></td></tr>`:'';
  return mixRow+rows.map(x=>x.none?`<tr><td class="num">${x.lab}</td><td class="r num">—</td><td>—</td><td class="r">—</td><td class="note">does not fit in the block</td></tr>`
    :`<tr${x.best?' style="background:var(--brand-soft)"':''}><td class="num">${x.lab}</td><td class="r num">${x.c.v.map(z=>Lc(z,0)).join(' × ')}</td><td class="num">${x.c.perm.map(i=>x.c.fact[i]).join(' × ')}</td><td class="r num">${Wu(x.c.loss0,2)}</td><td>${x.best?'<span class="pill p-good">Chosen</span>':'<span class="note">fits</span>'}</td></tr>`).join('');
}
/* ---------- Render ---------- */
const classOf=d=>d<=0?'p-good':d<1?'p-warn':'p-bad';
const pct=d=>nf(d*100,0)+'%';
function render(){
  $('d2body').classList.toggle('muted',!$('d2on').checked);$('d2body').closest('section').hidden=!$('d2on').checked;
  const main=$('main'); const kgOf=pieceWeight(); const r=solve(); state.res=r;
  if(r.error){main.innerHTML=`<div class="err" role="alert">${r.error}</div>`;dgUpdate('BL',null);return}
  if(state.sel>=r.opts.length)state.sel=0;
  const opt=r.opts[state.sel], I=r.I, fl=opt.fl, dual=!!r.second, cdual=dual&&!r.mix;
  dgUpdate('BL',{list:opt.envs.map(e=>({label:dn(e.id)+' · '+Lc(e.size[0],0)+' × '+Lc(e.size[1],0)+' × '+Lc(e.size[2],0),mm:e.size}))});
  const perm=r.perm.map(i=>AX[i]).join(' ');
  const totKg=fl.reduce((s,o)=>s+o.kg,0), lossKg=opt.floss;
  const mat=PRICES[Math.min(state.mat,PRICES.length-1)];
  const cd=r.mix?[{id:0,Q:I.Q,kg:kgOf[0],w:kgOf[0]*I.Q}]:r.dems.map(d=>({id:d.id,Q:d.Q,kg:kgOf[d.id],w:kgOf[d.id]*d.Q})).sort((a,b)=>a.id-b.id);
  const wSum=cd.reduce((s,d)=>s+d.w,0);
  cd.forEach(d=>{d.loss=lossKg*d.w/wSum;d.cost=(d.w+d.loss)*mat.kg/d.Q});
  const calcKg=wSum+lossKg, lotCost=calcKg*mat.kg;
  const money=n=>'$ '+nf(n,2);
  const envVol=e=>e.size[0]*e.size[1]*e.size[2]/1e9;
  const volEnv=opt.envs.reduce((s,e)=>s+envVol(e),0);
  const lg=(col,txt,dash)=>`<span><i class="${dash?'dash':''}" style="border-color:var(${col});background:color-mix(in srgb,var(${col}) 35%,transparent)"></i>${txt}</span>`;
  main.innerHTML=`
  <div class="kpis">
    ${opt.envs.map(e=>`<div class="kpi" style="border-top:3px solid var(${e.col})"><span class="l">V'' · ${dn(e.id)}</span><span class="v num">${Lc(e.size[0],0)} × ${Lc(e.size[1],0)} × ${Lc(e.size[2],0)}</span><span class="s">${LUl()} · arrangement ${e.grid.join(' × ')} (${e.q} pcs)</span></div>`).join('')}
    <div class="kpi"><span class="l">Useful pieces / Feedstock</span><span class="v num">${nf(r.volPieces/r.volN*100,1)}%</span><span class="s">${Wu(r.volPieces*I.D,1)} of ${Wu(r.volN*I.D,1)}</span></div>
    <div class="kpi"><span class="l">V'' / Feedstock</span><span class="v num">${nf(volEnv/r.volN*100,1)}%</span><span class="s">${Wu(volEnv*I.D,1)} with allowance</span></div>
    <div class="kpi"><span class="l">Offall total</span><span class="v num">${Wu(totKg,1)}</span><span class="s">${nf(totKg/(r.volN*I.D)*100,1)}% of Feedstock</span></div>
  </div>

  <section class="card ori pl${PL.c?' collapsed':''}">
    <header class="orhead plhead" role="button" tabindex="0" aria-expanded="${!PL.c}"><h2 style="display:flex;align-items:center;gap:8px"><i class="chev" aria-hidden="true"></i>Placement in the Feedstock block</h2>
      <div class="legend"><span><i style="border-color:var(--nominal);background:var(--nominal-fill)"></i>Feedstock</span>${opt.envs.map((e,k)=>lg(e.col,k===0?`V'' ${dn(e.id)} (pieces + allowance, split piece by piece)`:`V'' ${dn(e.id)}`,true)).join('')}<span style="flex-basis:100%;height:0"></span>${fl.map((o,i)=>lg(COLORS[i%COLORS.length],`Offall ${i+1}`)).join('')}</div></header>
    <div class="stage" id="stage"><canvas id="cv" aria-label="3D drawing of the Feedstock block with the demanded volumes and the Offalls"></canvas><span class="hint">V'' orientation in the Feedstock: axes ${perm}${dual?` · ${dn(r.first.id)} is cut first (the order with the lowest loss)`:''} · drag to rotate</span></div>
  </section>

  <section class="card ori${OR.c?' collapsed':''}" id="orient">
    <header class="orhead" role="button" tabindex="0" aria-expanded="${!OR.c}" aria-controls="orbody"><h2 style="display:flex;align-items:center;gap:8px"><i class="chev" aria-hidden="true"></i>Piece orientations tested</h2><span class="tag">${r.mix?'mixed orientation chosen':dual?'Part I · orientation judged on the final result':'all rotations of the piece in the block'}</span></header>
    <div id="orbody"><div class="tablewrap"><table>
      <thead><tr><th>Block axes ← piece axes</th><th class="r">V'' W × H × L (${LUl()})</th><th>Arrangement</th><th class="r">Weighted loss</th><th>Result</th></tr></thead>
      <tbody>${oriRows(r)}</tbody>
    </table></div>
    <div class="body"><p class="note" style="margin:0">The piece is tried in every orientation (W', H', L' on W, H, L: 6 combinations, repeated ones collapse when the piece is symmetric). Each orientation uses its best arrangement of the ${r.first.Q} pcs and its best cutting order; the lowest weighted loss wins.${r.orderTried?` Combined order: both cutting orders were simulated (${dn(r.firstOrd[0].id)} first: ${r.orderTried[0]==null?'does not fit':Wu(r.orderTried[0],2)}; ${dn(r.firstOrd[1].id)} first: ${r.orderTried[1]==null?'does not fit':Wu(r.orderTried[1],2)}) and the lower loss was kept.`:''}${r.mix?` Splitting the ${r.I.Q} pcs in two groups with different orientations gives a weighted loss of ${Wu(r.opts[0].floss,2)} against ${Wu(r.mix.single,2)} for the best single orientation (a gain of at least ${nf(MIX_GAIN*100,0)}% is required, because the second V\'\' adds cuts).`:''}</p></div></div>
  </section>

  <section class="card ori${CS.c?' collapsed':''}" id="cutseq">
    <header class="orhead cshead" role="button" tabindex="0" aria-expanded="${!CS.c}" aria-controls="csbody"><h2 style="display:flex;align-items:center;gap:8px"><i class="chev" aria-hidden="true"></i>Cutting sequence</h2><span class="tag">${opt.order.map(i=>AX[i]).join(' → ')} · option ${state.sel+1} of ${r.opts.length}</span></header>
    <div id="csbody" class="csbody"><div class="body"><p class="note" style="margin:0 0 10px">Pick an option. The recommended one has the lowest depreciation loss.${dual?` ${dn(r.second.id)} is cut from one of the Offalls of ${dn(r.first.id)}.`:''}</p>
    <div class="opts" id="opts"></div></div></div>
  </section>

  <section>
    <div class="offs" id="offs"></div>
  </section>

  <section class="card">
    <header style="flex-wrap:wrap"><h2>Devaluation</h2><span style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-left:auto;justify-content:flex-end">${devSeg('b')}<span class="tag">Option ${state.sel+1} · cut ${opt.order.map(i=>AX[i]).join(' → ')}${dual?` + ${dn(r.second.id)} from leftover ${opt.host+1}`:''}</span></span></header>
    <div class="tablewrap"><table>
      <thead><tr><th>Block</th><th class="r">W × H × L (${LUl()})</th><th class="r">Weight</th><th>Rule applied</th><th class="r">Depreciation</th><th class="r">${DVH()}</th></tr></thead>
      <tbody>${fl.map((o,i)=>o.empty?`<tr><td><b style="color:var(${COLORS[i%COLORS.length]})">Offall ${i+1}</b></td><td colspan="5" class="note">No leftover: the Feedstock dimension matches V'' in this cut.</td></tr>`:`
        <tr data-i="${i}"><td><b style="color:var(${COLORS[i%COLORS.length]})">Offall ${i+1}</b></td>
        <td class="r num">${Lc(o.size[0],0)} × ${Lc(o.size[1],0)} × ${Lc(o.size[2],0)}</td>
        <td class="r num">${Wu(o.kg,1)}</td>
        <td class="num">${o.slot?'Unused slot(s) in V\'\' · ':''}Band ${o.m.band} · thk ${nf(o.m.small,1)}" · ${o.m.ok?'meets':'doesn\'t meet'} dim. → ${usd(o.m.v)} <span class="pctnote">(material ${usd(o.m.P)})</span></td>
        <td class="r"><span class="pill ${classOf(o.dev)}">${pct(o.dev)}</span></td>
        <td class="r num">${DV(o.dev*o.kg,'BL')}</td></tr>`).join('')}</tbody>
      <tfoot><tr><td>Total</td><td></td><td class="r num">${Wu(totKg,1)}</td><td>${DEV$?'Total amount devalued':'Weighted depreciated weight'}</td><td class="r"><span class="pill ${classOf(totKg?lossKg/totKg:0)}">${pct(totKg?lossKg/totKg:0)}</span></td><td class="r num">${DV(lossKg,'BL')}</td></tr></tfoot>
    </table></div>
    <details><summary>How the depreciation is found</summary>
      <p class="note">Spreadsheet Devaluation_v7.xlsx, tab "Rules_Blocks". Each Offall has its 3 dimensions sorted (smallest, intermediate, largest). The smallest dimension (the Thickness), in inches, defines the band. If the intermediate and the largest meet the band minimums, the "if met" value applies; otherwise, the "if not met" value (in $/${MUl()}). Equality counts as met. Depreciation is (price of the material selected in Costing − Offall value) ÷ material price, limited to 0%–100%.</p>
      <div class="tablewrap"><table><thead><tr><th>Band</th><th class="r">Thickness ≥ (in)</th><th class="r">Thickness &lt; (in)</th><th class="r">Interm. ≥ (${LUl()})</th><th class="r">Largest ≥ (${LUl()})</th><th class="r">If met ($/${MUl()})</th><th class="r">If not met ($/${MUl()})</th></tr></thead>
      <tbody>${RULES.map(x=>`<tr><td class="num">${x.n}</td><td class="r num">${x.minIn}</td><td class="r num">${x.maxIn}</td><td class="r num">${Lc(x.mid,1)}</td><td class="r num">${Lc(x.big,1)}</td><td class="r num">${nf(PP(x.ok),2)}</td><td class="r num">${nf(PP(x.no),2)}</td></tr>`).join('')}</tbody></table></div>
    </details>
  </section>

  <section class="card">
    <header><h2>Material Cost</h2>${omChk('blocks')}<span class="tag">Price list Oct26 · Blocks, PF, SEC, PFR-N, ISO</span></header>
    <div class="cost">
      <div class="in">
        ${omSt('blocks').on?omHTML('blocks',cdual?cd.map(d=>dn(d.id)):['']):`
        ${PRICE_SAMPLE?'<div class="sample">Price List Trading not loaded yet. The prices below are examples.</div>':''}
        <div class="field"><label for="mat">Material · grade and size</label>
          <select id="mat">${[...new Set(PRICES.map(p=>p.grp))].map(g=>`<optgroup label="${g}">${PRICES.map((p,i)=>p.grp===g?`<option value="${i}" ${i===state.mat?'selected':''}>${p.name} ($ ${nf(PP(p.kg),2)}/${MUl()})</option>`:'').join('')}</optgroup>`).join('')}</select></div>
        ${matLow('BL')}${matCard('BL')}${xcHTML('blocks')}
        <dl class="dl num">
          ${cd.map(d=>`<dt>${r.mix?'Pieces (both groups)':dn(d.id)} · ${Wu(d.kg,2)} × ${d.Q} pcs</dt><dd>${Wu(d.w,2)} <span class="pctnote" title="Demand weight ÷ total calculation weight">(${nf(calcKg?d.w/calcKg*100:0,1)}%)</span></dd>`).join('')}
          <dt>+ Weighted depreciated weight</dt><dd>${Wu(lossKg,2)} <span class="pctnote" title="Depreciated weight ÷ total calculation weight">(${nf(calcKg?lossKg/calcKg*100:0,1)}%)</span></dd>
          <dt><b>Total calculation weight</b></dt><dd><b>${Wu(calcKg,2)}</b></dd>
          <dt>Cost per ${MUl()}</dt><dd>$ ${nf(PP(mat.kg),2)}/${MUl()}</dd>
          <dt>Lot cost</dt><dd>${money(lotCost)}</dd>
          ${cd.map(d=>`<dt><b>Piece cost${cdual?' · '+dn(d.id):''}</b></dt><dd><b>${money(d.cost)}</b> /pc</dd>`).join('')}
          ${cd.map((d,i)=>`<dt><b>Piece cost + Extra cost${cdual?' · '+dn(d.id):''}</b></dt><dd><b data-pcx="${cdual?'b'+i:'b'}">—</b> /pc</dd>`).join('')}
        </dl>
        ${cd.map(d=>`<p class="memo num">${cdual?`${dn(d.id)}: (${Wc(d.w,2)} + ${Wu(d.loss,2)}) × cost per ${MUl()} ÷ ${d.Q} pcs`:`Total weight × cost per ${MUl()} ÷ ${d.Q} pcs`}</p>`).join('')}
        ${cdual?'<p class="note" style="margin:0">The depreciated weight is split between the two demands in proportion to the weight of each.</p>':''}
        `}
        ${omSt('blocks').on?'':cdual?cd.map((d,i)=>mchHTML('b'+i,dn(d.id))).join(''):mchHTML('b')}
      </div>
      <div class="final${cdual?' split':''}">${cdual?cd.map((d,i)=>`<div class="pan"><div class="fin mfin" data-k="b${i}" data-t="${dn(d.id)}"></div>${pafBtn('blocks','b'+i)}</div>`).join(''):'<div class="fin mfin" data-k="b"></div>'+pafBtn('blocks','b')}</div>
    </div>
  </section>`;
  omInit();
  if($('mat'))$('mat').onchange=e=>{state.mat=+e.target.value;render()}; window.__MCHP=window.__MCHP||{};(cdual?cd.forEach((d,i)=>mcSet('blocks','b'+i,omPrice('blocks',i,d.cost))):mcSet('blocks','b',omPrice('blocks',0,cd[0].cost)));xcShow('blocks');matBind(); if(cdual)cd.forEach((d,i)=>mchBind('b'+i)); else mchBind('b');

  // opções
  const optsEl=$('opts');
  r.opts.forEach((op,i)=>{
    const b=document.createElement('button');b.className='opt';b.type='button';b.setAttribute('aria-pressed',i===state.sel);
    const w=op.fl.reduce((s,o)=>s+o.kg,0);
    b.innerHTML=`<canvas></canvas><div class="t"><span>Option ${i+1} · ${op.order.map(k=>AX[k]).join(' → ')}</span>${i===0?'<span class="best">Recommended</span>':''}</div><div class="m num">Loss ${Wu(op.floss,1)} · ${w?nf(op.floss/w*100,0):0}%${dual?` · II in leftover ${op.host+1}`:''}</div>`;
    b.onclick=()=>{state.sel=i;state.hi=-1;render()};
    optsEl.appendChild(b);
  });
  {const oc=$('orient'),oh=oc&&oc.querySelector('.orhead');
   if(oh){const tg=()=>{OR.c=!OR.c;oc.classList.toggle('collapsed',OR.c);oh.setAttribute('aria-expanded',String(!OR.c));try{localStorage.setItem('or-collapsed',OR.c?'1':'0')}catch(e){}};
     oh.onclick=tg;oh.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tg()}}}}
  {const cs=$('cutseq'),h=cs&&cs.querySelector('.cshead');
   if(h){const tg=()=>{CS.c=!CS.c;cs.classList.toggle('collapsed',CS.c);h.setAttribute('aria-expanded',String(!CS.c));try{localStorage.setItem('cs-collapsed',CS.c?'1':'0')}catch(e){}};
     h.onclick=tg;h.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tg()}}}}
  // offalls
  $('offs').innerHTML=fl.map((o,i)=>`
    <article class="off ${state.hi===i?'hi':''}" data-i="${i}" style="--c:var(${COLORS[i%COLORS.length]})">
      <h3><span>Offall ${i+1}</span>${o.empty?'<span class="note">no leftover</span>':`<span class="pill ${classOf(o.dev)}">${pct(o.dev)}</span>`}</h3>
      ${o.empty?'<p class="note" style="margin:0">This cut leaves no material.</p>':`
      <dl class="dl num"><dt>W${i+1}</dt><dd>${Lu(o.size[0],1)}</dd><dt>H${i+1}</dt><dd>${Lu(o.size[1],1)}</dd><dt>L${i+1}</dt><dd>${Lu(o.size[2],1)}</dd><dt>Volume</dt><dd>${Vu(o.vol)}</dd></dl>
      <div class="weight num"><small>P = V × D</small><span>${Wu(o.kg,1)}</span></div>`}
    </article>`).join('');
  document.querySelectorAll('.off,#main tbody tr[data-i]').forEach(el=>{
    el.onmouseenter=()=>{state.hi=+el.dataset.i;paint()};el.onmouseleave=()=>{state.hi=-1;paint()};
  });
  paint();
  const stage=$('stage');
  let drag=null;
  stage.onpointerdown=e=>{drag=[e.clientX,e.clientY];stage.setPointerCapture(e.pointerId)};
  stage.onpointermove=e=>{if(!drag)return;state.view.yaw+=(e.clientX-drag[0])*0.008;state.view.pitch=Math.max(-1.4,Math.min(1.4,state.view.pitch+(e.clientY-drag[1])*0.008));drag=[e.clientX,e.clientY];paint(true)};
  stage.onpointerup=stage.onpointercancel=()=>{drag=null};
}
function paint(mainOnly){
  const r=state.res; if(!r||r.error)return;
  const opt=r.opts[state.sel];
  const cv=$('cv'); if(cv)draw(cv,sceneOf(r,opt,state.hi),state.view,{labels:true});
  if(mainOnly)return;
  document.querySelectorAll('.off').forEach(el=>el.classList.toggle('hi',+el.dataset.i===state.hi));
  document.querySelectorAll('#opts .opt canvas').forEach((c,i)=>draw(c,sceneOf(r,r.opts[i],-1),{yaw:-0.62,pitch:0.42},{zoom:1.3}));
}
document.querySelectorAll('#tab-blocks .side input').forEach(i=>i.addEventListener('input',()=>{state.sel=0;render()}));
window.addEventListener('resize',()=>{paint();rPaint()});
matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{paint();rPaint()});
new MutationObserver(()=>{paint();rPaint()}).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>{paint();rPaint()});

/* =================== ABAS =================== */
const TABS=['blocks','rods','rounds'];
function showTab(t){
  TABS.forEach(k=>{$('tab-'+k).hidden=(k!==t);const b=$('tabbtn-'+k);b.setAttribute('aria-selected',k===t);b.tabIndex=k===t?0:-1});
  if(t==='blocks')paint(); if(t==='rods'){rRender()}
}
TABS.forEach(k=>$('tabbtn-'+k).addEventListener('click',()=>showTab(k)));
$('tabs').addEventListener('keydown',e=>{
  const i=TABS.findIndex(k=>!$('tab-'+k).hidden); let n=i;
  if(e.key==='ArrowRight')n=(i+1)%3; else if(e.key==='ArrowLeft')n=(i+2)%3; else return;
  showTab(TABS[n]); $('tabbtn-'+TABS[n]).focus();
});

/* =================== RODS =================== */
/* 2026 Ei6 Machining price list_detail_Oct26.xlsx, aba "2026 Master Price List": coluna "Nominal Size" e "Price Per lb" (só itens com preço). Seção "Extruded rods". kg = $/lb ÷ 0,45359237. */
const RODPRICES=__D.prices_rods;

/* ---- Collar feedstock: when the demanded OD fits the Small OD (OD ≤ small OD), cutting STARTS at the free end of the Small OD section and CONTINUES
   sequentially along the axis (through the junction into the large-OD section) until all pieces are cut, regardless of yield elsewhere.
   Excess OD of each zone is machined away (100% loss). If OD > small OD, cutting starts at the free end of the large-OD section. ---- */
function collarPlan(I,Lpc,tube,dm,split){
  const canS=I.od<=I.d1+0.01, tol=1e-6, Ltot=I.l1+I.l2, used=I.Q*Lpc, cap=canS?Ltot:I.l2;
  if(used>cap+tol){
    const mx=Math.floor((cap+tol)/Lpc);
    return {error:mx<1?`Not even one piece fits in the Collar: the L with allowance (${Lu(Lpc,1)}) is greater than the available length (${Lu(cap,1)}${canS?'':', large OD section only: the OD is larger than the small OD'}).`
      :`The ${I.Q} pieces (${Lu(Lpc,1)} each, with allowance) do not fit in the Collar${canS?'':' (large OD section only)'}, which offers ${Lu(cap,1)}. <b>Maximum: ${mx} pieces</b>. ${I.Q} pieces would need ${Math.ceil(I.Q/mx)} Collars.`};
  }
  const parts=[], segs=[], rings=[], corePs=[];
  let dems, us, ul;
  if(canS){
    us=Math.min(used,I.l1); ul=Math.max(0,used-I.l1);
    dems=[{z0:0,z1:used,n:I.Q}];
    if(tube)(split?corePs:parts).push({z0:0,z1:used,r:dm/2});
    if(us>0&&I.d1-I.od>0.01)rings.push({Do:I.d1,Di:I.od,L:us,z0:0,z1:us});
    if(ul>0&&I.D2-I.od>0.01)rings.push({Do:I.D2,Di:I.od,L:ul,z0:I.l1,z1:I.l1+ul});
    if(used<I.l1&&I.l1-used>=1){parts.push({z0:used,z1:I.l1,r:I.d1/2});segs.push({d:I.d1,l:I.l1-used})}
    const st=Math.max(used,I.l1); if(Ltot-st>=1){parts.push({z0:st,z1:Ltot,r:I.D2/2});segs.push({d:I.D2,l:Ltot-st})}
  }else{
    us=0; ul=used; dems=[{z0:Ltot-used,z1:Ltot,n:I.Q}];
    parts.push({z0:0,z1:I.l1,r:I.d1/2});segs.push({d:I.d1,l:I.l1});
    const rl=I.l2-used; if(rl>=1){parts.push({z0:I.l1,z1:I.l1+rl,r:I.D2/2});segs.push({d:I.D2,l:rl})}
    if(tube)(split?corePs:parts).push({z0:Ltot-used,z1:Ltot,r:dm/2});
    if(I.D2-I.od>0.01)rings.push({Do:I.D2,Di:I.od,L:used,z0:Ltot-used,z1:Ltot});
  }
  const coreLen=tube&&!split?used:0;
  let off=null;
  if(parts.length){
    const grp=[]; const add=(d,l,core)=>{let g=grp.find(x=>Math.abs(x.d-d)<0.01); if(g){g.l+=l;g.core=g.core&&core}else grp.push({d,l,core})};
    if(coreLen>0)add(dm,coreLen,true);
    segs.forEach(g=>add(g.d,g.l,false));
    if(grp.length===1) off={type:'rod',D:grp[0].d,L:grp[0].l,parts};
    else if(grp.length===2){grp.sort((a,b)=>a.d-b.d); off={type:'collar',d1:grp[0].d,l1:grp[0].l,D2:grp[1].d,l2:grp[1].l,parts}}
    else{const c=grp.find(g=>g.core)||grp[0], o=grp.filter(g=>g!==c).sort((a,b)=>a.d-b.d);
      off={type:'collar',d1:o[0].d,l1:o[0].l,D2:o[1].d,l2:o[1].l,parts,core:{d:c.d,l:c.l}}}
  }
  const coreOff=split&&tube&&corePs.length?{type:'core',D:dm,L:used,parts:corePs}:null;
  return {canS,us,ul,used,dems,rings,off,coreOff,Ltot};
}
const ringAgg=(rings,od)=>rings.length?{Do:Math.max(...rings.map(g=>g.Do)),Di:od,L:rings.reduce((t,g)=>t+g.L,0),rings,z0:rings[0].z0,z1:rings[0].z1}:null;
const ringTxt=rx=>rx.rings.map(g=>`OD ${Lc(g.Do,1)} · ID ${Lc(g.Di,1)} × ${Lc(g.L,1)}`).join('<br>');
const ringNote=(label,I,rx)=>`${label} with OD (${Lu(I.od,1)}) smaller than the Feedstock ${rx.rings.length>1?'ODs':'OD'} (${rx.rings.map(g=>Lu(g.Do,1)).join(' / ')}): the ${Wu(rx.kg,1)} excess is 100% machined away and counts as depreciation with a 100% loss.`;
const cutNote=r=>r.I.collar&&r.pl?`<p class="note" style="margin:8px 0 0">Collar cut order: ${r.pl.canS?`cutting starts at the free end of the Small OD section and continues in sequence (${Lu(r.pl.us,1)} in the small OD section${r.pl.ul>0?`, then ${Lu(r.pl.ul,1)} into the large OD section`:''}).`:'the demanded OD is larger than the Small OD, so cutting starts at the free end of the large OD section.'}</p>`:'';
/* Devaluation_v7.xlsx, abas Rules_Rods / Rules_Rounds / Rules_Collars. Valores digitados em $/lb (convertidos para $/kg internamente).
   Faixa de comprimento = L(offall) ÷ L(original do material): ≥80% | 60–80% | 40–60% | 20–40% | <20%. Linha por øext (exato ±0,02" ou o øext imediatamente abaixo). */
const ROD_RULES_READY=true;
const LB2KG=2.20462, TOL_IN=0.02, BAND_LB=[0.8,0.6,0.4,0.2], BAND_TXT=['≥ 80%','60–80%','40–60%','20–40%','< 20%'];
const ROD_V7=__D.devaluation.rods;
const RND_V7=__D.devaluation.rounds;
const RND_LIM=24, RND_ABS=[[1,0],[4,0.9072]];                     // OD ≤ 24" follows rods; L<1" → 0; 1"≤L<4" → $0,9072/lb
const bandOf=ratio=>{ratio=Math.round(ratio*1e6)/1e6;let b=1;BAND_LB.forEach(x=>{if(ratio<x)b++});return b};
const rowOf=(tbl,dIn)=>{let r=null;tbl.forEach(x=>{if(x[0]<=dIn+TOL_IN)r=x});return r};
/* Values one segment (OD, L in mm) against the original material (P in $/kg internal, Lo in inches). useRounds: table choice by OD. */
function segV7(dMm,lMm,P,Lo,forceRods){
  const dIn=dMm/IN, lIn=lMm/IN, useRnd=!forceRods&&dIn>RND_LIM+1e-9;
  const tag=r=>Math.abs(r[0]-dIn)<=TOL_IN?`ø${r[0]}"`:`ø${nf(dIn,2)}" → row ø${r[0]}"`;
  if(useRnd){
    if(lIn<RND_ABS[0][0]-1e-9) return {v:RND_ABS[0][1]*LB2KG,txt:`Round ø${nf(dIn,2)}" · L ${nf(lIn,1)}" < 1"`};
    if(lIn<RND_ABS[1][0]-1e-9) return {v:RND_ABS[1][1]*LB2KG,txt:`Round ø${nf(dIn,2)}" · 1" ≤ L ${nf(lIn,1)}" < 4"`};
  }
  const tbl=useRnd?RND_V7:ROD_V7, r=rowOf(tbl,dIn), kind=useRnd?'Round':'Rod';
  if(!r) return {v:P,na:true,txt:`${kind} ø${nf(dIn,2)}" below the smallest table row (${tbl[0][0]}") — no rule, no depreciation`};
  const ratio=lIn/Lo, bd=bandOf(ratio);
  return {v:r[1][bd-1]*LB2KG,txt:`${kind} ${tag(r)} · L ${nf(lIn,1)}" = ${nf(ratio*100,0)}% of ${nf(Lo,0)}" (band ${bd}, ${BAND_TXT[bd-1]})`};
}
/* Offall (rod / collar) valued with the v7 rules. forceRods: plain rod offall of the Rods tab always uses the Rods table. */
function valueV7(off,P,Lo,forceRods){
  const out=(v,txt,na)=>({dev:depOf(P,v),v,P,na:!!na,info:`${txt} → ${usd(v)} (material ${usd(P)})`});
  if(off.type!=='collar'){
    const g=segV7(off.D,off.L,P,Lo,forceRods);
    return g.na?{dev:0,na:true,info:g.txt}:out(g.v,g.txt);
  }
  const segs=[{d:off.d1,l:off.l1},{d:off.D2,l:off.l2}]; if(off.core)segs.push({d:off.core.d,l:off.core.l});
  const act=segs.filter(g=>g.d>0&&g.l>0), vol=act.map(g=>g.d*g.d*g.l), tv=vol.reduce((a,b)=>a+b,0);
  const res=act.map(g=>segV7(g.d,g.l,P,Lo,false));
  if(res.length&&res.every(g=>g.na)) return {dev:0,na:true,info:res.map(g=>g.txt).join(' / ')};
  const v=res.reduce((t,g,i)=>t+g.v*vol[i]/tv,0);
  const txt='Collar by segments: '+res.map((g,i)=>`[${g.txt} · ${nf(vol[i]/tv*100,0)}% of weight → ${usd(g.v)}]`).join(' + ');
  return out(v,txt);
}
function matchDevRod(off){
  const m=RODPRICES[Math.min(rstate.mat,RODPRICES.length-1)];
  return valueV7(off,m.kg,m.L,true);
}
const rstate={mat:0,view:{yaw:-0.55,pitch:0.38}};
function rRead(){
  const g=gv;
  return {collar:$('rCollar').checked,mode:document.querySelector('input[name=rmode]:checked').value,
    D:g('rD'),L:g('rL'),d1:g('rD1'),l1:g('rL1'),D2:g('rD2'),l2:g('rL2'),rho:g('rDens'),
    od:g('rdOD'),id:g('rdID'),len:g('rdL'),Q:Math.round(g('rQty')),aI:g('raID')||0,aL:g('raL')||0};
}
const cylKg=(d,l,rho)=>Math.PI/4*d*d*l/1e9*rho;
function rSidebar(){
  const I=rRead(), tube=I.mode==='tube';
  $('rPlain').hidden=I.collar; $('rCollarF').hidden=!I.collar;
  $('rdIDf').hidden=!tube; $('raIDf').hidden=!tube;
  const nw=$('rnomw');
  const nomKg=I.collar?(I.d1>0&&I.l1>0&&I.D2>0&&I.l2>0&&I.rho>0?cylKg(I.d1,I.l1,I.rho)+cylKg(I.D2,I.l2,I.rho):null):(I.D>0&&I.L>0&&I.rho>0?cylKg(I.D,I.L,I.rho):null);
  nw.innerHTML=nomKg==null?'':(I.collar?`<dt>Total L</dt><dd>${Lu(I.l1+I.l2,1)}</dd>`:'')+`<dt>Total weight</dt><dd><b>${Wu(nomKg,1)}</b></dd>`;
  const el=$('rpcw');
  const okIn=I.od>0&&I.len>0&&I.Q>0&&I.rho>0&&(!tube||(I.id>0&&I.id<I.od));
  if(!okIn){el.innerHTML='';return null}
  const Lpc=I.len+I.aL;
  const kg=tube?(cylKg(I.od,Lpc,I.rho)-cylKg(I.id,Lpc,I.rho)):cylKg(I.od,Lpc,I.rho);
  const mx=I.collar?Math.floor(((I.od<=I.d1+0.01?I.l1+I.l2:I.l2)+1e-6)/Lpc):(I.L>0?Math.floor((I.L+1e-6)/Lpc):null);
  el.innerHTML=`<dt>L with allowance</dt><dd>${Lu(Lpc,1)}</dd><dt>Weight per piece</dt><dd>${Wu(kg,2)}</dd><dt>Total (${I.Q} pcs)</dt><dd><b>${Wu(kg*I.Q,2)}</b></dd>`+(mx!=null?`<dt>Max per Feedstock rod</dt><dd>${nf(mx)} pcs</dd>`:'');
  return kg;
}
function rSolve(){
  const I=rRead(), tube=I.mode==='tube', bad=a=>a.some(x=>!(x>0));
  if(bad([I.rho,I.Q,I.od,I.len])) return {error:'Fill in OD, L, quantity and density with values greater than zero.'};
  let Dmaj,Lmaj,Ltot,segs;
  if(I.collar){
    if(bad([I.d1,I.l1,I.D2,I.l2])) return {error:'Fill in the Collar small OD, L small OD, large OD and L large OD with values greater than zero.'};
    if(I.d1>=I.D2) return {error:'In the Collar, the small OD must be smaller than the large OD.'};
    Dmaj=I.D2;Lmaj=I.l2;Ltot=I.l1+I.l2;segs=[{z0:0,z1:I.l1,r:I.d1/2},{z0:I.l1,z1:Ltot,r:I.D2/2}];
  }else{
    if(bad([I.D,I.L])) return {error:'Fill in the Feedstock OD and L with values greater than zero.'};
    Dmaj=I.D;Lmaj=I.L;Ltot=I.L;segs=[{z0:0,z1:Ltot,r:Dmaj/2}];
  }
  if(I.od>Dmaj+0.01) return {error:`The demanded OD (${Lu(I.od,1)}) cannot be larger than the Feedstock ${I.collar?'large ':''}OD (${Lu(Dmaj,1)}).`};
  if(tube){
    if(!(I.id>0)||I.id>=I.od) return {error:'For the Tube, enter an ID greater than zero and smaller than the OD.'};
    if(I.id-I.aI<=0) return {error:'The ID allowance is greater than or equal to the ID: the Collar small OD would be zero or negative.'};
  }
  const Lpc=I.len+I.aL; let used, dems, rings=[], off=null, dm=null, pl=null;
  if(tube) dm=I.id-I.aI;
  if(I.collar){
    pl=collarPlan(I,Lpc,tube,dm); if(pl.error) return {error:pl.error};
    used=pl.used; dems=pl.dems; rings=pl.rings; off=pl.off;
  }else{
    used=I.Q*Lpc;
    if(used>Lmaj+1e-6){
      const mx=Math.floor((Lmaj+1e-6)/Lpc), where='in the Feedstock rod';
      return {error:mx<1?`Not even one piece fits ${where}: the L with allowance (${Lu(Lpc,1)}) is greater than the available length (${Lu(Lmaj,1)}).`:`The ${I.Q} pieces (${Lu(Lpc,1)} each, with allowance) do not fit ${where}, which is ${Lu(Lmaj,1)}. <b>Maximum per rod: ${mx} pieces</b>. ${I.Q} pieces would need ${Math.ceil(I.Q/mx)} rods.`};
    }
    const rest=Lmaj-used, ok=rest>=1;
    dems=[{z0:0,z1:used,n:I.Q}];
    if(!tube){off=ok?{type:'rod',D:Dmaj,L:rest,parts:[{z0:used,z1:Ltot,r:Dmaj/2}]}:null}
    else{
      const parts=[{z0:0,z1:used,r:dm/2}];
      if(ok){parts.push({z0:used,z1:Ltot,r:Dmaj/2});off={type:'collar',d1:dm,l1:used,D2:Dmaj,l2:rest,parts}}
      else off={type:'rod',D:dm,L:used,parts};
    }
    if(Dmaj-I.od>0.01) rings.push({Do:Dmaj,Di:I.od,L:used,z0:0,z1:used});
  }
  rings.forEach(g=>g.kg=cylKg(g.Do,g.L,I.rho)-cylKg(I.od,g.L,I.rho));
  const ringX=ringAgg(rings,I.od); if(ringX) ringX.kg=rings.reduce((t,g)=>t+g.kg,0);
  if(off){
    off.kg=off.parts.reduce((s,p)=>s+cylKg(2*p.r,p.z1-p.z0,I.rho),0);
    off.vol=off.kg/I.rho;
    const m=matchDevRod(off); off.m=m; off.dev=m?m.dev:0;
  }
  const pieceKg=tube?cylKg(I.od,Lpc,I.rho)-cylKg(I.id,Lpc,I.rho):cylKg(I.od,Lpc,I.rho);
  const finKg=(tube?cylKg(I.od,I.len,I.rho)-cylKg(I.id,I.len,I.rho):cylKg(I.od,I.len,I.rho))*I.Q;
  const nomKg=segs.reduce((s,p)=>s+cylKg(2*p.r,p.z1-p.z0,I.rho),0);
  return {I,tube,segs,Dmaj,Lmaj,Ltot,Lpc,used,dems,pl,off,dm,ringX,pieceKg,finKg,nomKg};
}

/* ---- desenho 3D de rods (eixo do comprimento na horizontal) ---- */
function drawRod(cv,sc,view,o={}){
  const dpr=o.dpr||window.devicePixelRatio||1, W=cv.clientWidth, H=cv.clientHeight;
  if(!W||!H) return;
  if(cv.width!==Math.round(W*dpr)||cv.height!==Math.round(H*dpr)){cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr)}
  const c=cv.getContext('2d'); c.setTransform(dpr,0,0,dpr,0,0); c.clearRect(0,0,W,H);
  const Lt=sc.Ltot, Rm=sc.Rmax, Rf=sc.Rfit||Rm, diag=Math.hypot(Lt,2*Rf,2*Rf), pad=o.pad||54;
  const s=Math.min(W-2*pad,(H-2*pad)*1.7)/diag*1.05, cx=W/2, cy=H/2;
  const cy_=Math.cos(view.yaw),sy=Math.sin(view.yaw),cp=Math.cos(view.pitch),sp=Math.sin(view.pitch);
  const P=(x,y,z)=>{x-=Lt/2;const x1=x*cy_+z*sy,z1=-x*sy+z*cy_,y2=y*cp-z1*sp,z2=y*sp+z1*cp;return [cx+x1*s,cy-y2*s,z2]};
  const N=36, faces=[], A=k=>k/N*Math.PI*2;
  const ring=(z,r,a)=>P(z,r*Math.cos(a),r*Math.sin(a));
  const addCyl=p=>{
    const col=cssv(p.fill);
    for(let k=0;k<N;k++){
      const a0=A(k),a1=A(k+1);
      const push=pts=>faces.push({pts,z:pts.reduce((t,q)=>t+q[2],0)/pts.length,col,a:p.alpha});
      push([ring(p.z0,p.ro,a0),ring(p.z1,p.ro,a0),ring(p.z1,p.ro,a1),ring(p.z0,p.ro,a1)]);
      if(p.ri>0){
        push([ring(p.z0,p.ri,a0),ring(p.z1,p.ri,a0),ring(p.z1,p.ri,a1),ring(p.z0,p.ri,a1)]);
        [p.z0,p.z1].forEach(z=>push([ring(z,p.ri,a0),ring(z,p.ro,a0),ring(z,p.ro,a1),ring(z,p.ri,a1)]));
      }else [p.z0,p.z1].forEach(z=>push([P(z,0,0),ring(z,p.ro,a0),ring(z,p.ro,a1)]));
    }
  };
  sc.parts.forEach(addCyl);
  faces.sort((a,b)=>a.z-b.z);
  faces.forEach(f=>{c.globalAlpha=f.a;c.fillStyle=f.col;c.beginPath();f.pts.forEach((q,i)=>i?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1]));c.closePath();c.fill()});
  c.globalAlpha=1;
  const circle=(z,r,col,dash,lw)=>{c.strokeStyle=col;c.lineWidth=lw;c.setLineDash(dash);c.beginPath();for(let k=0;k<=N;k++){const q=ring(z,r,A(k));k?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1])}c.stroke();c.setLineDash([])};
  const line=(p,q,col,dash,lw)=>{c.strokeStyle=col;c.lineWidth=lw;c.setLineDash(dash);c.beginPath();c.moveTo(p[0],p[1]);c.lineTo(q[0],q[1]);c.stroke();c.setLineDash([])};
  sc.parts.forEach(p=>{
    const col=cssv(p.edge), dash=p.dash?[6,4]:[], lw=p.lw||1.5;
    if(p.seps){c.globalAlpha=.45;p.seps.forEach(z=>circle(z,p.ro,col,[2,4],1));c.globalAlpha=1}
    [p.z0,p.z1].forEach(z=>{circle(z,p.ro,col,dash,lw);if(p.ri>0)circle(z,p.ri,col,dash,lw)});
    for(let k=0;k<4;k++){const a=k*Math.PI/2;line(ring(p.z0,p.ro,a),ring(p.z1,p.ro,a),col,dash,lw);if(p.ri>0)line(ring(p.z0,p.ri,a),ring(p.z1,p.ri,a),col,dash,lw)}
  });
  c.font='500 12px '+cssv('--font-num');c.textAlign='center';c.textBaseline='middle';
  const ctr=P(Lt/2,0,0);
  (sc.labels||[]).forEach(l=>{const q=P(l.x,l.y,l.z);let dx=q[0]-ctr[0],dy=q[1]-ctr[1];const n=Math.hypot(dx,dy)||1;
    const tx=q[0]+dx/n*22,ty=q[1]+dy/n*16,tw=c.measureText(l.t).width+10;
    c.globalAlpha=.9;c.fillStyle=cssv('--surface');c.fillRect(tx-tw/2,ty-9,tw,18);c.globalAlpha=1;c.fillStyle=cssv('--fg');c.fillText(l.t,tx,ty)});
  (sc.cuts||[]).forEach(k=>{
    const R=Rm*1.22;
    c.beginPath();for(let q=0;q<=N;q++){const p=ring(k.z,R,A(q));q?c.lineTo(p[0],p[1]):c.moveTo(p[0],p[1])}c.closePath();
    c.globalAlpha=.14;c.fillStyle=cssv('--brand');c.fill();c.globalAlpha=1;
    c.strokeStyle=cssv('--brand');c.lineWidth=1.8;c.setLineDash([7,3]);c.stroke();c.setLineDash([]);
    {const Ra=R*(k.n%2?1:-1);cutArrow(c,P(k.z,Ra,0),P(k.z+k.dir*k.len,Ra,0),k.n)}
  });
}
function rScene(r){
  const parts=[];
  r.segs.forEach(g=>parts.push({z0:g.z0,z1:g.z1,ro:g.r,ri:0,fill:'--nominal',alpha:.07,edge:'--nominal',dash:false,lw:2}));
  if(r.off) r.off.parts.forEach(g=>parts.push({z0:g.z0,z1:g.z1,ro:g.r,ri:0,fill:'--off1',alpha:.34,edge:'--off1',dash:false,lw:1}));
  if(r.ringX) r.ringX.rings.forEach(g=>parts.push({z0:g.z0,z1:g.z1,ro:g.Do/2,ri:g.Di/2,fill:'--demand2',alpha:.22,edge:'--demand2',dash:true,lw:1.5}));
  r.dems.forEach(d=>{const seps=[];for(let k=1;k<d.n;k++)seps.push(d.z0+k*r.Lpc);
    parts.push({z0:d.z0,z1:d.z1,ro:r.I.od/2,ri:r.tube?r.I.id/2:0,fill:'--demand',alpha:.20,edge:'--demand',dash:true,lw:2,seps})});
  const Rm=Math.max(...r.segs.map(g=>g.r));
  return {Ltot:r.Ltot,Rmax:Rm,parts,labels:[{x:r.Ltot/2,y:-Rm,z:0,t:`L ${Lc(r.Ltot,0)}`},{x:r.Ltot,y:Rm,z:0,t:`ø ${Lc(2*Rm,0)}`}]};
}

function rPaint(){
  const r=state.rres; if(!r||r.error)return;
  const cv=$('rcv'); if(cv)drawRod(cv,rScene(r),rstate.view);
}
function rRender(){
  const kgP=rSidebar(); const r=rSolve(); state.rres=r;
  const main=$('rmain');
  if(r.error){main.innerHTML=`<div class="err" role="alert">${r.error}</div>`;dgUpdate('RD',null);return}
  const I=r.I, off=r.off, mat=RODPRICES[Math.min(rstate.mat,RODPRICES.length-1)];
  const label=r.tube?'Tube':'Rod';
  dgUpdate('RD',{od:I.od,L:r.used});
  const devOk=!off||(off.m&&!off.m.na);
  const ringKgX=r.ringX?r.ringX.kg:0;
  const loss=(off&&devOk?off.dev*off.kg:0)+ringKgX;
  const wP=r.pieceKg*I.Q, calcKg=wP+loss, lotCost=calcKg*mat.kg, pcCost=lotCost/I.Q;
  const money=n=>'$ '+nf(n,2);
  const pctn=(v)=>`<span class="pctnote">(${nf(calcKg?v/calcKg*100:0,1)}%)</span>`;
  const offDims=!off?'':off.type==='collar'
    ?`<dt>Small OD</dt><dd>${Lu(off.d1,1)}</dd><dt>L small OD</dt><dd>${Lu(off.l1,1)}</dd><dt>Large OD</dt><dd>${Lu(off.D2,1)}</dd><dt>L large OD</dt><dd>${Lu(off.l2,1)}</dd>${off.core?`<dt>Tube core</dt><dd>ø${Lc(off.core.d,1)} × ${Lu(off.core.l,1)}</dd>`:''}`
    :`<dt>OD</dt><dd>${Lu(off.D,1)}</dd><dt>L</dt><dd>${Lu(off.L,1)}</dd>`;
  const offKind=!off?'':off.type==='collar'?'Collar':'Rod';
  const lg=(col,txt,dash)=>`<span><i class="${dash?'dash':''}" style="border-color:var(${col});background:color-mix(in srgb,var(${col}) 35%,transparent)"></i>${txt}</span>`;
  main.innerHTML=`
  <div class="kpis">
    <div class="kpi" style="border-top:3px solid var(--demand)"><span class="l">L used</span><span class="v num">${Lu(r.used,1)}</span><span class="s">${I.Q} pcs × ${Lu(r.Lpc,1)} (with allowance) of ${I.collar?Lu(r.Ltot,1)+' (Collar total L)':Lu(r.Lmaj,1)}</span></div>
    <div class="kpi"><span class="l">Useful pieces / Feedstock</span><span class="v num">${nf(r.finKg/r.nomKg*100,1)}%</span><span class="s">${Wu(r.finKg,1)} of ${Wu(r.nomKg,1)}</span></div>
    <div class="kpi"><span class="l">Offall</span><span class="v num">${off?Wu(off.kg,1)+'':'no leftover'}</span><span class="s">${off?nf(off.kg/r.nomKg*100,1)+'% of Feedstock · '+offKind:'the cut consumes the whole rod'}</span></div>
  </div>

  <section class="card ori pl${PL.c?' collapsed':''}">
    <header class="orhead plhead" role="button" tabindex="0" aria-expanded="${!PL.c}"><h2 style="display:flex;align-items:center;gap:8px"><i class="chev" aria-hidden="true"></i>Placement in the Feedstock rod</h2>
      <div class="legend"><span><i style="border-color:var(--nominal);background:var(--nominal-fill)"></i>Feedstock${I.collar?' (Collar)':''}</span>${lg('--demand',`Demanded ${label} (with allowance, split piece by piece)`,true)}${off?lg('--off1','Offall 1'):''}${r.ringX?lg('--demand2','Excess OD stock (machined away, 100% loss)',true):''}</div></header>
    <div class="stage" id="rstage"><canvas id="rcv" aria-label="3D drawing of the Feedstock rod, the demand and the Offall"></canvas><span class="hint">drag to rotate</span></div>
  </section>

  <section>
    <div class="offs" id="roffs">${off?`
      <article class="off" style="--c:var(--off1)">
        <h3><span>Offall 1 · ${offKind}</span>${devOk&&off.m?`<span class="pill ${classOf(off.dev)}">${pct(off.dev)}</span>`:`<span class="note">${off.m?'no table row':'depreciation pending'}</span>`}</h3>
        <dl class="dl num">${offDims}<dt>Volume</dt><dd>${Vu(off.vol)}</dd></dl>
        <div class="weight num"><small>P = V × D</small><span>${Wu(off.kg,1)}</span></div>
      </article>`:`<div class="note">There is no Offall: the cut consumes the whole rod length.</div>`}
    ${r.ringX?`<p class="note" style="margin:8px 0 0">${ringNote(label,I,r.ringX)}</p>`:''}${cutNote(r)}</div>
    ${off&&off.type==='collar'?'<p class="note" style="margin:8px 0 0">Collar: starts with the small OD for L small OD and returns to the large OD for L large OD; the sum of the two lengths is the rod length.</p>':''}
  </section>

  <section class="card">
    <header style="flex-wrap:wrap"><h2>Devaluation</h2><span style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-left:auto;justify-content:flex-end">${devSeg('r')}<span class="tag">Rules – Rods</span></span></header>
    ${off&&off.m&&off.m.na?'<div class="body"><div class="sample">'+off.m.info+'. No applicable row in the "Rules - Rods" tab: the Offall shows no depreciation and the cost does not add depreciated weight.</div></div>':''}
    <div class="body"><p class="note" style="margin:0">Spreadsheet Devaluation_v7.xlsx, tab "Rules_Rods": the row is chosen by the Offall OD (exact ±0.02", otherwise the OD immediately below; above 24" the 24" row; below 2" no rule, no depreciation). The column is the length band = L(offall) ÷ L(original ${RODPRICES[Math.min(rstate.mat,RODPRICES.length-1)].L}") : ≥ 80% | 60–80% | 40–60% | 20–40% | &lt; 20%. Each cell is the Offall value in $/${MUl()}. Depreciation = (price of the material selected in Costing − Offall value) ÷ material price, limited to 0%–100%. Collar (tab "Rules_Collars"): split into its large-OD and small-OD segments; each is valued with its own OD and L (Rods table up to 24", Rounds table above) and the Offall value is the sum weighted by segment volume (OD² × L). Bands 2–4 are provisional prices in the spreadsheet.</p></div>
    ${off||r.ringX?`<div class="tablewrap"><table>
      <thead><tr><th>Block</th><th>Dimensions (${LUl()})</th><th class="r">Weight</th><th>Rule applied</th><th class="r">Depreciation</th><th class="r">${DVH()}</th></tr></thead>
      <tbody>${off?`<tr><td><b style="color:var(--off1)">Offall 1</b></td><td class="num">${off.type==='collar'?`ø${Lc(off.d1,1)} × ${Lc(off.l1,1)} + ø${Lc(off.D2,1)} × ${Lc(off.l2,1)}${off.core?` + core ø${Lc(off.core.d,1)} × ${Lc(off.core.l,1)}`:''}`:`ø${Lc(off.D,1)} × ${Lc(off.L,1)}`}</td><td class="r num">${Wu(off.kg,1)}</td><td class="note">${off.m?off.m.info:'awaiting rules'}</td><td class="r num">${devOk?pct(off.dev):'—'}</td><td class="r num">${devOk?DV(off.dev*off.kg,'RD'):'—'}</td></tr>`:''}${r.ringX?`<tr><td><b style="color:var(--demand2)">Excess OD stock</b></td><td class="num">${ringTxt(r.ringX)}</td><td class="r num">${Wu(r.ringX.kg,1)}</td><td class="note">100% machined away</td><td class="r num">${pct(1)}</td><td class="r num">${DV(r.ringX.kg,'RD')}</td></tr>`:''}</tbody>
      <tfoot><tr><td>Total</td><td></td><td></td><td>${DEV$?'Total amount devalued':'Weighted depreciated weight'}</td><td></td><td class="r num">${DV(loss,'RD')}</td></tr></tfoot>
    </table></div>`:'<div class="body note">No Offall to depreciate.</div>'}
  </section>

  <section class="card">
    <header><h2>Material Cost</h2>${omChk('rods')}<span class="tag">Price list Oct26 · Extruded rods</span></header>
    <div class="cost">
      <div class="in">
        ${omSt('rods').on?omHTML('rods',['']):`
        <div class="field"><label for="rmat">Material · grade and size</label>
          <select id="rmat">${RODPRICES.map((p,i)=>`<option value="${i}" ${i===rstate.mat?'selected':''}>${p.name} ($ ${nf(PP(p.kg),2)}/${MUl()})</option>`).join('')}</select></div>
        ${matLow('RD')}${matCard('RD')}${xcHTML('rods')}
        <dl class="dl num">
          <dt>${label} · ${Wu(r.pieceKg,2)} × ${I.Q} pcs</dt><dd>${Wu(wP,2)} ${pctn(wP)}</dd>
          <dt>+ Weighted depreciated weight</dt><dd>${off&&!devOk&&!ringKgX?'— <span class="pctnote">(no table row)</span>':Wu(loss,2)+' '+pctn(loss)+(off&&!devOk?' <span class="pctnote">(excess OD stock only; Offall has no table row)</span>':'')}</dd>
          <dt><b>Total calculation weight</b></dt><dd><b>${Wu(calcKg,2)}</b></dd>
          <dt>Cost per ${MUl()}</dt><dd>$ ${nf(PP(mat.kg),2)}/${MUl()}</dd>
          <dt>Lot cost</dt><dd>${money(lotCost)}</dd>
          <dt><b>Piece cost</b></dt><dd><b>${money(pcCost)}</b> /pc</dd>
          <dt><b>Piece cost + Extra cost</b></dt><dd><b data-pcx="r">—</b> /pc</dd>
        </dl>
        <p class="memo num">${devOk?'Total weight × cost per '+MUl()+' ÷ '+I.Q+' pcs':'No depreciated weight (no table row) · ÷ '+I.Q+' pcs'}</p>
        `}
        ${omSt('rods').on?'':mchHTML('r')}
      </div>
      <div class="final"><div class="fin mfin" data-k="r"></div>${pafBtn('rods','r')}</div>
    </div>
  </section>`;
  omInit();
  if($('rmat'))$('rmat').onchange=e=>{rstate.mat=+e.target.value;rRender()}; window.__MCHP=window.__MCHP||{};mcSet('rods','r',omPrice('rods',0,pcCost));xcShow('rods');matBind(); mchBind('r');
  rPaint();
  const st=$('rstage'); let drag=null;
  st.onpointerdown=e=>{drag=[e.clientX,e.clientY];st.setPointerCapture(e.pointerId)};
  st.onpointermove=e=>{if(!drag)return;rstate.view.yaw+=(e.clientX-drag[0])*0.008;rstate.view.pitch=Math.max(-1.4,Math.min(1.4,rstate.view.pitch+(e.clientY-drag[1])*0.008));drag=[e.clientX,e.clientY];rPaint()};
  st.onpointerup=st.onpointercancel=()=>{drag=null};
}
document.querySelectorAll('#tab-rods .side input').forEach(i=>i.addEventListener('input',()=>rRender()));

/* =================== ROUNDS =================== */
/* 2026 Ei6 Machining price list_detail_Oct26.xlsx, aba "2026 Master Price List": coluna "Nominal Size" e "Price Per lb" (só itens com preço). Seção "PDF-N Molded Rounds". kg = $/lb ÷ 0,45359237. */
const ROUNDPRICES=__D.prices_rounds;

/* Rounds: Devaluation_v7.xlsx, aba Rules_Rounds (rule 0: OD ≤ 24" follows the Rods table; rules 1–2 by absolute L; L ≥ 4" table by OD and length band). */
const ROUND_RULES_READY=true;
function matchDevRound(off){
  const D=off.type==='collar'?1:off.D; if(off.type!=='collar'&&!(D>0)) return null;
  const m=ROUNDPRICES[Math.min(qstate.mat,ROUNDPRICES.length-1)];
  return valueV7(off,m.kg,m.L,false);
}
const qstate={mat:0,price:'',view:{yaw:-0.55,pitch:0.38}};
function qRead(){
  const g=gv;
  return {collar:$('qCollar').checked,core:$('qCore').checked,mode:document.querySelector('input[name=qmode]:checked').value,D:g('qD'),L:g('qL'),d1:g('qD1'),l1:g('qL1'),D2:g('qD2'),l2:g('qL2'),rho:g('qDens'),
    od:g('qdOD'),id:g('qdID'),len:g('qdL'),Q:Math.round(g('qQty')),aI:g('qaID')||0,aL:g('qaL')||0};
}
const ringKg=(Do,Di,l,rho)=>cylKg(Do,l,rho)-cylKg(Di,l,rho);
function qSidebar(){
  const I=qRead(), tube=I.mode==='tube';
  $('qdIDf').hidden=!tube; $('qaIDf').hidden=!tube; $('qCoreL').hidden=!tube;
  $('qPlain').hidden=I.collar; $('qCollarF').hidden=!I.collar;
  const nomKg=I.collar?(I.d1>0&&I.l1>0&&I.D2>0&&I.l2>0&&I.rho>0?cylKg(I.d1,I.l1,I.rho)+cylKg(I.D2,I.l2,I.rho):null):(I.D>0&&I.L>0&&I.rho>0?cylKg(I.D,I.L,I.rho):null);
  $('qnomw').innerHTML=nomKg==null?'':(I.collar?`<dt>Total L</dt><dd>${Lu(I.l1+I.l2,1)}</dd>`:'')+`<dt>Total weight</dt><dd><b>${Wu(nomKg,1)}</b></dd>`;
  const el=$('qpcw');
  if(!(I.od>0&&I.len>0&&I.Q>0&&I.rho>0&&(!tube||(I.id>0&&I.id<I.od)))){el.innerHTML='';return}
  const Lpc=I.len+I.aL, kg=tube?ringKg(I.od,I.id,Lpc,I.rho):cylKg(I.od,Lpc,I.rho);
  const mx=I.collar?Math.floor(((I.od<=I.d1+0.01?I.l1+I.l2:I.l2)+1e-6)/Lpc):(I.L>0?Math.floor((I.L+1e-6)/Lpc):null);
  el.innerHTML=`<dt>L with allowance</dt><dd>${Lu(Lpc,1)}</dd><dt>Weight per piece</dt><dd>${Wu(kg,2)}</dd><dt>Total (${I.Q} pcs)</dt><dd><b>${Wu(kg*I.Q,2)}</b></dd>`+(mx!=null?`<dt>Max per Feedstock round</dt><dd>${nf(mx)} pcs</dd>`:'');
}
function qSolve(){
  const I=qRead(), tube=I.mode==='tube', bad=a=>a.some(x=>!(x>0));
  if(bad([I.rho,I.od,I.len,I.Q])) return {error:'Fill in OD, L, quantity and density with values greater than zero.'};
  let Dmaj,Lmaj,Ltot,segs;
  if(I.collar){
    if(bad([I.d1,I.l1,I.D2,I.l2])) return {error:'Fill in the Collar small OD, L small OD, large OD and L large OD with values greater than zero.'};
    if(I.d1>=I.D2) return {error:'In the Collar, the small OD must be smaller than the large OD.'};
    Dmaj=I.D2;Lmaj=I.l2;Ltot=I.l1+I.l2;segs=[{z0:0,z1:I.l1,r:I.d1/2},{z0:I.l1,z1:Ltot,r:I.D2/2}];
  }else{
    if(bad([I.D,I.L])) return {error:'Fill in OD, L, quantity and density with values greater than zero.'};
    Dmaj=I.D;Lmaj=I.L;Ltot=I.L;segs=[{z0:0,z1:Ltot,r:Dmaj/2}];
  }
  if(I.od>Dmaj+0.01) return {error:`The demanded OD (${Lu(I.od,1)}) cannot be larger than the Feedstock ${I.collar?'large ':''}OD (${Lu(Dmaj,1)}).`};
  if(tube){
    if(!(I.id>0)||I.id>=I.od) return {error:'For the Tube, enter an ID greater than zero and smaller than the OD.'};
    if(I.id-I.aI<=0) return {error:'The ID allowance is greater than or equal to the ID: the core (Offall) would have zero or negative ø.'};
  }
  const Lpc=I.len+I.aL, dm=tube?I.id-I.aI:null; let used, dems, rings=[], offs=[], pl=null;
  if(I.collar){
    pl=collarPlan(I,Lpc,tube,dm,tube&&I.core); if(pl.error) return {error:pl.error};
    used=pl.used; dems=pl.dems; rings=pl.rings; if(pl.coreOff) offs.push(pl.coreOff); if(pl.off) offs.push(pl.off);
  }else{
    used=I.Q*Lpc;
    if(used>Lmaj+1e-6){
      const mx=Math.floor((Lmaj+1e-6)/Lpc);
      return {error:mx<1?`Not even one piece fits in the Feedstock round: the L with allowance (${Lu(Lpc,1)}) is greater than the available L (${Lu(Lmaj,1)}).`:`The ${I.Q} pieces (${Lu(Lpc,1)} each, with allowance) do not fit in the Feedstock round, which is ${Lu(Lmaj,1)}. <b>Maximum per round: ${mx} pieces</b>. ${I.Q} pieces would need ${Math.ceil(I.Q/mx)} rounds.`};
    }
    const rest=Lmaj-used, ok=rest>=1;
    dems=[{z0:0,z1:used,n:I.Q}];
    if(tube&&I.core){
      offs.push({type:'core',D:dm,L:used,parts:[{z0:0,z1:used,r:dm/2}]});
      if(ok) offs.push({type:'round',D:I.D,L:rest,parts:[{z0:used,z1:I.L,r:I.D/2}]});
    }else if(tube){
      const core={z0:0,z1:used,r:dm/2};
      if(ok) offs.push({type:'collar',d1:dm,l1:used,D2:I.D,l2:rest,parts:[core,{z0:used,z1:I.L,r:I.D/2}]});
      else offs.push({type:'core',D:dm,L:used,parts:[core]});
    }else if(ok) offs.push({type:'round',D:I.D,L:rest,parts:[{z0:used,z1:I.L,r:I.D/2}]});
    if(Dmaj-I.od>0.01) rings.push({Do:Dmaj,Di:I.od,L:used,z0:0,z1:used});
  }
  offs.forEach(o=>{if(o.type==='rod')o.type='round'});
  rings.forEach(g=>g.kg=cylKg(g.Do,g.L,I.rho)-cylKg(I.od,g.L,I.rho));
  const ringX=ringAgg(rings,I.od); if(ringX) ringX.kg=rings.reduce((t,g)=>t+g.kg,0);
  offs.forEach(o=>{
    o.kg=o.parts.reduce((s,p)=>s+(p.ri?ringKg(2*p.r,2*p.ri,p.z1-p.z0,I.rho):cylKg(2*p.r,p.z1-p.z0,I.rho)),0);
    o.vol=o.kg/I.rho; o.m=matchDevRound(o); o.dev=o.m?o.m.dev:0;
  });
  const one=l=>tube?ringKg(I.od,I.id,l,I.rho):cylKg(I.od,l,I.rho);
  const nomKg=segs.reduce((s,p)=>s+cylKg(2*p.r,p.z1-p.z0,I.rho),0);
  return {I,tube,Dmaj,Lmaj,Ltot,segs,dems,pl,Lpc,used,dm,offs,ringX,pieceKg:one(Lpc),finKg:one(I.len)*I.Q,nomKg};
}
function qScene(r){
  const I=r.I, parts=r.segs.map(g=>({z0:g.z0,z1:g.z1,ro:g.r,ri:0,fill:'--nominal',alpha:.07,edge:'--nominal',dash:false,lw:2}));
  r.offs.forEach((o,i)=>o.parts.forEach(g=>parts.push({z0:g.z0,z1:g.z1,ro:g.r,ri:g.ri||0,fill:'--off'+(i+1),alpha:.34,edge:'--off'+(i+1),dash:false,lw:1})));
  if(r.ringX) r.ringX.rings.forEach(g=>parts.push({z0:g.z0,z1:g.z1,ro:g.Do/2,ri:g.Di/2,fill:'--demand2',alpha:.22,edge:'--demand2',dash:true,lw:1.5}));
  r.dems.forEach(d=>{const seps=[];for(let k=1;k<d.n;k++)seps.push(d.z0+k*r.Lpc);
    parts.push({z0:d.z0,z1:d.z1,ro:I.od/2,ri:r.tube?I.id/2:0,fill:'--demand',alpha:.20,edge:'--demand',dash:true,lw:2,seps})});
  return {Ltot:r.Ltot,Rmax:r.Dmaj/2,parts,labels:[{x:r.Ltot/2,y:-r.Dmaj/2,z:0,t:`L ${Lc(r.Ltot,0)}`},{x:r.Ltot,y:r.Dmaj/2,z:0,t:`ø ${Lc(r.Dmaj,0)}`}]};
}
function qPaint(){const r=state.qres; if(!r||r.error)return; const cv=$('qcv'); if(cv)drawRod(cv,qScene(r),qstate.view)}
function qRender(){
  qSidebar(); const r=qSolve(); state.qres=r;
  const main=$('qmain');
  if(r.error){main.innerHTML=`<div class="err" role="alert">${r.error}</div>`;dgUpdate('RN',null);return}
  const I=r.I, offs=r.offs, label=r.tube?'Tube':'Round';
  dgUpdate('RN',{od:I.od,L:r.used});
  const kindOf={round:'Round',collar:'Collar',ring:'Ring',core:'Core'};
  const dimsOf=o=>o.type==='collar'?`ø${Lc(o.d1,1)} × ${Lc(o.l1,1)} + ø${Lc(o.D2,1)} × ${Lc(o.l2,1)}`:o.type==='ring'?`OD ${Lc(o.Do,1)} · ID ${Lc(o.Di,1)} × ${Lc(o.L,1)}`:`ø${Lc(o.D,1)} × ${Lc(o.L,1)}`;
  const devOk=ROUND_RULES_READY&&offs.every(o=>o.m&&!o.m.na), naMsg=(offs.find(o=>o.m&&o.m.na)||{m:{}}).m.info;
  const ringKgX=r.ringX?r.ringX.kg:0, loss=(devOk?offs.reduce((s,o)=>s+o.dev*o.kg,0):0)+ringKgX, offKg=offs.reduce((s,o)=>s+o.kg,0);
  const wP=r.pieceKg*I.Q, calcKg=wP+loss;
  const lg=(col,txt,dash)=>`<span><i class="${dash?'dash':''}" style="border-color:var(${col});background:color-mix(in srgb,var(${col}) 35%,transparent)"></i>${txt}</span>`;
  const pctn=v=>`<span class="pctnote">(${nf(calcKg?v/calcKg*100:0,1)}%)</span>`;
  const offCard=(o,i)=>`<article class="off" style="--c:var(--off${i+1})">
      <h3><span>Offall ${i+1} · ${kindOf[o.type]}</span>${o.m&&!o.m.na?`<span class="pill ${classOf(o.dev)}">${pct(o.dev)}</span>`:'<span class="note">no table row</span>'}</h3>
      <dl class="dl num">${o.type==='collar'?`<dt>Small OD</dt><dd>${Lu(o.d1,1)}</dd><dt>L small OD</dt><dd>${Lu(o.l1,1)}</dd><dt>Large OD</dt><dd>${Lu(o.D2,1)}</dd><dt>L large OD</dt><dd>${Lu(o.l2,1)}</dd>`:o.type==='ring'?`<dt>OD</dt><dd>${Lu(o.Do,1)}</dd><dt>ID</dt><dd>${Lu(o.Di,1)}</dd><dt>L</dt><dd>${Lu(o.L,1)}</dd>`:`<dt>OD</dt><dd>${Lu(o.D,1)}</dd><dt>L</dt><dd>${Lu(o.L,1)}</dd>`}<dt>Volume</dt><dd>${Vu(o.vol)}</dd></dl>
      <div class="weight num"><small>P = V × D</small><span>${Wu(o.kg,1)}</span></div></article>`;
  main.innerHTML=`
  <div class="kpis">
    <div class="kpi" style="border-top:3px solid var(--demand)"><span class="l">L used</span><span class="v num">${Lu(r.used,1)}</span><span class="s">${I.Q} pcs × ${Lu(r.Lpc,1)} (with allowance) of ${I.collar?Lu(r.Ltot,1)+' (Collar total L)':Lu(r.Lmaj,1)}</span></div>
    <div class="kpi"><span class="l">Useful pieces / Feedstock</span><span class="v num">${nf(r.finKg/r.nomKg*100,1)}%</span><span class="s">${Wu(r.finKg,1)} of ${Wu(r.nomKg,1)}</span></div>
    <div class="kpi"><span class="l">Offall</span><span class="v num">${offs.length?Wu(offKg,1)+'':'no leftover'}</span><span class="s">${offs.length?nf(offKg/r.nomKg*100,1)+'% of Feedstock · '+offs.length+' Offall'+(offs.length>1?'s':''):'the cut consumes the whole round'}</span></div>
  </div>
  <section class="card ori pl${PL.c?' collapsed':''}">
    <header class="orhead plhead" role="button" tabindex="0" aria-expanded="${!PL.c}"><h2 style="display:flex;align-items:center;gap:8px"><i class="chev" aria-hidden="true"></i>Placement in the Feedstock round</h2>
      <div class="legend"><span><i style="border-color:var(--nominal);background:var(--nominal-fill)"></i>Feedstock</span>${lg('--demand',`Demanded ${label} (with allowance, split piece by piece)`,true)}${offs.map((o,i)=>lg('--off'+(i+1),'Offall '+(i+1))).join('')}${r.ringX?lg('--demand2','Excess OD stock (machined away, 100% loss)',true):''}</div></header>
    <div class="stage" id="qstage"><canvas id="qcv" aria-label="3D drawing of the Feedstock round, the demand and the Offalls"></canvas><span class="hint">drag to rotate</span></div>
  </section>
  <section><div class="offs">${offs.length?offs.map(offCard).join(''):'<div class="note">There is no Offall: the cut consumes the whole round.</div>'}</div>
    ${r.ringX?`<p class="note" style="margin:8px 0 0">${ringNote(label,I,r.ringX)}</p>`:''}${cutNote(r)}
    ${offs.some(o=>o.type==='collar')?'<p class="note" style="margin:8px 0 0">Collar Offall: small OD for L small OD, then the large OD for L large OD. Depreciation uses only the small OD and the total L (L small OD + L large OD).</p>':''}
    ${r.tube?`<p class="note" style="margin:8px 0 0">Offall OD (${Lu(r.dm,1)}) + allowance (${Lu(I.aI,1)}) = Tube ID (${Lu(I.id,1)}).</p>`:''}</section>
  <section class="card">
    <header style="flex-wrap:wrap"><h2>Devaluation</h2><span style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-left:auto;justify-content:flex-end">${devSeg('q')}<span class="tag">Rules – Rounds</span></span></header>
    ${naMsg?`<div class="body"><div class="sample">${naMsg}. No applicable row in the "Rules - Rounds" tab: the Offall shows no depreciation and the cost does not add its depreciated weight.</div></div>`:''}
    <div class="body"><p class="note" style="margin:0">Spreadsheet Devaluation_v7.xlsx, tab "Rules_Rounds": Offall with OD ≤ 24" follows the Rods table (Rules_Rods). Above 24": L &lt; 1" → $ 0/${MUl()}; 1" ≤ L &lt; 4" → $ ${nf(PP(0.9072*LB2KG),2)}/${MUl()}; L ≥ 4" → table by OD (row exact ±0.02" or the OD immediately below; above 60" the 60" row) and length band = L(offall) ÷ L(original ${ROUNDPRICES[Math.min(qstate.mat,ROUNDPRICES.length-1)].L}"). Collar Offall (tab "Rules_Collars"): each OD segment is valued separately and weighted by volume. Bands 2–4 are provisional prices in the spreadsheet. Depreciation = (price of the material selected in Costing − Offall value) ÷ material price, limited to 0%–100%.</p></div>
    ${offs.length||r.ringX?`<div class="tablewrap"><table>
      <thead><tr><th>Offall</th><th>Dimensions (${LUl()})</th><th class="r">Weight</th><th>Rule applied</th><th class="r">Depreciation</th><th class="r">${DVH()}</th></tr></thead>
      <tbody>${offs.map((o,i)=>`<tr><td><b style="color:var(--off${i+1})">Offall ${i+1}</b></td><td class="num">${dimsOf(o)}</td><td class="r num">${Wu(o.kg,1)}</td><td class="note">${o.m?o.m.info:''}</td><td class="r num">${o.m&&!o.m.na?pct(o.dev):'—'}</td><td class="r num">${o.m&&!o.m.na?DV(o.dev*o.kg,'RN'):'—'}</td></tr>`).join('')}${r.ringX?`<tr><td><b style="color:var(--demand2)">Excess OD stock</b></td><td class="num">${ringTxt(r.ringX)}</td><td class="r num">${Wu(r.ringX.kg,1)}</td><td class="note">100% machined away</td><td class="r num">${pct(1)}</td><td class="r num">${DV(r.ringX.kg,'RN')}</td></tr>`:''}</tbody>
      <tfoot><tr><td>Total</td><td></td><td></td><td>${DEV$?'Total amount devalued':'Weighted depreciated weight'}</td><td></td><td class="r num">${DV(loss,'RN')}</td></tr></tfoot>
    </table></div>`:''}
  </section>
  <section class="card">
    <header><h2>Material Cost</h2>${omChk('rounds')}<span class="tag">Price list Oct26 · PDF-N Molded Rounds</span></header>
    <div class="cost">
      <div class="in">
        ${omSt('rounds').on?omHTML('rounds',['']):`
        ${ROUNDPRICES.length?`<div class="field"><label for="qmat">Material · grade and size</label><select id="qmat">${ROUNDPRICES.map((p,i)=>`<option value="${i}" ${i===qstate.mat?'selected':''}>${p.name} ($ ${nf(PP(p.kg),2)}/${MUl()})</option>`).join('')}</select></div>${matLow('RN')}${matCard('RN')}${xcHTML('rounds')}`
        :`<div class="field"><label for="qprice">Cost per kg · Price $/kg</label><div class="inp"><input id="qprice" type="number" min="0" step="any" value="${qstate.price}" placeholder="awaiting price list"><span>$/kg</span></div></div>`}
        <dl class="dl num">
          <dt>${label} · ${Wu(r.pieceKg,2)} × ${I.Q} pcs</dt><dd>${Wu(wP,2)} ${pctn(wP)}</dd>
          <dt>+ Weighted depreciated weight</dt><dd>${Wu(loss,2)} ${pctn(loss)}${naMsg?' <span class="pctnote">(Offall has no table row)</span>':''}</dd>
          <dt><b>Total calculation weight</b></dt><dd><b>${Wu(calcKg,2)}</b></dd>
          <dt>Cost per ${MUl()}</dt><dd>$ ${nf(PP(ROUNDPRICES[Math.min(qstate.mat,ROUNDPRICES.length-1)].kg),2)}/${MUl()}</dd>
          <dt>Lot cost</dt><dd id="qlot"></dd>
          <dt><b>Piece cost</b></dt><dd><b id="qpc">—</b> /pc</dd>
          <dt><b>Piece cost + Extra cost</b></dt><dd><b data-pcx="q">—</b> /pc</dd>
        </dl>
        <p class="memo num">Total weight × cost per ${MUl()} ÷ ${I.Q} pcs</p>
        `}
        ${omSt('rounds').on?'':mchHTML('q')}
      </div>
      <div class="final"><div class="fin mfin" data-k="q"></div>${pafBtn('rounds','q')}</div>
    </div>
  </section>`;
  const cost=()=>{
    const kg=ROUNDPRICES.length?ROUNDPRICES[Math.min(qstate.mat,ROUNDPRICES.length-1)].kg:parseFloat(qstate.price);
    const has=kg>=0&&isFinite(kg);
    if($('qlot')){$('qlot').textContent=has?'$ '+nf(calcKg*kg,2):'—'; $('qpc').textContent=has?'$ '+nf(calcKg*kg/I.Q,2):'—'} mcSet('rounds','q',omPrice('rounds',0,has?calcKg*kg/I.Q:NaN));xcShow('rounds'); if(window.mchFin)mchFin('q');
  };
  cost();
  omInit();
  if($('qmat'))$('qmat').onchange=e=>{qstate.mat=+e.target.value;qRender()}; matBind(); mchBind('q');
  if($('qprice'))$('qprice').oninput=e=>{qstate.price=e.target.value;cost()};
  qPaint();
  const st=$('qstage'); let drag=null;
  st.onpointerdown=e=>{drag=[e.clientX,e.clientY];st.setPointerCapture(e.pointerId)};
  st.onpointermove=e=>{if(!drag)return;qstate.view.yaw+=(e.clientX-drag[0])*0.008;qstate.view.pitch=Math.max(-1.4,Math.min(1.4,qstate.view.pitch+(e.clientY-drag[1])*0.008));drag=[e.clientX,e.clientY];qPaint()};
  st.onpointerup=st.onpointercancel=()=>{drag=null};
}
document.querySelectorAll('#tab-rounds .side input').forEach(i=>i.addEventListener('input',()=>qRender()));
qRender();

/* =================== UNIDADES (métrico / americano) =================== */
document.querySelectorAll('.inp').forEach(w=>{
  const i=w.querySelector('input'),sp=w.querySelector('span'); if(!i||!sp||!i.id)return;
  const u=sp.textContent.trim();
  if(u==='mm'||u==='kg/m³'){UK[i.id]=u==='mm'?'len':'dens';i.dataset.base=i.value;i.dataset.min=i.getAttribute('min')||'';sp.dataset.u0=u}
});
document.addEventListener('input',e=>{const el=e.target; if(el&&UK[el.id]){let v=parseFloat(el.value);if(UNIT.us)v*=UK[el.id]==='len'?25.4:DENS_F;el.dataset.base=isNaN(v)?'':String(v);el.dataset.shown=el.value}});
function setUnits(us,silent){
  UNIT.us=!!us;
  Object.keys(UK).forEach(id=>{
    const el=$(id), sp=el.closest('.inp').querySelector('span'), len=UK[id]==='len', f=len?25.4:DENS_F, b=parseFloat(el.dataset.base);
    if(!isNaN(b)) el.value=String(+((UNIT.us?b/f:b).toFixed(len?3:5)));
    el.dataset.shown=el.value;
    sp.textContent=UNIT.us?(len?'in':'lb/in³'):sp.dataset.u0;
    if(UNIT.us)el.setAttribute('min','0'); else if(el.dataset.min)el.setAttribute('min',el.dataset.min);
  });
  $('u-metric').setAttribute('aria-pressed',String(!UNIT.us)); $('u-us').setAttribute('aria-pressed',String(UNIT.us));
  try{localStorage.setItem('rmc-units',UNIT.us?'us':'metric')}catch(e){}
  if(!silent){state.sel=0;render();rRender();qRender()}
}
$('u-metric').onclick=()=>setUnits(false);
$('u-us').onclick=()=>setUnits(true);
let _u=null; try{_u=localStorage.getItem('rmc-units')}catch(e){}
if(_u==='us') setUnits(true,true);

/* ---- Costing for PAF: the selected price-list item as a draggable card (dimensions + density from TL weight) ---- */
function matSrc(cat){return ({BL:()=>PRICES[Math.min(state.mat,PRICES.length-1)],RD:()=>RODPRICES[Math.min(rstate.mat,RODPRICES.length-1)],RN:()=>ROUNDPRICES[Math.min(qstate.mat,ROUNDPRICES.length-1)]})[cat]()}
function matVolIn3(m){return m.d.length===3?m.d[0]*m.d[1]*m.d[2]:Math.PI/4*m.d[0]*m.d[0]*m.d[1]}
function matDens(m){return m&&m.w&&m.d?m.w/matVolIn3(m)*DENS_F:null}          // lb / in³ → kg/m³
var DEV$=false;
function DV(kgW,cat){return DEV$?'$ '+nf(kgW*matSrc(cat).kg,2):Wu(kgW,2)}
function DVH(){return DEV$?'$ amount':'Weighted weight'}
function devSeg(id){return `<div class="seg devseg" role="radiogroup" aria-label="Last column"><label><input type="radio" name="devm-${id}" value="w" ${DEV$?'':'checked'}>Weight</label><label><input type="radio" name="devm-${id}" value="$" ${DEV$?'checked':''}>$ amount</label></div>`}
document.addEventListener('change',e=>{const t=e.target;if(t&&t.name&&t.name.startsWith('devm-')){DEV$=t.value==='$';({blocks:render,rods:rRender,rounds:qRender})[rTab()]()}});
/* ---- Machining cost (second component of the piece cost): $/hour, machining steps (set up + time per piece) and cost per piece for 5 quantities ---- */
function xcSt(k){const X=(window.__XC=window.__XC||{});return X[k]||(X[k]=[{t:'',c:''}])}
function xcOn(k){xcSt(k);return !!window.__XC[k+'_on']}
function xcTotal(k){return !xcOn(k)?0:xcSt(k).reduce((t,r)=>t+(parseFloat(r.c)||0),0)}
function xcHTML(k){return `<div class="xc" data-xk="${k}"><h3>Extra cost<label class="tg out" title="Include extra cost"><input type="checkbox" data-xon="${k}" aria-label="Include extra cost" ${xcOn(k)?'checked':''}></label><span class="xct num"></span></h3><table class="steps" ${xcOn(k)?'':'hidden'}><thead><tr><th>Extra cost</th><th class="r">Cost per piece ($/pc)</th><th></th></tr></thead><tbody>${xcBody(k)}</tbody></table></div>`}
function xcBody(k){const R=xcSt(k);return R.map((r,i)=>`<tr data-i="${i}"><td><select data-xc="t" data-i="${i}"><option value="">Select…</option>${['LoOx','Purification'].map(x=>`<option ${r.t===x?'selected':''}>${x}</option>`).join('')}</select></td><td><input data-xc="c" data-i="${i}" type="number" min="0" step="any" value="${r.c}" class="r" placeholder="0.00"></td><td class="act">${R.length>1?'<button type="button" class="del" title="Remove this extra cost" aria-label="Remove extra cost">×</button> ':''}<button type="button" class="add" title="Add another extra cost" aria-label="Add extra cost" ${i===R.length-1&&R.length<2&&r.t!==''&&r.c!==''?'':'hidden'}>+</button></td></tr>`).join('')}
function xcPush(k){omKeys(k).forEach(key=>{const P=(window.__MCHP||{})[key];if(P&&P[0]){P[0].c=P[0].b+(omSt(k).on?0:xcTotal(k));mchFin(key)}});xcShow(k)}
function xcShow(k){document.querySelectorAll('[data-pcx]').forEach(e=>{const on=xcOn(k),dd=e.closest('dd'),dt=dd&&dd.previousElementSibling;if(e.closest('.card')&&e.closest('.cost')&&e.closest('.card').querySelector(`.xc[data-xk="${k}"]`)){if(dd)dd.hidden=!on;if(dt)dt.hidden=!on}const P=(window.__MCHP||{})[e.dataset.pcx],v=P&&P[0]?P[0].c:NaN;if(e.closest('.card')&&e.closest('.cost')&&e.closest('.card').querySelector(`.xc[data-xk="${k}"]`))e.textContent=isFinite(v)?'$ '+nf(v,2):'—'});const el=document.querySelector(`.xc[data-xk="${k}"] .xct`);if(el){const v=xcTotal(k);el.textContent=v>0?'$ '+nf(v,2)+' /pc':''}}
function mcSet(tab,key,base){(window.__MCHP=window.__MCHP||{})[key]=[{l:'',b:base,c:base+(omSt(tab).on?0:xcTotal(tab))}]}
document.addEventListener('input',e=>{const t=e.target;if(t&&t.dataset&&t.dataset.xc){const k=rTab(),R=xcSt(k);R[+t.dataset.i][t.dataset.xc]=t.value;
  const tr=t.closest('tr'),b=tr&&tr.querySelector('.add');if(b)b.hidden=!(+tr.dataset.i===R.length-1&&R.length<2&&R[R.length-1].t!==''&&R[R.length-1].c!=='');xcPush(k)}});
document.addEventListener('change',e=>{const t=e.target;if(t&&t.dataset&&t.dataset.xon){const k=t.dataset.xon;xcSt(k);window.__XC[k+'_on']=t.checked;t.closest('.xc').querySelector('table').hidden=!t.checked;xcPush(k)}});
document.addEventListener('click',e=>{const b=e.target.closest&&e.target.closest('.xc button');if(!b)return;const box=b.closest('.xc'),k=box.dataset.xk,R=xcSt(k),i=+b.closest('tr').dataset.i;
  if(b.classList.contains('add')){if(R.length<2)R.push({t:'',c:''})}else if(b.classList.contains('del'))R.splice(i,1);else return;
  box.querySelector('tbody').innerHTML=xcBody(k);xcPush(k)});
function omNew(){return {r:[{v:'',p:'',d:''}],s:0}}
function omSt(k){const O=(window.__OM=window.__OM||{});const o=O[k]||(O[k]={on:false,f:[omNew(),omNew()]});o.f=(o.f||[]).map(x=>x&&x.r?x:omNew());while(o.f.length<2)o.f.push(omNew());return o}
function omTabOf(key){return key[0]==='b'?'blocks':key[0]==='r'?'rods':'rounds'}
function omOn(key){return omSt(omTabOf(key)).on}
function omSel(k,i){const f=omSt(k).f[i||0];return f.r[Math.min(f.s,f.r.length-1)]||{v:'',p:'',d:''}}
function omPrice(k,i,def){const o=omSt(k);if(!o.on)return def;const v=parseFloat(omSel(k,i).p);return isFinite(v)&&v>=0?v:NaN}
function omChk(k){return `<label class="tg out"><input type="checkbox" data-om="${k}" ${omSt(k).on?'checked':''}>Outsourcing</label>`}
function esc(x){return String(x==null?'':x).replace(/[&<>"'`]/g,c=>'&#'+c.charCodeAt(0)+';')}
function qS(ref){const p=ref.split(':');return p[0]==='om'?omSt(p[1]).f[+p[2]]:mcQ(mchSt(p[1]))}
function mcQ(m){if(!m.oqs||!m.oqs.r)m.oqs=omNew();return m.oqs}
function mcOp(k){const f=mcQ(mchSt(k)),r=f.r[Math.min(f.s,f.r.length-1)],v=parseFloat(r&&r.p);return isFinite(v)&&v>=0?v:0}
function qRows(ref){const f=qS(ref);return f.r.map((r,j)=>`<tr data-j="${j}" class="${f.s===j?'sel':''}"><td class="pick"><input type="radio" name="qsel-${ref}" data-omr="s" data-j="${j}" ${f.s===j?'checked':''} aria-label="Use quote ${j+1}"></td>
    <td><input type="text" data-omr="v" data-j="${j}" maxlength="60" value="" autocomplete="off" aria-label="Vendor ${j+1}" placeholder="Vendor"></td>
    <td><input type="text" data-omr="n" data-j="${j}" maxlength="30" value="" autocomplete="off" aria-label="Quote # ${j+1}" placeholder="Quote #"></td>
    <td><input type="number" min="0" step="any" class="r" data-omr="p" data-j="${j}" value="${esc(f.r[j].p)}" aria-label="Price per piece ${j+1}" placeholder="0.00"></td>
    <td><input type="number" min="0" step="1" class="r" data-omr="d" data-j="${j}" value="${/^\d+(\.\d+)?$/.test(f.r[j].d)?esc(f.r[j].d):''}" aria-label="Lead time in days ${j+1}" placeholder="days"></td>
    <td><input type="text" class="obs" data-omr="o" data-j="${j}" maxlength="300" value="" autocomplete="off" aria-label="Notes ${j+1}" placeholder="Notes"></td>
    <td class="act">${f.r.length>1?'<button type="button" class="del" data-omb="del" title="Remove this quote" aria-label="Remove quote">×</button> ':''}<button type="button" class="add" data-omb="add" title="Add another quote" aria-label="Add quote" ${j===f.r.length-1&&f.r.length<10?'':'hidden'}>+</button></td></tr>`).join('')}
function qFill(box){box.querySelectorAll('tbody[data-st]').forEach(tb=>{const ref=tb.dataset.st,f=qS(ref);tb.innerHTML=qRows(ref);tb.querySelectorAll('tr').forEach((tr,j)=>{const r=f.r[j];for(const x of ['v','n','o']){const e=tr.querySelector('[data-omr='+x+']');e.value=r[x]||'';if(x==='o')e.title=r.o||''}})})}
function qTable(ref){return `<table class="qtab"><thead><tr><th></th><th>Vendor</th><th>Quote #</th><th class="r">Price ($/pc)</th><th class="r">Lead time (days)</th><th>Notes</th><th></th></tr></thead><tbody data-st="${ref}"></tbody></table>`}
function omHTML(k,labels){return `<div class="outf quotes" data-k="${k}"><p class="note" style="margin:0 0 4px">Vendor quotes for the machined part (history). Click the quote to use; its price per piece is the final material cost and Machining Cost is not applied.</p>${labels.map((l,i)=>`${l?`<h4>${l}</h4>`:''}${qTable('om:'+k+':'+i)}`).join('')}</div>`}
function omKeys(k){return k==='blocks'?(document.querySelector('.mfin[data-k="b0"]')?['b0','b1']:['b']):k==='rods'?['r']:['q']}
function plToggle(){PL.c=!PL.c;document.querySelectorAll('.pl').forEach(c=>{c.classList.toggle('collapsed',PL.c);c.querySelector('.plhead').setAttribute('aria-expanded',String(!PL.c))});try{localStorage.setItem('pl-collapsed',PL.c?'1':'0')}catch(e){}
  if(!PL.c){const t=rTab();({blocks:paint,rods:rPaint,rounds:qPaint})[t]()}}
document.addEventListener('click',e=>{if(e.target.closest('.plhead'))plToggle()});
document.addEventListener('keydown',e=>{const h=e.target.closest&&e.target.closest('.plhead');if(h&&(e.key==='Enter'||e.key===' ')){e.preventDefault();plToggle()}});
document.addEventListener('change',e=>{const t=e.target;if(t&&t.dataset&&t.dataset.om){omSt(t.dataset.om).on=t.checked;({blocks:render,rods:rRender,rounds:qRender})[t.dataset.om]()}});
function omInit(){document.querySelectorAll('.quotes').forEach(qFill)}
function omRecalc(k){omKeys(k).forEach((key,i)=>{mcSet(k,key,omPrice(k,i,NaN));mchFin(key)})}
document.addEventListener('focusout',e=>{const t=e.target;if(t&&t.classList&&t.classList.contains('obs'))t.scrollLeft=0});
function qAfter(ref){const p=ref.split(':');if(p[0]==='om')omRecalc(p[1]);else mchFin(p[1])}
document.addEventListener('input',e=>{const t=e.target;if(t&&t.dataset&&t.dataset.omr&&t.dataset.omr!=='s'){const tb=t.closest('tbody'),ref=tb.dataset.st,f=qS(ref),j=+t.dataset.j;f.r[j][t.dataset.omr]=t.value;if(t.dataset.omr==='o')t.title=t.value;if(t.dataset.omr==='p'&&f.s===j)qAfter(ref)}});
document.addEventListener('change',e=>{const t=e.target;if(t&&t.dataset&&t.dataset.omr==='s'){const tb=t.closest('tbody'),ref=tb.dataset.st,f=qS(ref);f.s=+t.dataset.j;tb.querySelectorAll('tr').forEach((tr,j)=>tr.classList.toggle('sel',j===f.s));qAfter(ref)}});
document.addEventListener('click',e=>{const b=e.target.closest&&e.target.closest('[data-omb]');if(!b)return;const box=b.closest('.quotes'),tb=b.closest('tbody'),ref=tb.dataset.st,f=qS(ref),j=+b.closest('tr').dataset.j;
  if(b.dataset.omb==='add'){if(f.r.length<10)f.r.push({v:'',p:'',d:''})}else{f.r.splice(j,1);if(f.s===j)f.s=0;else if(f.s>j)f.s--}
  qFill(box);qAfter(ref)});
function mchSt(k){const M=(window.__MCH=window.__MCH||{});return M[k]||(M[k]={rate:'90',steps:[{s:'',su:'',t:''}],q:[1,10,20,100],mg:'30',qq:'',qp:'',pk:'',pn:'1',fr:'',out:false,oqs:{r:[{v:'',p:'',d:''}],s:0}})}
function mchDone(r){return r.s!==''&&r.su!==''&&r.t!==''}
function mchHTML(k,title){
  const m=mchSt(k);
  return `<div class="mch" data-k="${k}"><h3>Machining cost${title?' · '+title:''}<label class="tg out"><input type="checkbox" data-f="out" ${m.out?'checked':''}>Outsourcing</label></h3>
    <div class="outf quotes" data-k="${k}" ${m.out?'':'hidden'}><p class="note" style="margin:0 0 4px">Vendor quotes for machining (history). Click the quote to use; its price per piece is the machining cost per piece for every quantity.</p>${qTable('mc:'+k)}</div>
    <div class="calc" ${m.out?'hidden':''}><div class="rate"><label for="mch-rate-${k}">Rate</label><div class="inp"><input id="mch-rate-${k}" data-f="rate" type="number" min="0" step="any" value="${m.rate}" placeholder="0.00"><span>$/hour</span></div></div>
    <table class="steps"><thead><tr><th>Machining step</th><th class="r">Set up time (min)</th><th class="r">Machining time (min/pc)</th><th></th></tr></thead><tbody></tbody></table>
    <table class="res"><thead><tr><th>Cost per pc</th>${m.q.map((q,i)=>`<th class="r"><input data-q="${i}" type="number" min="1" step="1" value="${q}" aria-label="Quantity ${i+1}"></th>`).join('')}</tr></thead><tbody></tbody><tfoot></tfoot></table>
    <p class="sub">Cost per piece = $/hour ÷ 60 × (set up time (min) ÷ quantity + machining time (min/pc)). Quantities (pcs) are editable. Up to 5 steps.</p></div></div>`;
}
function mchRows(root,k){
  const m=mchSt(k), tb=root.querySelector('table.steps tbody');
  tb.innerHTML=m.steps.map((r,i)=>`<tr data-i="${i}"><td><select data-f="s"><option value="">Select…</option>${['Saw','Small mill','Large Mill','Small Lathe','Large Lathe'].map(x=>`<option ${r.s===x?'selected':''}>${x}</option>`).join('')}</select></td>
    <td><input data-f="su" type="number" min="0" step="any" value="${r.su}" class="r"></td><td><input data-f="t" type="number" min="0" step="any" value="${r.t}" class="r"></td>
    <td class="act">${m.steps.length>1?'<button type="button" class="del" title="Remove this step" aria-label="Remove step">×</button> ':''}<button type="button" class="add" title="Add another machining step" aria-label="Add step" ${i===m.steps.length-1&&mchDone(r)&&m.steps.length<5?'':'hidden'}>+</button></td></tr>`).join('');
}
function mchTotAt(k,n){const m=mchSt(k);return omOn(k)?0:m.out?mcOp(k):m.steps.reduce((t,r)=>t+mchStep(parseFloat(m.rate)||0,r,n),0)}
function mchStep(rate,r,n){return rate/60*((parseFloat(r.su)||0)/n+(parseFloat(r.t)||0))}
function PACKS(){return [['Packaging I',100],['Packaging II',200],['Packaging III',350],['Packaging IV',500]]}
function qtCalc(k){
  const m=mchSt(k), q=parseFloat(m.qq), qp=parseFloat(m.qp), n=Math.max(1,parseFloat(m.pn)||1), fr=0;
  const pk=m.pk===''?0:PACKS()[+m.pk][1]*n, ok=q>0;
  const pp=ok?pk/q:0, fp=ok?fr/q:0, tot=ok&&qp>=0&&isFinite(qp)?qp+pp+fp:NaN;
  const P=(window.__MCHP&&window.__MCHP[k])||[], rate=parseFloat(m.rate)||0;
  const mach=ok?mchTotAt(k,q):NaN, cost=P.length?P[0].c+mach:NaN;
  return {q,qp,pk,pp,fr,fp,tot,ok,label:fr>0?'Delivered':'EXW Parma-OH',im:ok&&qp>0&&isFinite(cost)?(1-cost/qp)*100:NaN,fm:isFinite(tot)&&tot>0&&isFinite(cost)?(1-(cost+pp+fp)/tot)*100:NaN};
}
function qtUpd(el,k){
  const c=qtCalc(k), d2=n=>'$ '+nf(n,2), $q=x=>el.querySelector(x);
  const sh=v=>isFinite(c.tot)&&c.tot>0?' · '+nf(v/c.tot*100,1)+'%':'';
  $q('.pd').textContent=c.ok&&c.pk?d2(c.pp)+'/pc'+sh(c.pp):''; 
  $q('.im').textContent=isFinite(c.im)?' · margin '+nf(c.im,1)+'%':'';
  $q('.fm').textContent=isFinite(c.fm)?nf(c.fm,1)+'%':'—'; $q('.tl').textContent=c.label; $q('.tv').textContent=isFinite(c.tot)?d2(c.tot):'—';
}
function mchFin(k){
  const el=document.querySelector(`.mfin[data-k="${k}"]`); if(!el)return;
  const m=mchSt(k), rate=parseFloat(m.rate)||0, P=(window.__MCHP&&window.__MCHP[k])||[], mg=parseFloat(m.mg);
  const fixed=omOn(k)||m.out, qq0=parseFloat(m.qq);
  /* outsourced (material or machining): the price does not depend on the quantity, so only the quoted quantity is shown */
  const qs=fixed?[qq0>0?qq0:0]:m.q.map(q=>parseFloat(q)>0?parseFloat(q):0), mach=qs.map(n=>fixed?mchTotAt(k,1):n?mchTotAt(k,n):NaN);
  const ok=isFinite(mg)&&mg<100, ms=[-10,-5,0,5,10], d2=n=>'$ '+nf(n,2), pc=v=>nf(v,1).replace(/\.0$/,'')+'%';
  const tab=p=>`<div class="wrapt">${p.l?`<p class="sub"><b>${p.l}</b></p>`:''}<table><thead><tr><th>Margin</th>${qs.map(n=>`<th>${n?n+' pcs':(fixed?'Quoted qty':'—')}</th>`).join('')}</tr></thead><tbody>${ms.map(d=>{
    const g=ok?mg+d:NaN, bad=!(g<100);
    return `<tr class="${d===0?'base':''}"><td>${isFinite(g)?pc(g):'—'}${d?` <small>(${d>0?'+':'−'}${Math.abs(d)})</small>`:''}</td>${qs.map((n,i)=>{const v=(p.c+mach[i])/(1-g/100);return `<td>${!bad&&(n||fixed)&&isFinite(v)?d2(v):'—'}</td>`}).join('')}</tr>`}).join('')}</tbody></table></div>`;
  const keep=document.activeElement&&document.activeElement.id==='mg-'+k;
  if(!el.querySelector('.mg')){el.innerHTML=`<span class="l">Final price${el.dataset.t?' · '+el.dataset.t:''}</span><div class="mg"><label for="mg-${k}">Margin</label><input id="mg-${k}" type="number" step="any" max="99.9" value="${m.mg}"><span>%</span></div><div class="mgt"></div><div class="qt"><div class="r"><label for="qq-${k}">Quoted Quantity</label><input id="qq-${k}" data-f="qq" type="number" min="1" step="1" value="${m.qq}" placeholder="pcs"><span class="d">pcs</span></div><div class="r"><label for="qp-${k}">Quoted Price</label><input id="qp-${k}" data-f="qp" type="number" min="0" step="any" value="${m.qp}" placeholder="$ /pc"><span class="d">$ /pc<span class="im"></span></span></div><div class="r pkr"><label>Packaging</label><select data-f="pk" aria-label="Packaging"><option value="">None</option>${PACKS().map((p,i)=>`<option value="${i}" ${String(m.pk)===String(i)?'selected':''}>${p[0]} · $ ${p[1]}</option>`).join('')}</select><span class="d qy">Qty:</span><input class="pn" data-f="pn" type="number" min="1" step="1" value="${m.pn}" aria-label="Number of packages" title="Number of packages"><span class="d pd"></span></div><div class="tot"><span class="t">Price per piece · <span class="tl">EXW Parma-OH</span></span><b class="tv">—</b></div><div class="r fmr"><label>Final margin</label><b class="fm num">—</b></div></div><span class="s">Price = (Material piece cost + Machining total per pc) ÷ (1 − Margin). Rows: margin −10, −5, defined, +5, +10 points.</span>`;
    el.addEventListener('input',e=>{const f=e.target.dataset.f; if(f==='mg'||!f){if(e.target.id==='mg-'+k){m.mg=e.target.value;mchFin(k)}return} m[f]=e.target.value; if(f==='qq'&&(omOn(k)||m.out)){mchFin(k);return} qtUpd(el,k)});
    el.addEventListener('change',e=>{if(e.target.dataset.f==='pk'){m.pk=e.target.value;qtUpd(el,k)}})}
  el.querySelector('.mgt').innerHTML=P.length?P.map(tab).join(''):'';
  qtUpd(el,k);
}
function mchRes(root,k){
  const m=mchSt(k), rate=parseFloat(m.rate)||0, usd2=n=>'$ '+nf(n,2);
  const cost=(r,n)=>mchStep(rate,r,n);
  const qs=m.q.map(q=>parseFloat(q)>0?parseFloat(q):0);
  root.querySelector('table.res tbody').innerHTML=m.steps.map((r,i)=>`<tr><td>${r.s||'Step '+(i+1)}</td>${qs.map(n=>`<td class="r num">${n?usd2(cost(r,n)):'—'}</td>`).join('')}</tr>`).join('');
  root.querySelector('table.res tfoot').innerHTML=`<tr><td>Total per pc</td>${qs.map(n=>`<td class="r num">${n?usd2(mchTotAt(k,n)):'—'}</td>`).join('')}</tr>`;
  mchFin(k);
}
function mchBind(k){
  const root=document.querySelector(`.mch[data-k="${k}"]`); if(!root){if(omOn(k))mchFin(k);return}
  const m=mchSt(k);
  qFill(root); mchRows(root,k); mchRes(root,k);
  const plus=()=>root.querySelectorAll('table.steps tbody tr').forEach((tr,i)=>{const b=tr.querySelector('.add');if(b)b.hidden=!(i===m.steps.length-1&&mchDone(m.steps[i])&&m.steps.length<5)});
  root.addEventListener('input',e=>{
    const el=e.target, f=el.dataset.f, qi=el.dataset.q;
    if(qi!==undefined){m.q[+qi]=el.value;mchRes(root,k);return}
    if(f==='out'){m.out=el.checked;root.querySelector('.calc').hidden=m.out;root.querySelector('.outf').hidden=!m.out;mchRes(root,k);return}
    if(f==='rate'){m.rate=el.value;mchRes(root,k);return}
    const tr=el.closest('tr'); if(f&&tr&&tr.dataset.i!==undefined){m.steps[+tr.dataset.i][f]=el.value;plus();mchRes(root,k)}
  });
  root.addEventListener('click',e=>{
    const b=e.target.closest('button'); if(!b)return; const tr=b.closest('tr'); const i=+tr.dataset.i;
    if(b.classList.contains('add')){if(m.steps.length<5)m.steps.push({s:'',su:'',t:''})}
    else if(b.classList.contains('del')){m.steps.splice(i,1)}
    else return;
    mchRows(root,k);mchRes(root,k);
  });
}
function matLow(cat){
  const cur=matSrc(cat), lst=({BL:PRICES,RD:RODPRICES,RN:ROUNDPRICES})[cat].filter(p=>cat!=='BL'||p.grp===cur.grp);
  const mn=Math.min(...lst.map(p=>p.lb)), hit=lst.filter(p=>p.lb-mn<1e-9), cat_=cat==='BL'?cur.grp:cat==='RD'?'Extruded rods':'PDF-N molded rounds';
  return `<p class="note" style="margin:4px 0 0;font-size:11px">Lowest $/${MUl()} in ${cat_}: ${hit[0].name} · $ ${nf(PP(hit[0].kg),2)}/${MUl()}${hit.length>1?` (+${hit.length-1} at the same price)`:''}${hit.includes(cur)?' · <b>selected</b>':''}</p>`;
}
function matCard(cat){
  const m=matSrc(cat); if(!m||!m.d||!m.w)return '<p class="note" style="margin:6px 0 0">No dimensions / TL weight in the price list for this item.</p>';
  const dd=m.d.map(x=>Lc(x*25.4,UNIT.us?2:1)).join(' × ');
  return `<div class="matcard" draggable="true" data-cat="${cat}" title="Drag to the Feedstock box (or double-click) to use these dimensions"><span class="lot">${m.name}</span><div class="row"><span class="meta">${m.d.length===3?'':'ø '}${dd} ${LUl()} · ${Wu(m.w*KG_LB,0)}</span><span class="uc">$ ${nf(PP(m.kg),2)}<small>/${MUl()}</small></span></div></div><p class="note">Drag this card onto the Feedstock box (or double-click it): the dimensions are filled in (the density is kept).</p>`;
}
function dgSetDens(id,kgm3){
  const el=$(id); if(!el||!(kgm3>0))return;
  el.value=String(UNIT.us?+(kgm3/DENS_F).toFixed(5):+kgm3.toFixed(1));
  el.dispatchEvent(new Event('input',{bubbles:true}));
}
function matApply(cat){
  const m=matSrc(cat); if(!m||!m.d)return;
  if(cat==='BL'){dgSet('nW',m.d[0]);dgSet('nH',m.d[1]);dgSet('nL',m.d[2]);}
  else{
    const pre=cat==='RD'?'r':'q', box=$(pre+'Collar');
    if(box.checked){box.checked=false;box.dispatchEvent(new Event('input',{bubbles:true}))}
    dgSet(pre+'D',m.d[0]);dgSet(pre+'L',m.d[1]);
  }
  const pre=cat==='RD'?'r':'q', ids=cat==='BL'?['nW','nH','nL']:[pre+'D',pre+'L'];
  DG.applied={cat,mat:m.name,ids,vals:ids.map(id=>gv(id))};
  const fs=$('dg-'+cat).previousElementSibling; if(fs){fs.classList.remove('dg-done');void fs.offsetWidth;fs.classList.add('dg-done')}
}
function matBind(){
  document.querySelectorAll('.matcard').forEach(c=>{
    const cat=c.dataset.cat;
    c.addEventListener('dragstart',e=>{DG.drag={cat,mat:true};c.classList.add('dragging');e.dataTransfer.effectAllowed='copy';try{e.dataTransfer.setData('text/plain',matSrc(cat).name)}catch(_){}});
    c.addEventListener('dragend',()=>{c.classList.remove('dragging');DG.drag=null;document.querySelectorAll('.fs-drop').forEach(x=>x.classList.remove('dg-over'))});
    c.addEventListener('dblclick',()=>matApply(cat));
  });
}

/* Drag a Digger card onto the Feedstock box: its sizes (inches in the report) replace the Feedstock inputs. */
function dgSet(id,inches){
  const el=$(id); if(!el)return;
  el.value=String(UNIT.us?+inches.toFixed(4):+(inches*25.4).toFixed(3));
  el.dispatchEvent(new Event('input',{bubbles:true}));
}
function dgApply(cat,i){
  const r=DIGGER_DATA[i]; if(!r)return; const c=r[1], d=r[2];
  if(cat==='BL'){ if(c!=='BL')return; dgSet('nW',d[0]);dgSet('nH',d[1]);dgSet('nL',d[2]); dgSetDens('dens',/\bISO\b/i.test(String(r[3]))?1820:1720) }
  else{
    const pre=cat==='RD'?'r':'q', box=$(pre+'Collar');
    const want=c==='CL'; if(box.checked!==want){box.checked=want;box.dispatchEvent(new Event('input',{bubbles:true}))}
    if(want){dgSet(pre+'D1',d[0]);dgSet(pre+'L1',d[1]);dgSet(pre+'D2',d[2]);dgSet(pre+'L2',d[3])}
    else{dgSet(pre+'D',d[0]);dgSet(pre+'L',d[1])}
  }
  {const pre=cat==='RD'?'r':'q', ids=cat==='BL'?['nW','nH','nL']:c==='CL'?[pre+'D1',pre+'L1',pre+'D2',pre+'L2']:[pre+'D',pre+'L'];
   if(cat==='BL'?c==='BL':true)DG.applied={cat,i,ids,vals:ids.map(id=>gv(id))}}
  const fs=$('dg-'+cat).previousElementSibling; if(fs){fs.classList.remove('dg-done');void fs.offsetWidth;fs.classList.add('dg-done')}
}
document.querySelectorAll('.dg').forEach(card=>{
  const cat=card.id.replace('dg-',''), fs=card.previousElementSibling; if(!fs)return;
  fs.classList.add('fs-drop');
  fs.addEventListener('dragover',e=>{if(DG.drag&&DG.drag.cat===cat){e.preventDefault();e.dataTransfer.dropEffect='copy';fs.classList.add('dg-over')}});
  fs.addEventListener('dragleave',e=>{if(!fs.contains(e.relatedTarget))fs.classList.remove('dg-over')});
  fs.addEventListener('drop',e=>{e.preventDefault();fs.classList.remove('dg-over');if(DG.drag&&DG.drag.cat===cat){if(DG.drag.mat)matApply(cat);else dgApply(cat,DG.drag.i)}});
});

/* Material Digger boxes are collapsible (state remembered per browser when storage is available) */
document.querySelectorAll('.dg').forEach(card=>{
  const h=card.querySelector('header'), key='dg-collapsed';
  const set=c=>{card.classList.toggle('collapsed',c);h.setAttribute('aria-expanded',String(!c))};
  let saved=null; try{saved=localStorage.getItem(key)}catch(e){}
  if(saved==='1')set(true);
  const toggle=()=>{const c=!card.classList.contains('collapsed');
    document.querySelectorAll('.dg').forEach(x=>{x.classList.toggle('collapsed',c);x.querySelector('header').setAttribute('aria-expanded',String(!c))});
    try{localStorage.setItem(key,c?'1':'0')}catch(e){}};
  h.addEventListener('click',e=>{if(e.target.closest('select,label'))return;toggle()});
  h.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle()}});
});

/* =================== PAF FORM (Excel) ===================
   Opens a dialog asking for the PAF number, then builds an .xlsx (one per demanded part) from the current calculation of the active tab:
   1 Feedstock + demanded part(s) · 2 Cutting (3D cut planes with numbered arrows + piece arrangement) · 3 Offall memorial (Devaluation) · 4 Material Cost and Final Price.
   Palette = the calculator tokens (swap the RPT_C values together with the :root tokens if the Ei6 guide changes). */
const RPT={dl:undefined,busy:false};
const RPT_C={brand:[22,64,122],ink:[255,255,255],soft:[227,236,248],line:[217,224,234],fg:[22,33,47],mut:[91,107,128],s2:[246,248,251],
  good:[24,121,78],off:{'--off1':[176,125,10],'--off2':[22,128,115],'--off3':[104,92,196],'--off4':[170,52,116],'--off5':[90,104,122],'--demand2':[180,83,10],'--demand':[190,40,36],'--nominal':[31,111,209]}};
if(window.claude&&claude.use){claude.use('downloads').then(d=>{RPT.dl=d;if(!d)document.body.classList.add('no-dl')}).catch(()=>{RPT.dl=null;document.body.classList.add('no-dl')})}
const loadJs=(src,sri)=>new Promise((res,rej)=>{const s=document.createElement('script');s.src=src;if(sri){s.integrity=sri;s.crossOrigin='anonymous'}s.onload=res;s.onerror=()=>rej(new Error('Could not load the Excel library. Check the connection and try again.'));document.head.appendChild(s)});
async function rptLib(){
  if(!window.ExcelJS) await loadJs('https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js','sha384-Pqp51FUN2/qzfxZxBCtF0stpc9ONI6MYZpVqmo8m20SoaQCzf+arZvACkLkirlPz');
}
const rClean=s=>String(s==null?'':s).replace(/\s+/g,' ').trim();
const rTxt=s=>rClean(s).replace(/≥/g,'>=').replace(/≤/g,'<=').replace(/[→⟶]/g,'->').replace(/[−]/g,'-').replace(/″/g,'"').replace(/[^\x20-\x7E -ÿ–—‘’“”•…]/g,'');
const rTab=()=>['blocks','rods','rounds'].find(k=>!$('tab-'+k).hidden)||'blocks';
const rMain=k=>$({blocks:'main',rods:'rmain',rounds:'qmain'}[k]);

/* offscreen canvas under the light palette (the images are always light, whatever the page theme) */
function rShot(w,h,fn){
  const root=document.documentElement, prev=root.getAttribute('data-theme'); root.setAttribute('data-theme','light');
  const cv=document.createElement('canvas'); cv.style.cssText=`position:fixed;left:-99999px;top:0;width:${w}px;height:${h}px`; document.body.appendChild(cv);
  try{fn(cv);return cv.toDataURL('image/png')}
  finally{cv.remove(); if(prev==null)root.removeAttribute('data-theme'); else root.setAttribute('data-theme',prev)}
}

/* ---- cut planes (first three effective cuts) ---- */
function rCutsBlock(r,opt){
  const N=r.I.N, v=opt.envs[0].size, ext=[...N], dg=Math.hypot(...N)*.16, out=[];
  opt.order.forEach(ax=>{
    if(N[ax]-v[ax]<1e-6){ext[ax]=v[ax];return}
    const o=[0,1,2].filter(i=>i!==ax), mk=(p,q)=>{const t=[0,0,0];t[ax]=v[ax];t[o[0]]=p;t[o[1]]=q;return t};
    out.push({n:out.length+1,poly:[mk(0,0),mk(ext[o[0]],0),mk(ext[o[0]],ext[o[1]]),mk(0,ext[o[1]])],axis:ax,len:dg,a0:mk(ext[o[0]]/2,ext[o[1]]/2).map((q,i)=>i===ax?N[ax]:q),
      txt:`Plane normal to ${AX[ax]}, ${Lu(v[ax],1)} from the ${AX[ax]} origin face; the arrow leaves the middle of the Offall face being separated, away from the block.`});
    ext[ax]=v[ax];
  });
  return out.slice(0,3);
}
function rCutsRod(r){
  const out=[], e=1e-6, len=Math.min(r.Lpc*.7,r.Ltot*.1);
  r.dems.forEach(d=>{
    const desc=d.z0>e&&Math.abs(d.z1-r.Ltot)<1e-3;
    let zs=[]; for(let k=0;k<=d.n;k++)zs.push(d.z0+k*r.Lpc);
    zs=zs.filter(z=>z>e&&z<r.Ltot-e); if(desc)zs.reverse();
    zs.forEach(z=>out.push({z,dir:desc?-1:1,len,
      txt:`Plane normal to the axis, ${Lu(desc?r.Ltot-z:z,1)} from the free end of the ${desc?'large OD':'starting'} section; the arrow shows where the cutting advances.`}));
  });
  return out.slice(0,3).map((k,i)=>({...k,n:i+1}));
}

/* ---- scrapers: the report reuses exactly what the screen shows ---- */
function rFields(card){
  const rows=[], g=[{sub:'',items:[]}];
  card.querySelectorAll('.fields .field, .fields .subhead, dl.pw').forEach(el=>{
    if(el.closest('[hidden]'))return;
    if(el.classList.contains('subhead'))g.push({sub:rTxt(el.textContent),items:[]});
    else if(el.classList.contains('field')){const i=el.querySelector('input'),u=el.querySelector('.inp span');
      if(i)g[g.length-1].items.push([rTxt(el.querySelector('label').textContent),rTxt(i.value+' '+(u?u.textContent:''))])}
    else el.querySelectorAll('dt').forEach(dt=>g[g.length-1].items.push([rTxt(dt.textContent),rTxt(dt.nextElementSibling.textContent)]));
  });
  return g;
}
function rTable(t){
  const cell=c=>{const o={content:rTxt(c.textContent),colSpan:c.colSpan||1,styles:{}};
    if(c.classList.contains('r'))o.styles.halign='right';
    const b=c.querySelector('b[style*="var(--"]'); if(b){const m=/var\((--[\w-]+)\)/.exec(b.getAttribute('style')); if(m&&RPT_C.off[m[1]]){o.styles.textColor=RPT_C.off[m[1]];o.styles.fontStyle='bold'}}
    return o};
  const rows=sel=>[...t.querySelectorAll(':scope > '+sel+' > tr')].map(tr=>[...tr.children].map(cell));
  return {head:rows('thead'),body:rows('tbody'),foot:rows('tfoot')};
}
const rCard=(main,title)=>[...main.querySelectorAll(':scope > .card')].find(c=>{const h=c.querySelector('h2');return h&&rClean(h.textContent).startsWith(title)});

/* ---- source of the Feedstock: pointed manually or taken from a Material Digger card ---- */
function rSource(k){
  const cat={blocks:'BL',rods:'RD',rounds:'RN'}[k], a=DG.applied;
  if(a&&a.cat===cat&&a.ids.every((id,j)=>Math.abs(gv(id)-a.vals[j])<1e-6)){
    if(a.mat) return `Price list Oct26 - ${rTxt(a.mat)} - dimensions from the price list`;
    const r=DIGGER_DATA[a.i];
    return `Material Digger (Parma M Aged Report) - Lot ${rTxt(r[3])} - ${rTxt(r[4])} - ${r[0]===1?'Offall':'Nominal'} stock - ${rTxt(r[6])}`;
  }
  return 'Dimensions entered manually';
}

function pafBtn(k,mk){return ''; /* the PAF form is generated from the cover */ `<button type="button" class="rpt-btn" data-rpt="${k}" data-mk="${mk}"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 1.5h6.5L13 5v9.5H3z M9.5 1.5V5H13 M5.5 8.5h5 M5.5 11h5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>PAF form</button>`}
/* ---- PAF form (Excel): one workbook per demanded part. Facts for the archive are locked; the white cells on the blue panel are free to simulate. ---- */
function rInfo(k){
  const U=LUl(), mm=v=>Lc(v,1), dsel={blocks:'dens',rods:'rDens',rounds:'qDens'}[k];
  const dens=rTxt($(dsel).value+' '+$(dsel).closest('.inp').querySelector('span').textContent);
  let feed=[], dHead=[], parts=[];
  if(k==='blocks'){
    const r=state.res, I=r.I, kgOf=pieceWeight();
    feed=[['Dimensions',[`W ${Lu(I.N[0],1)}`,`H ${Lu(I.N[1],1)}`,`L ${Lu(I.N[2],1)}`]],['Block specs',[`Density ${dens}`,`Volume ${Vu(r.volN)}`,`Total weight ${Wu(r.volN*I.D,1)}`]]];
    dHead=["W'","H'","L'"];
    const add=(nm,P,A,Q,w)=>parts.push({nm,dims:P.map(mm),allow:A.map(a=>'+'+mm(a)),Q,wNo:P[0]*P[1]*P[2]/1e9*I.D,wWith:w});
    add('Part I',I.P,I.A,I.Q,kgOf[0]); if(I.on2)add('Part II',I.P2,I.A2,I.Q2,kgOf[1]);
  }else{
    const r=k==='rods'?state.rres:state.qres, I=r.I, tube=r.tube, W=k==='rods'?'Rod':'Round';
    const dim=I.collar?[`Small OD ${Lu(I.d1,1)}`,`L small OD ${Lu(I.l1,1)}`,`Large OD ${Lu(I.D2,1)}`,`L large OD ${Lu(I.l2,1)}`]:[`OD ${Lu(I.D,1)}`,`L ${Lu(I.L,1)}`];
    feed=[['Dimensions',dim],[W+' specs',[`Density ${dens}`,`Volume ${Vu(r.nomKg/I.rho)}`,`Total weight ${Wu(r.nomKg,1)}`].concat(I.collar?[`Total L ${Lu(I.l1+I.l2,1)}`]:[])]];
    dHead=['OD','ID','L'];
    parts.push({nm:tube?'Tube':W,dims:[mm(I.od),tube?mm(I.id):'-',mm(I.len)],allow:['-',tube?'+'+mm(I.aI):'-','+'+mm(I.aL)],Q:I.Q,wNo:r.finKg/I.Q,wWith:r.pieceKg});
  }
  return {feed,dHead,parts,U};
}
function rCutImgs(k){
  const FW=520, DPR=2.5; let FH=k==='blocks'?340:250, cuts, fCut, fArr, cap;
  if(k==='blocks'){
    const r=state.res, opt=r.opts[state.sel]; cuts=rCutsBlock(r,opt);
    const sc=sceneOf(r,opt,-1);
    fCut=rShot(FW,FH,cv=>draw(cv,{...sc,cuts},state.view,{labels:true,dpr:DPR,pad:56,zoom:1.18}));
    fArr=rShot(FW,FH,cv=>draw(cv,{...sc,off:[]},state.view,{labels:true,dpr:DPR,pad:50,zoom:1.2}));
    cap=`Option ${state.sel+1} of ${r.opts.length} · cutting order ${opt.order.map(i=>AX[i]).join(' → ')}${r.second?` · ${dn(r.second.id)} is taken from leftover ${opt.host+1}`:''}.`;
  }else{
    const r=k==='rods'?state.rres:state.qres, sc=k==='rods'?rScene(r):qScene(r), view=k==='rods'?rstate.view:qstate.view; cuts=rCutsRod(r); const tall=sc.Rmax*2/sc.Ltot>.3; FH=tall?360:250; const RP=tall?56:34;
    fCut=rShot(FW,FH,cv=>drawRod(cv,{...sc,cuts,Rfit:sc.Rmax*1.3},view,{dpr:DPR,pad:RP}));
    fArr=rShot(FW,FH,cv=>drawRod(cv,{...sc,parts:sc.parts.filter(q=>q.fill==='--nominal'||q.fill==='--demand')},view,{dpr:DPR,pad:RP}));
    cap=cuts.length?`First ${cuts.length} cutting plane${cuts.length>1?'s':''} of the sequence.`:'The cut leaves no parting plane in the stock.';
  }
  return {FW,FH,cuts,fCut,fArr,cap};
}
/* the Devaluation table is archived in the "Weight" view, whatever the screen shows */
function rWithWeight(k,fn){
  const was=DEV$, re=()=>({blocks:render,rods:rRender,rounds:qRender})[k]();
  if(was){DEV$=false;re()}
  try{return fn()}finally{if(was){DEV$=true;re()}}
}
const XC={brand:'FF16407A',brand2:'FF2F66A8',ink:'FFFFFFFF',soft:'FFE3ECF8',line:'FFD9E0EA',fg:'FF16212F',mut:'FF5B6B80',s2:'FFF6F8FB',
  off:{'--off1':'FFB07D0A','--off2':'FF168073','--off3':'FF685CC4','--off4':'FFAA3474','--off5':'FF5A687A','--demand2':'FFB4530A','--demand':'FFBE2824','--nominal':'FF1F6FD1'}};
async function pafAddSheet(wb,k,mk,meta,sheetName){
  const paf=meta.paf;
  const main=rMain(k), tabName={blocks:'Blocks',rods:'Rods',rounds:'Rounds'}[k];
  const mbox=document.querySelector(`.mfin[data-k="${mk}"]`), partName=(mbox&&mbox.dataset.t)||'';
  const M=mchSt(mk), PM=((window.__MCHP||{})[mk]||[])[0], mat=PM&&isFinite(PM.c)?PM.c:NaN;
  const info=rInfo(k), imgs=rCutImgs(k);
  const kp=[...main.querySelectorAll(':scope > .kpis .kpi')].map(e=>[rClean(e.querySelector('.l').textContent),rClean(e.querySelector('.v').textContent),rClean(e.querySelector('.s').textContent)]);
  const notes=[...main.querySelectorAll(':scope > section:not(.card):not(.cs) .note')].filter(n=>(n.tagName==='P'||n.tagName==='DIV')&&!n.closest('article')).map(n=>rClean(n.textContent));
  const cost=rCard(main,'Material Cost'), costSel=cost&&cost.querySelector('select:not([data-f])');
  const costRows=cost?[...cost.querySelectorAll('.in dl dt')].map(dt=>[rClean(dt.textContent),rClean(dt.nextElementSibling.textContent)]):[];
  const memos=cost?[...cost.querySelectorAll('.in p.memo, .in p.note')].map(n=>rClean(n.textContent)).filter(t=>!/^(Lowest|Drag|No dimensions)/.test(t)):[];
  const cell=c=>{let col=null;const b=c.querySelector('b[style*="var(--"]');if(b){const m=/var\((--[\w-]+)\)/.exec(b.getAttribute('style'));if(m&&XC.off[m[1]])col=XC.off[m[1]]}return {t:rClean(c.textContent),span:c.colSpan||1,r:c.classList.contains('r'),col}};
  const grab=t=>({head:[...t.querySelectorAll(':scope > thead > tr')].map(tr=>[...tr.children].map(cell)),body:[...t.querySelectorAll(':scope > tbody > tr')].map(tr=>[...tr.children].map(cell)),foot:[...t.querySelectorAll(':scope > tfoot > tr')].map(tr=>[...tr.children].map(cell))});
  const dv=rWithWeight(k,()=>{const c=rCard(main,'Devaluation'); if(!c)return null;
    const tg=c.querySelector('header .tag'), ts=[...c.querySelectorAll('table')];
    return {tag:tg?rClean(tg.textContent):'',t0:ts[0]?grab(ts[0]):null,rules:ts[1]?grab(ts[1]):null,notes:[...c.querySelectorAll('p.note')].map(n=>rClean(n.textContent))}});

  const ws=wb.addWorksheet(sheetName,{views:[{showGridLines:false}],pageSetup:{paperSize:9,orientation:'portrait',fitToPage:true,fitToWidth:1,fitToHeight:0,margins:{left:.4,right:.4,top:.5,bottom:.5,header:.2,footer:.2}}});
  [2,34,15,15,15,15,15,15,15,2,3].forEach((w,i)=>{ws.getColumn(i+1).width=w}); ws.getColumn(11).hidden=true;
  const CW=[0,2,34,15,15,15,15,15,15,15], X0=2, X1=9, LET=n=>String.fromCharCode(64+n);
  const fill=c=>({type:'pattern',pattern:'solid',fgColor:{argb:c}});
  const thin=c=>({style:'thin',color:{argb:c}}), box=c=>({top:thin(c),left:thin(c),bottom:thin(c),right:thin(c)});
  let y=1;
  const put=(r,c1,c2,v,st={})=>{
    if(c2>c1)ws.mergeCells(r,c1,r,c2);
    for(let c=c1;c<=c2;c++){const ce=ws.getCell(r,c); if(st.fill)ce.fill=fill(st.fill); if(st.border)ce.border=st.border}
    const ce=ws.getCell(r,c1); ce.value=v;
    ce.font={name:'Arial',size:st.sz||10,bold:!!st.b,italic:!!st.i,color:{argb:st.color||XC.fg}};
    ce.alignment={vertical:'middle',horizontal:st.h||'left',wrapText:st.wrap!==false,indent:st.ind||0};
    if(st.nf)ce.numFmt=st.nf; if(st.unlock)ce.protection={locked:false};
    return ce};
  const width=(c1,c2)=>{let w=0;for(let c=c1;c<=c2;c++)w+=CW[c];return w};
  const lines=(t,w)=>Math.max(1,Math.ceil(String(t).length*1.12/Math.max(6,w)));
  const blueRow=(r,h)=>{for(let c=X0;c<=X1;c++)ws.getCell(r,c).fill=fill(XC.brand); if(h)ws.getRow(r).height=h};
  const band=(t,sub)=>{y+=1;put(y,X0,X1,t.toUpperCase()+(sub?'   ·   '+sub:''),{fill:XC.brand,color:XC.ink,b:true,sz:11,wrap:false,ind:1});ws.getRow(y).height=22;y++};
  const para=(t,st={})=>{if(!t)return;put(y,X0,X1,t,{color:XC.mut,sz:9,...st});ws.getRow(y).height=Math.max(15,lines(t,width(X0,X1))*12.5+3);y++};
  const money='"$" #,##0.00';
  /* generic grid: spans = number of columns per logical column starting at B */
  const grid=(head,body,spans,foot)=>{
    const st=[];let c=X0;spans.forEach(s=>{st.push([c,c+s-1]);c+=s});
    const row=(cells,o)=>{let li=0,mx=1;cells.forEach(ce=>{const a=st[li],b=st[Math.min(li+ce.span-1,st.length-1)];
        put(y,a[0],b[1],ce.t,{...o,h:o.h||(ce.r?'right':'left'),color:o.color||ce.col||XC.fg,b:o.b||!!ce.col,ind:1,border:{bottom:thin(XC.line)}});
        mx=Math.max(mx,lines(ce.t,width(a[0],b[1])));li+=ce.span});
      ws.getRow(y).height=Math.max(18,mx*13+4);y++};
    head.forEach(h=>row(h,{fill:XC.soft,color:XC.brand,b:true}));
    body.forEach((b,i)=>row(b,{fill:i%2?XC.s2:undefined}));
    (foot||[]).forEach(f=>row(f,{fill:XC.soft,color:XC.brand,b:true}));
  };
  const lt=(t)=>({t,span:1,r:false}), rt=(t,span)=>({t,span:span||1,r:true});

  /* header band */
  for(let r=1;r<=3;r++){for(let c=1;c<=10;c++)ws.getCell(r,c).fill=fill(XC.brand)}
  put(1,X0,6,'Ei6  ·  PAF form',{color:XC.ink,b:true,sz:18,wrap:false});ws.getRow(1).height=30;
  put(1,7,X1,`PAF # ${paf}`,{color:XC.ink,b:true,sz:12,h:'right',wrap:false});
  put(2,X0,6,`${meta.partNo||'-'}${meta.desc?'  —  '+meta.desc:''}`,{color:XC.ink,b:true,sz:13,wrap:false});
  put(2,7,X1,meta.cust?`Customer: ${meta.cust}`:'',{color:'FFCDDCF0',sz:10,h:'right',wrap:false});ws.getRow(2).height=24;
  put(3,X0,X1,`Raw material calculator  ·  ${tabName}${partName?'  ·  '+partName:''}  ·  Created ${meta.date||''}  ·  Units: ${UNIT.us?'US (in, lb)':'Metric (mm, kg)'}  ·  White cells in the blue panel can be changed to simulate the quote; everything else is locked.`,{color:'FFCDDCF0',sz:8.5,wrap:false});
  y=4;

  /* 1 */
  band('1  Feedstock and demanded part(s)');
  put(y,X0,X0,'Source',{color:XC.brand,b:true});put(y,X0+1,X1,rSource(k),{b:true});ws.getRow(y).height=Math.max(18,lines(rSource(k),width(3,9))*13+4);y++;
  info.feed.forEach(f=>{put(y,X0,X0,f[0],{color:XC.brand,b:true});const n=f[1].length,sp=Math.floor(7/n);
    f[1].forEach((v,i)=>{const a=3+i*sp,b=i===n-1?9:a+sp-1;put(y,a,b,v,{b:true,border:{bottom:thin(XC.line)}})});ws.getRow(y).height=18;y++});
  y++;
  const dh=[{t:'Demanded part(s)',span:1},...info.dHead.map(h=>({t:`${h} (${info.U})`,span:1,r:true})),{t:'Qty',span:1,r:true},{t:'Weight per piece',span:3,r:true}];
